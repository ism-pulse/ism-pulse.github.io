// ---- Bundled template fetch ------------------------------------------------
async function fetchBundledCCMTemplate() {
  const st = $('ccm-template-status');

  ccmState.workbook = null;
  $('ccm-steps').classList.add('hidden');
  $('ccm-na-count').classList.add('hidden');
  $('ccm-file-info')?.classList.add('hidden');

  st.textContent = 'Loading bundled template…'; st.style.color = '';
  try {
    const buf = await fetchArrayBufferCapped(CCM_URL);

    // Verify integrity before parsing — fail closed if crypto.subtle is unavailable.
    const ccmHash = await sha256hex(buf);
    if (ccmHash === null) {
      st.textContent = 'Cannot verify CCM template integrity — crypto.subtle unavailable. Serve the tool over HTTPS or localhost.';
      st.style.color = '#c0392b';
      $('ccm-src-bundled').checked = false;
      $('ccm-src-bundled-card').classList.remove('selected');
      return;
    }
    if (BUNDLED_FILE_HASHES['ccm-current.xlsx'] && ccmHash !== BUNDLED_FILE_HASHES['ccm-current.xlsx']) {
      showFileVersionPanel('ccm-file-info', 'fv-rows-tab4', [
        fvRow('ccm-current.xlsx', '', buf.byteLength, ccmHash, BUNDLED_FILE_HASHES['ccm-current.xlsx']),
      ]);
      st.textContent = 'Bundled CCM template failed integrity check — hash mismatch. The file may have been updated. Please contact Cybernion or upload your own template.';
      st.style.color = '#c0392b';
      $('ccm-src-bundled').checked = false;
      $('ccm-src-bundled-card').classList.remove('selected');
      return;
    }

    ccmState.workbook = readWorkbookSafe(buf);
    ccmState.buffer   = buf;
    const ccmQShort = (ccmState.workbook.SheetNames || []).reduce((found, n) => found || quarterFromSheetName(n), '');
    const ccmQLabel = ccmQShort ? quarterLong(ccmQShort) : '';
    st.textContent = ccmQLabel ? `Bundled CCM template loaded - ${ccmQLabel} ✓` : 'Bundled CCM template loaded ✓';
    st.style.color = '#128a5a';

    showFileVersionPanel('ccm-file-info', 'fv-rows-tab4', [
      fvRow('ccm-current.xlsx', ccmQLabel, buf.byteLength, ccmHash, BUNDLED_FILE_HASHES['ccm-current.xlsx']),
    ]);

    onCCMTemplateLoaded();
  } catch (err) {
    st.textContent = `Could not load bundled template (${err.message || err}). Please upload your own.`;
    st.style.color = '#c0392b';
    $('ccm-src-bundled').checked = false;
    $('ccm-src-bundled-card').classList.remove('selected');
    console.warn('[IRAP Pulse] CCM template fetch failed:', err);
  }
}

// ---- File upload handler ---------------------------------------------------
(function wireCCMUpload() {
  const input = $('ccm-file-upload');
  const zone  = $('ccm-drop-zone');
  if (!input || !zone) return;

  input.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    readCCMFile(file);
  });

  zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone.addEventListener('dragleave', ()  => zone.classList.remove('drag-over'));
  zone.addEventListener('drop', (e) => {
    e.preventDefault(); zone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) readCCMFile(file);
  });
})();

async function readCCMFile(file) {
  const st = $('ccm-template-status');

  ccmState.workbook = null;
  $('ccm-steps').classList.add('hidden');
  $('ccm-na-count').classList.add('hidden');
  $('ccm-file-info')?.classList.add('hidden');

  if (file.size > MAX_XLSX_BYTES) {
    st.textContent = `File too large (${(file.size / 1048576).toFixed(1)} MB) — maximum is ${MAX_XLSX_MB} MB.`;
    st.style.color = '#c0392b'; return;
  }
  if (!/\.xlsx$/i.test(file.name)) {
    st.textContent = 'Please upload a plain Excel workbook (.xlsx). Other formats are not supported.';
    st.style.color = '#c0392b'; return;
  }

  try {
    const head = new Uint8Array(await file.slice(0, 4).arrayBuffer());
    const isZip = head[0] === 0x50 && head[1] === 0x4B && (head[2] === 0x03 || head[2] === 0x05 || head[2] === 0x07);
    if (!isZip) {
      st.textContent = `"${file.name}" does not look like a valid Excel workbook — check the file and try again.`;
      st.style.color = '#c0392b'; return;
    }

    st.textContent = 'Reading…'; st.style.color = '';
    const buf = await file.arrayBuffer();
    ccmState.workbook = readWorkbookSafe(buf);
    ccmState.buffer   = buf;
    st.textContent = `${file.name} loaded ✓`; st.style.color = '#128a5a';

    const uploadQShort = (ccmState.workbook.SheetNames || []).reduce((found, n) => found || quarterFromSheetName(n), '');
    const uploadQLabel = uploadQShort ? quarterLong(uploadQShort) : '';
    const uploadHash = await sha256hex(buf);
    showFileVersionPanel('ccm-file-info', 'fv-rows-tab4', [
      fvRow(file.name, uploadQLabel, buf.byteLength, uploadHash, null),
    ]);

    onCCMTemplateLoaded();
  } catch (err) {
    st.textContent = `Error reading file: ${err.message || err}`; st.style.color = '#c0392b';
    ccmState.workbook = null;
  }
}

// ---- Template loaded callback ---------------------------------------------
function onCCMTemplateLoaded() {
  // A valid CCM must have a Controls sheet with ISM-XXXX identifiers.
  if (!findSSPAControlsSheet(ccmState.workbook)) {
    const st = $('ccm-template-status');
    st.textContent = 'This file does not appear to be an ASD CCM template — no Controls sheet found. Please check that you have uploaded a blank ASD Cloud Controls Matrix (.xlsx) and try again.';
    st.style.color = '#c0392b';
    ccmState.workbook = null;
    document.querySelectorAll('input[name="ccm-source"]').forEach((r: any) => r.checked = false);
    document.querySelectorAll('#ccm-source-section .sspa-source-option').forEach(el => el.classList.remove('selected'));
    return;
  }
  buildCCMGuidelinesList();
  checkCCMGuidelineNameMismatch();
  updateCCMNACount($('ccm-classification')?.value || '');
  $('ccm-steps').classList.remove('hidden');
}

// ---- Guideline name mismatch warning --------------------------------------
function checkCCMGuidelineNameMismatch() {
  const warnEl = $('ccm-guideline-name-warning');
  if (!warnEl) return;
  warnEl.style.display = 'none';
  warnEl.innerHTML = '';

  const sheetName = findSSPAControlsSheet(ccmState.workbook);
  if (!sheetName) return;

  const ws  = ccmState.workbook.Sheets[sheetName];
  const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });

  let hdrIdx = 0;
  for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
    if ((aoa[i] || []).some(c => canonicaliseHeader(c) === 'Identifier')) { hdrIdx = i; break; }
  }
  const headers = (aoa[hdrIdx] || []).map(c => canonicaliseHeader(c));
  const glColIdx = headers.indexOf('Guideline');
  if (glColIdx === -1) return;

  const templateGuidelines = new Set();
  for (let r = hdrIdx + 1; r < aoa.length; r++) {
    const v = (aoa[r] || [])[glColIdx];
    if (v != null && String(v).trim()) templateGuidelines.add(normGuidelineName(String(v).trim()));
  }

  const checklistNames = new Set(SSPA_GUIDELINES.map(g => normGuidelineName(g.name)));
  const mismatched = [...templateGuidelines].filter(n => !checklistNames.has(n as string));
  if (!mismatched.length) return;

  const listHtml = mismatched.map(n => `<li style="margin:2px 0;">${escHtml(n)}</li>`).join('');
  warnEl.innerHTML = `<strong>Guideline name mismatch detected.</strong> The following Guideline name(s) appear in the template but do not match any entry in the scope checklist. Controls under these Guidelines will not be marked Not Applicable even if the Guideline is unticked — check that the template and checklist are from the same ISM version.<ul style="margin:6px 0 0; padding-left:18px;">${listHtml}</ul>`;
  warnEl.style.display = '';
}

// ---- Classification → NA count --------------------------------------------
$('ccm-classification').addEventListener('change', (e) => {
  updateCCMNACount(e.target.value);
});

function updateCCMNACount(cls) {
  const countEl = $('ccm-na-count');
  if (!ccmState.workbook || !cls) { countEl.classList.add('hidden'); return; }
  const classCol = SSPA_CLASS_COL[cls];
  if (!classCol) { countEl.classList.add('hidden'); return; }

  const controlsSheet = findSSPAControlsSheet(ccmState.workbook);
  if (!controlsSheet) { countEl.classList.add('hidden'); return; }

  const ws  = ccmState.workbook.Sheets[controlsSheet];
  const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });

  let hdrIdx = 0;
  for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
    if ((aoa[i] || []).some(c => canonicaliseHeader(c) === 'Identifier')) { hdrIdx = i; break; }
  }

  let classColIdx = -1, identColIdx = -1;
  const scanRow = (row) => {
    row.forEach((h, i) => {
      if (classColIdx < 0 && canonicaliseHeader(h) === classCol) classColIdx = i;
      if (identColIdx < 0 && canonicaliseHeader(h) === 'Identifier') identColIdx = i;
    });
  };
  scanRow(aoa[hdrIdx] || []);
  let dataStart = hdrIdx + 1;
  if (classColIdx < 0 && hdrIdx + 1 < aoa.length) {
    scanRow(aoa[hdrIdx + 1] || []);
    if (classColIdx >= 0) dataStart = hdrIdx + 2;
  }
  if (classColIdx < 0) { countEl.classList.add('hidden'); return; }

  let naCount = 0, total = 0;
  for (let r = dataStart; r < aoa.length; r++) {
    const row = aoa[r] || [];
    if (!row.some(c => c != null)) continue;
    if (identColIdx >= 0 && !row[identColIdx]) continue;
    total++;
    if (String(row[classColIdx] || '').trim().toLowerCase() === 'no') naCount++;
  }

  const display = SSPA_CLASS_DISPLAY[cls];
  countEl.innerHTML = `<span class="sspa-na-badge"><strong>${naCount}</strong> of ${total} controls will be marked Not Applicable — these controls do not apply to ${escHtml(display)} systems per the ISM.</span>`;
  countEl.classList.remove('hidden');
}

// ---- Build guidelines checklist -------------------------------------------
function buildCCMGuidelinesList() {
  const container = $('ccm-guidelines-list');
  if (!container) return;
  container.innerHTML = '';

  SSPA_GUIDELINES.forEach(g => {
    ccmState.guidelineStates[normGuidelineName(g.name)] = { checked: g.preticked, justification: '' };
  });

  const pretickLabel = document.createElement('p');
  pretickLabel.className = 'sspa-gl-group-label';
  pretickLabel.textContent = 'Pre-selected guidelines (apply to most systems)';
  container.appendChild(pretickLabel);

  SSPA_GUIDELINES.filter(g => g.preticked).forEach((g, idx) => renderCCMGuidelineItem(g, 'pt' + idx, container));

  const userLabel = document.createElement('p');
  userLabel.className = 'sspa-gl-group-label';
  userLabel.style.marginTop = '16px';
  userLabel.textContent = 'Select additional in-scope guidelines for this assessment';
  container.appendChild(userLabel);

  SSPA_GUIDELINES.filter(g => !g.preticked).forEach((g, idx) => renderCCMGuidelineItem(g, 'uc' + idx, container));
}

function renderCCMGuidelineItem(g, key, container) {
  const cbId   = 'ccm-gl-cb-' + key;
  const taId   = 'ccm-gl-ta-' + key;
  const item   = document.createElement('div');
  item.className = 'sspa-guideline-item' + (g.preticked ? ' preticked' : '');
  item.dataset.guideline = g.name;

  const pretickTag = g.preticked
    ? `<span class="sspa-gl-pretick-tag">${escHtml(g.pretickReason)}</span>`
    : '';

  item.innerHTML = `
    <div class="sspa-gl-header">
      <label class="sspa-gl-label" for="${cbId}">
        <input type="checkbox" id="${cbId}" ${g.preticked ? 'checked' : ''} />
        <span class="sspa-gl-name">${escHtml(g.name)}</span>
      </label>
      ${pretickTag}
    </div>
    <p class="sspa-gl-description">${escHtml(g.description)}</p>
    <div class="sspa-gl-justification hidden" id="ccm-just-wrap-${key}">
      <label class="sspa-gl-just-label" for="${taId}">
        Justification for excluding this Guideline <span style="font-weight:400;color:var(--text-muted)">(optional — added to each control comment)</span>
      </label>
      <textarea id="${taId}" placeholder="Describe why this system does not implement ${escHtml(g.name)} — e.g. no mobile devices, no on-premises infrastructure…" rows="2"></textarea>
    </div>`;

  const cb: any   = item.querySelector(`#${cbId}`);
  const wrap: any = item.querySelector(`#ccm-just-wrap-${key}`);
  const ta: any   = item.querySelector(`#${taId}`);

  cb.addEventListener('change', () => {
    ccmState.guidelineStates[normGuidelineName(g.name)].checked = cb.checked;
    if (!cb.checked) {
      wrap.classList.remove('hidden');
      item.classList.add('out-of-scope');
    } else {
      wrap.classList.add('hidden');
      item.classList.remove('out-of-scope');
      ccmState.guidelineStates[normGuidelineName(g.name)].justification = '';
      if (ta) ta.value = '';
    }
  });

  ta.addEventListener('input', () => {
    ccmState.guidelineStates[normGuidelineName(g.name)].justification = ta.value.trim();
  });

  container.appendChild(item);
}

// ---- Generate + download CCM ----------------------------------------------
// The export edits the original .xlsx bytes losslessly (see src/xlsxsurgery.ts):
// only the target cell values on the Controls sheet change, so dropdowns, panes,
// autofilter, column widths and styles are all preserved and memory stays flat.
$('btn-ccm-generate').addEventListener('click', generateCCM);

function generateCCM() {
  const errEl = $('ccm-generate-error');
  errEl.style.display = 'none';

  if (!ccmState.workbook || !ccmState.buffer) {
    errEl.textContent = 'No template loaded. Select a source and wait for it to load.';
    errEl.style.display = 'block'; return;
  }
  const cls = ($('ccm-classification') || {}).value || '';
  if (!cls) {
    errEl.textContent = 'Please select a classification in Step 1.';
    errEl.style.display = 'block'; return;
  }
  const orgName = (($('ccm-org-name') || {}).value || '').trim();
  if (!orgName) {
    errEl.textContent = 'Organisation name is required — it appears in the output filename.';
    errEl.style.display = 'block'; return;
  }
  const classCol     = SSPA_CLASS_COL[cls];
  const classDisplay = SSPA_CLASS_DISPLAY[cls];

  try {
    // Locate the Controls sheet and read it as an array-of-arrays for analysis.
    // The workbook is used ONLY to compute which cells to change; the original
    // file bytes (ccmState.buffer) are what we actually edit and ship.
    const controlsSheetName = findSSPAControlsSheet(ccmState.workbook);
    if (!controlsSheetName) {
      errEl.textContent = 'Could not find a Controls sheet in the template.';
      errEl.style.display = 'block'; return;
    }
    const ws  = ccmState.workbook.Sheets[controlsSheetName];
    const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });

    const res = computeCCMEdits(aoa, { classCol, classDisplay, guidelineStates: ccmState.guidelineStates });
    if (res.error) {
      errEl.textContent = res.error;
      errEl.style.display = 'block'; return;
    }
    if (!res.edits.length) {
      errEl.textContent = 'No controls are excluded for this classification and scope — nothing to mark Not Applicable. Adjust your selections, or use the original template as-is.';
      errEl.style.display = 'block'; return;
    }

    const editMap = new Map<string, string>();
    res.edits.forEach(e => editMap.set(e.ref, e.value));

    // ---- Lossless edit: only the target cell values change ---------------
    const out = editXlsxCells(ccmState.buffer, controlsSheetName, editMap);
    if (!out) {
      errEl.textContent = 'Could not locate the Controls worksheet inside the file. The .xlsx structure is unexpected.';
      errEl.style.display = 'block'; return;
    }

    const quarter      = quarterFromSheetName(controlsSheetName);
    const quarterLabel = quarter ? quarterLong(quarter) : controlsSheetName;
    const filename     = `CCM - ${sanitiseFilename(orgName)} - ${sanitiseFilename(classDisplay)} - ${sanitiseFilename(quarterLabel)}.xlsx`;

    // out is a Uint8Array view; copy to a fresh ArrayBuffer for the Blob.
    const blob = new Blob([out.slice()], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    downloadBlob(blob, filename);

  } catch (err) {
    errEl.textContent = `Error generating file: ${err.message || String(err)}`;
    errEl.style.display = 'block';
    console.error('[IRAP Pulse] CCM generation error:', err);
  }
}


/* ============================================================================
   TAB 3 — ISM Version Compare
   Fetches ism-archive/manifest.json on first activation, populates two version
   pickers, fetches both CCM XLSXs, runs computeDelta(), and renders a table +
   bar chart (new/updated/rescinded by guideline) + donut (change type split).
   All processing is client-side; no data leaves the browser.
   ============================================================================ */

const state3 = {
  manifest:           null,
  sortedVersions:     [],   // versions sorted newest-first by date field (or manifest order)
  baselineLabel:      '',
  currentLabel:       '',
  delta:              [],
  filters:            { kind: 'all', change: 'all', guideline: 'all', topic: 'all', search: '' },
  collapsedGuidelines: new Set(),
  barChart:           null,
  donutChart:         null,
};

let _tab3Initialised = false;

async function initTab3() {
  if (_tab3Initialised) return;
  _tab3Initialised = true;

  const statusEl = $('cmp-status');
  statusEl.textContent = 'Loading version list…';
  statusEl.className = 'validation-note';
  statusEl.classList.remove('hidden');

  try {
    const resp = await fetch('./ism-archive/manifest.json');
    if (!resp.ok) throw new Error(`${resp.status} ${resp.statusText}`);
    state3.manifest = await resp.json();
    populateCmpPickers();
    statusEl.classList.add('hidden');
  } catch (err) {
    statusEl.textContent = `Version list unavailable: ${err.message}. Add ism-archive/manifest.json to enable this tab.`;
    statusEl.className = 'validation-note warn';
    statusEl.classList.remove('hidden');
  }
}

function populateCmpPickers() {
  const raw = (state3.manifest && state3.manifest.versions) || [];
  // Validate each entry before use: must have id, label, and a safe .xlsx filename.
  const valid = raw.filter(v => {
    if (!v || typeof v !== 'object') return false;
    if (!v.id || !v.label) return false;
    if (!v.file || !v.file.endsWith('.xlsx')) return false;
    if (v.file.includes('..') || v.file.includes('/') || v.file.includes('\\')) return false;
    return true;
  });
  // Sort newest-first by the optional `date` field if present; otherwise preserve
  // manifest order.  Sorting by an explicit date field guards against manual
  // manifest edits that accidentally reorder entries.
  const anyHasDate = valid.some(v => v.date);
  const versions = anyHasDate
    ? valid.slice().sort((a, b) => {
        const da = a.date ? new Date(a.date).getTime() : 0;
        const db = b.date ? new Date(b.date).getTime() : 0;
        return db - da;   // descending: newest first
      })
    : valid;
  // Store sorted list on state3 so runCompare uses the same ordering.
  state3.sortedVersions = versions;

  const baseEl = $('cmp-baseline-sel');
  const currEl = $('cmp-current-sel');

  [baseEl, currEl].forEach(sel => {
    sel.innerHTML = '<option value="">Select version…</option>';
    versions.forEach(v => {
      const opt = document.createElement('option');
      opt.value = v.id;
      opt.textContent = v.label;
      sel.appendChild(opt);
    });
    sel.disabled = versions.length === 0;
  });

  // Default: newest as current, second-newest as baseline (sorted newest-first).
  if (versions.length >= 2) {
    currEl.value = versions[0].id;
    baseEl.value = versions[1].id;
  } else if (versions.length === 1) {
    currEl.value = versions[0].id;
  }

  const btn = $('btn-compare');
  btn.disabled = versions.length < 2;
  const swapBtn = $('btn-swap-versions');
  if (swapBtn) swapBtn.disabled = versions.length < 2;
}

$('btn-compare').addEventListener('click', runCompare);
$('btn-swap-versions').addEventListener('click', () => {
  const baseEl = $('cmp-baseline-sel');
  const currEl = $('cmp-current-sel');
  const tmp = baseEl.value;
  baseEl.value = currEl.value;
  currEl.value = tmp;
});

async function runCompare() {
  const baseId = $('cmp-baseline-sel').value;
  const currId = $('cmp-current-sel').value;

  if (!baseId || !currId) {
    showCmpMsg('Select both versions before comparing.', true);
    return;
  }
  if (baseId === currId) {
    showCmpMsg('Select two different versions.', true);
    return;
  }

  // Use the sorted version list (populated by populateCmpPickers) rather than
  // raw manifest order so the newer/older check is correct regardless of how
  // the manifest file was maintained.
  const versions = state3.sortedVersions || (state3.manifest && state3.manifest.versions) || [];
  const baseIdx  = versions.findIndex(v => v.id === baseId);
  const currIdx  = versions.findIndex(v => v.id === currId);
  if (baseIdx === -1 || currIdx === -1) {
    showCmpMsg('Version not found in manifest.', true);
    return;
  }
  // sortedVersions is newest-first, so a lower index = newer version.
  // Baseline must be older (higher index) than current (lower index).
  if (baseIdx <= currIdx) {
    showCmpMsg('Baseline must be older than current. Swap the selected versions and try again.', true);
    return;
  }
  const baseVer = versions[baseIdx];
  const currVer = versions[currIdx];

  const btn = $('btn-compare');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Comparing…';
  showCmpMsg('Fetching files…', false);

  try {
    const fetchArchive = async (ver) => {
      const buf = await fetchArrayBufferCapped('./ism-archive/' + ver.file);
      // Verify SHA-256 integrity if the manifest provides a hash.
      if (ver.sha256) {
        const actual = await sha256hex(buf);
        if (actual === null) {
          // crypto.subtle unavailable — cannot verify integrity; block rather than
          // silently treating the missing hash as a mismatch.
          throw new Error(`Cannot verify integrity of ${ver.file} — crypto.subtle is unavailable. Serve the tool over HTTPS or localhost (not plain file://).`);
        }
        if (actual !== ver.sha256.toLowerCase()) {
          throw new Error(`Integrity check failed for ${ver.file} — the file on disk does not match the hash in manifest.json. Do not use this version.`);
        }
      }
      return buf;
    };
    const [baseBuf, currBuf] = await Promise.all([
      fetchArchive(baseVer),
      fetchArchive(currVer),
    ]);

    showCmpMsg('Parsing…', false);

    const baseWb     = parseXLSXFromBuffer(baseBuf);
    const currWb     = parseXLSXFromBuffer(currBuf);
    const baseSheets = findReviewSheets(baseWb);
    const currSheets = findReviewSheets(currWb);

    const groups = [];
    ['control', 'principle'].forEach(kind => {
      const bSheet = baseSheets[kind] ? baseWb.Sheets[baseSheets[kind]] : null;
      const cSheet = currSheets[kind] ? currWb.Sheets[currSheets[kind]] : null;
      if (bSheet && cSheet) {
        groups.push({
          kind,
          sspaRows: normaliseRows(bSheet),   // older = baseline
          ccmRows:  normaliseRows(cSheet),   // newer = current
        });
      }
    });

    if (!groups.length) {
      throw new Error('Could not find Controls or Principles sheets in one or both files.');
    }

    const delta = computeDelta(groups, {});

    if (!delta.length) {
      showCmpMsg('No differences found between ' + baseVer.label + ' and ' + currVer.label + '.', false);
      $('cmp-results').classList.add('hidden');
      btn.disabled = false;
      btn.textContent = 'Compare';
      return;
    }

    state3.baselineLabel = baseVer.label;
    state3.currentLabel  = currVer.label;
    state3.delta         = delta;
    state3.filters       = { kind: 'all', change: 'all', guideline: 'all', topic: 'all', search: '' };

    $('cmp-results').classList.remove('hidden');
    $('cmp-status').classList.add('hidden');
    renderCmpResults();

  } catch (err) {
    showCmpMsg('Compare failed: ' + (err.message || err), true);
    console.error('[IRAP Pulse] Tab 3 compare error:', err);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Compare';
  }
}

function showCmpMsg(msg, isError) {
  const el = $('cmp-status');
  el.textContent = msg;
  el.className = 'validation-note' + (isError ? ' warn' : '');
  el.classList.remove('hidden');
}

// ---- Filtering -------------------------------------------------------------
function cmpFiltered() {
  const { kind, change, guideline, topic, search } = state3.filters;
  const q = search.trim().toLowerCase();
  return state3.delta.filter(d => {
    if (kind !== 'all' && d.kind !== kind) return false;
    if (change !== 'all' && d.changeType !== change) return false;
    if (guideline !== 'all' && (d.guideline || '') !== guideline) return false;
    if (topic !== 'all' && (d.topic || '') !== topic) return false;
    if (q && !(
      d.id.toLowerCase().includes(q) ||
      (d.guideline || '').toLowerCase().includes(q) ||
      (d.topic || '').toLowerCase().includes(q) ||
      d.newText.toLowerCase().includes(q) ||
      d.oldText.toLowerCase().includes(q)
    )) return false;
    return true;
  });
}

