// ---- Tab switching ---------------------------------------------------------
// Tabs by numeric id: 1 = Create SSP-A, 4 = Create CCM, 2 = Update SSP-A or CCM,
// 3 = ISM Version Compare. TAB_ORDER is the left-to-right visual order in the
// tab bar (used for arrow-key navigation); the numeric ids are kept stable so
// existing Tab 2/3 element references are untouched.
const TAB_IDS   = [1, 4, 2, 3];
const TAB_ORDER = [1, 4, 2, 3];

function switchTab(tab) {
  const btns   = TAB_IDS.map(n => $('tab-btn-' + n));
  const panels = TAB_IDS.map(n => $('tab' + n + '-panel'));
  const about1 = $('about-section-tab1'), about2 = $('about-section'), about4 = $('about-section-tab4');

  btns.forEach((btn, i) => {
    if (!btn) return;
    const active = (TAB_IDS[i] === tab);
    btn.classList.toggle('active', active);
    btn.setAttribute('aria-selected', active ? 'true' : 'false');
    btn.tabIndex = active ? 0 : -1;
  });
  panels.forEach((p, i) => {
    if (p) p.classList.toggle('hidden', TAB_IDS[i] !== tab);
  });

  // Each create tab has its own about section; Tab 2 has the main one; Tab 3 hides all.
  if (about1) about1.style.display = (tab === 1) ? '' : 'none';
  if (about4) about4.style.display = (tab === 4) ? '' : 'none';
  if (about2) about2.style.display = (tab === 2) ? '' : 'none';

  // Persist active tab in the URL hash so refresh restores position.
  const TAB_SLUGS = { 1: 'createsspa', 4: 'createccm', 2: 'updatesspa', 3: 'ismversions' };
  history.replaceState(null, '', '#' + TAB_SLUGS[tab]);

  // Lazy-load manifest on first visit to Tab 3.
  if (tab === 3) initTab3();
}
TAB_IDS.forEach(n => { const b = $('tab-btn-' + n); if (b) b.addEventListener('click', () => switchTab(n)); });

// Restore tab from URL hash on load (e.g. after a refresh).
// Deferred with setTimeout so all let/const declarations later in this script
// (state3, _tab3Initialised, etc.) are fully initialised before switchTab runs.
// Backward-compatible: also accepts old #tab1/#tab2/#tab3 links.
setTimeout(function () {
  const SLUG_TO_TAB = { createsspa: 1, createccm: 4, updatesspa: 2, ismversions: 3 };
  const slug = window.location.hash.replace(/^#/, '');
  const oldMatch = slug.match(/^tab([1234])$/);
  const target = SLUG_TO_TAB[slug] || (oldMatch && parseInt(oldMatch[1], 10));
  if (target) switchTab(target);
}, 0);

// Arrow key navigation between tabs, following visual order (ARIA authoring practice).
TAB_ORDER.forEach((n, idx) => {
  const btn = $('tab-btn-' + n);
  if (!btn) return;
  btn.addEventListener('keydown', (e) => {
    let target = null;
    if (e.key === 'ArrowLeft'  && idx > 0)                  target = TAB_ORDER[idx - 1];
    if (e.key === 'ArrowRight' && idx < TAB_ORDER.length - 1) target = TAB_ORDER[idx + 1];
    if (target != null) { switchTab(target); $('tab-btn-' + target).focus(); }
  });
});

// escHtml — alias kept for Tab 1 code; canonical helper is escapeHtml() defined earlier.
const escHtml = escapeHtml;

// ---- Helper — find controls sheet (content-based) -------------------------
// Returns the sheet name of the controls sheet, or null.
function findSSPAControlsSheet(wb) {
  for (const name of wb.SheetNames) {
    const ws = wb.Sheets[name];
    if (!ws) continue;
    const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });
    for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
      const headers = (aoa[i] || []).map(c => canonicaliseHeader(c));
      if (headers.includes('Identifier') && (headers.includes('Guideline') || headers.includes('Section'))) {
        return name;
      }
    }
  }
  return null;
}

// ---- Helper — column-letter from 0-based index ----------------------------
function colLetter(n) {
  let s = ''; n++;
  while (n > 0) { const r = (n - 1) % 26; s = String.fromCharCode(65 + r) + s; n = Math.floor((n - 1) / 26); }
  return s;
}

