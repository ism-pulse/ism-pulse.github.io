/* ---- Startup self-test -----------------------------------------------------
 *
 * ASD publishes a fresh CCM and ISM Changes PDF every quarter. If the CCM
 * schema shifts — a column renamed, the ML columns reworked, Principles
 * reorganised — the parser will silently mis-score the delta and the reviewer
 * won't know until they're halfway through a register. The self-test runs a
 * tiny synthetic fixture (2 New + 2 Updated + 1 Rescinded, including one
 * Principle) through the real computeDelta() on load and asserts the counts
 * match. If it fails, the header pill goes red and the user sees exactly what
 * broke before they bother uploading anything. Zero files touch the network.
 */
function runStartupSelfTest() {
  const pill = document.getElementById('self-test-pill');
  const label = document.getElementById('self-test-label');
  if (!pill || !label) return;
  const setResult = (cls, text, title) => {
    pill.classList.remove('pending', 'pass', 'fail');
    pill.classList.add(cls);
    label.textContent = text;
    pill.title = title || '';
  };
  try {
    const ccmRows = [
      // Unchanged control — must NOT appear in the delta
      { Identifier: 'ISM-0001', Description: 'Unchanged control text.', Revision: 1, Updated: 'June 2026', Guideline: 'Guidelines for System Management', Topic: 'Patching', 'Provider Responsibility': 'Customer', 'Implementation Status': 'Implemented', Applicability: 'OFFICIAL, PROTECTED', ML1: 'Yes', ML2: '', ML3: '' },
      // Updated control — description changed (Updated date also differs but is metadata-only, not the trigger)
      { Identifier: 'ISM-0002', Description: 'This control was updated with stricter requirements this quarter.', Revision: 2, Updated: 'June 2026', Guideline: 'Guidelines for System Management', Topic: 'Logging', 'Provider Responsibility': 'Customer', 'Implementation Status': 'Implemented', Applicability: 'OFFICIAL, PROTECTED', ML1: '', ML2: 'Yes', ML3: '' },
      // New control — not present in baseline
      { Identifier: 'ISM-0003', Description: 'Brand new control introduced this quarter.', Revision: 0, Updated: 'June 2026', Guideline: 'Guidelines for Cryptography', Topic: 'Key management', 'Provider Responsibility': 'Shared', 'Implementation Status': '', Applicability: 'OFFICIAL, PROTECTED', ML1: 'Yes', ML2: '', ML3: '' },
    ];
    const sspaRows = [
      // Updated field matches CCM — must NOT be flagged
      { Identifier: 'ISM-0001', Description: 'Unchanged control text.', Revision: 1, Updated: 'June 2026', Guideline: 'Guidelines for System Management', Topic: 'Patching', 'Provider Responsibility': 'Customer', 'Implementation Status': 'Implemented', Applicability: 'OFFICIAL, PROTECTED', ML1: 'Yes', ML2: '', ML3: '' },
      // Baseline has older description — description change is the trigger for Updated
      { Identifier: 'ISM-0002', Description: 'This control had a looser requirement in the baseline.', Revision: 1, Updated: 'Mar-26', Guideline: 'Guidelines for System Management', Topic: 'Logging', 'Provider Responsibility': 'Customer', 'Implementation Status': 'Implemented', Applicability: 'OFFICIAL, PROTECTED', ML1: '', ML2: 'Yes', ML3: '' },
      // Rescinded — present in baseline, missing from CCM
      { Identifier: 'ISM-9999', Description: 'This control was retired in the June 2026 quarter.', Revision: 1, Updated: 'Sep-25', Guideline: 'Guidelines for System Management', Topic: 'Legacy', 'Provider Responsibility': 'Customer', 'Implementation Status': 'Not Applicable', Applicability: 'OFFICIAL, PROTECTED', ML1: '', ML2: '', ML3: '' },
    ];
    const princCcm = [
      // Updated principle — description changed (Updated date also differs but is metadata-only, not the trigger)
      { Identifier: 'PRO-01', Description: 'Protect information from unauthorised access and disclosure, with strengthened wording this quarter.', Revision: 2, Updated: 'June 2026', Guideline: 'Cyber security principles', Topic: 'Protect', 'Provider Responsibility': '', 'Implementation Status': '', Applicability: 'OFFICIAL' },
      // New principle
      { Identifier: 'PRO-02', Description: 'A new principle added this quarter to cover secure system lifecycle.', Revision: 0, Updated: 'June 2026', Guideline: 'Cyber security principles', Topic: 'Secure lifecycle', 'Provider Responsibility': '', 'Implementation Status': '', Applicability: 'OFFICIAL' },
    ];
    const princSspa = [
      { Identifier: 'PRO-01', Description: 'Protect information from unauthorised access and disclosure.', Revision: 1, Updated: 'Mar-26', Guideline: 'Cyber security principles', Topic: 'Protect', 'Provider Responsibility': '', 'Implementation Status': '', Applicability: 'OFFICIAL' },
    ];
    const groups = [
      { kind: 'control',   ccmRows, sspaRows },
      { kind: 'principle', ccmRows: princCcm, sspaRows: princSspa },
    ];
    const d = computeDelta(groups, { systemClassification: 'OFFICIAL' });
    const byType = { New: 0, Updated: 0, Rescinded: 0 };
    d.forEach(x => { if (byType[x.changeType] != null) byType[x.changeType]++; });
    const expected = { New: 2, Updated: 2, Rescinded: 1 };
    // Also check the pair detector doesn't crash and returns a sane shape
    const pairs = findPossibleRescissionPairs(d);
    const pairsOk = (pairs === null) || (pairs && typeof pairs.count === 'number' && Array.isArray(pairs.items));

    // Per-field regression fixtures.
    // Metadata-only fields (Topic, Section, Revision, Provider Responsibility,
    // and ASD Updated date) must each produce zero delta when changed in isolation.
    // Only description, guideline, applicability, and maturity levels are triggers.
    const baseCtrl = {
      Identifier: 'ISM-0200', Description: 'Stable requirement text.',
      Guideline: 'Guidelines for System Management', Applicability: 'OFFICIAL',
      ML1: 'Yes', ML2: '', ML3: '',
      Updated: 'June 2026', Revision: 1, Section: 'A', Topic: 'Patching',
      'Provider Responsibility': 'Customer',
    };
    function _excl(overrideCurrent) {
      return computeDelta(
        [{ kind: 'control',
           ccmRows:  [{ ...baseCtrl, ...overrideCurrent }],
           sspaRows: [{ ...baseCtrl }] }],
        { systemClassification: 'OFFICIAL' }
      ).length;
    }
    const excludedFieldsOk =
      _excl({ Topic: 'New topic' })                      === 0 &&
      _excl({ Section: 'New section' })                  === 0 &&
      _excl({ Function: 'New function' })                === 0 &&  // Function alias for Section
      _excl({ Revision: 2 })                             === 0 &&
      _excl({ 'Provider Responsibility': 'Shared' })     === 0 &&
      _excl({ Updated: 'Mar-26' })                       === 0;    // Updated date is metadata-only, not a trigger

    // Positive trigger-field fixtures: each trigger field must independently produce
    // exactly one Updated row when changed in isolation.
    const triggerFieldsOk =
      _excl({ Description: 'Changed requirement text.' })           === 1 &&  // description trigger
      _excl({ Guideline: 'Guidelines for Cryptography' })           === 1 &&  // guideline trigger
      _excl({ Applicability: 'PROTECTED' })                         === 1 &&  // applicability trigger
      _excl({ ML1: 'No' })                                          === 1;    // maturity trigger
    // Applicability equivalence fixtures — verify that semantically identical
    // specs in different formats do NOT trigger Updated, and that genuine
    // changes (different classification codes, or different prose residuals) DO.
    function _cmp(baseOverride, currOverride) {
      return computeDelta(
        [{ kind: 'control',
           ccmRows:  [{ ...baseCtrl, ...currOverride }],
           sspaRows: [{ ...baseCtrl, ...baseOverride }] }],
        { systemClassification: 'OFFICIAL' }
      ).length;
    }
    const applicabilityEquivOk =
      // Free-text "OFFICIAL: Sensitive" ≡ per-column OS = Yes (no false-positive)
      _cmp({ Applicability: 'OFFICIAL: Sensitive', OS: '' }, { Applicability: '', OS: 'Yes' }) === 0 &&
      // Full label PROTECTED ≡ short code P
      _cmp({ Applicability: 'PROTECTED' },             { Applicability: 'P' })          === 0 &&
      // Legacy "All" ≡ NC column
      _cmp({ Applicability: 'All', NC: '' },           { Applicability: '', NC: 'Yes' }) === 0 &&
      // Prose residual that does NOT map to a canonical code must trigger Updated
      _cmp({ Applicability: 'NC' }, { Applicability: 'all systems handling PROTECTED' }) === 1 &&
      // Different prose residuals must trigger Updated even if the canonical codes match
      _cmp({ Applicability: 'PROTECTED privacy data' }, { Applicability: 'PROTECTED non-privacy data' }) === 1;

    const ok = byType.New === expected.New &&
               byType.Updated === expected.Updated &&
               byType.Rescinded === expected.Rescinded &&
               pairsOk &&
               excludedFieldsOk &&
               triggerFieldsOk &&
               applicabilityEquivOk;
    if (ok) {
      setResult(
        'pass',
        `Delta engine: pass (${expected.New} New / ${expected.Updated} Updated / ${expected.Rescinded} Rescinded)`,
        'The delta engine is working against a known-good internal fixture. This does not replace validation against the current ASD workbook schema — it only confirms the comparison logic behaves as expected on load.'
      );
      if (window.console) console.info('[ISM tool] Startup self-test passed.', byType);
    } else {
      const detail = `Expected ${expected.New}/${expected.Updated}/${expected.Rescinded}, got ${byType.New}/${byType.Updated}/${byType.Rescinded}` +
        (pairsOk ? '' : ' (pair detector returned unexpected shape)') +
        (excludedFieldsOk ? '' : ' (metadata-only fixtures: a non-trigger field incorrectly caused a delta)') +
        (triggerFieldsOk  ? '' : ' (trigger-field fixtures: a trigger field failed to produce a delta)') +
        (applicabilityEquivOk ? '' : ' (applicability equivalence fixtures: format-equivalent specs caused a false-positive, or a genuine change was missed)');
      setResult('fail', 'Self-test: FAIL — see console', detail);
      if (window.console) console.error('[ISM tool] Startup self-test FAILED:', detail);
    }
  } catch (err) {
    setResult('fail', 'Self-test: FAIL — see console', (err && err.message) || String(err));
    if (window.console) console.error('[ISM tool] Startup self-test threw:', err);
  }
}
// Defer until next tick so browser can paint the pending pill first.
setTimeout(runStartupSelfTest, 0);

