function escapeHtml(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

/* ---- Word-level diff (F2) --------------------------------------------
   Split on whitespace but keep the separators as their own tokens, so the
   rebuilt output preserves newlines and spacing. Longest-common-subsequence
   produces the traditional insertion/deletion stream. The input is plain
   text; we escape before wrapping in <ins>/<del> tags. */
function tokeniseForDiff(s) {
  return String(s == null ? '' : s).split(/(\s+)/).filter(t => t.length > 0);
}

function wordDiffTokens(a, b) {
  const n = a.length, m = b.length;
  // LCS matrix — for short descriptions this is fine; ISM control text rarely
  // exceeds a few hundred tokens so O(n*m) is acceptable.
  const dp = Array.from({ length: n + 1 }, () => new Array(m + 1).fill(0));
  for (let i = n - 1; i >= 0; i--) {
    for (let j = m - 1; j >= 0; j--) {
      if (a[i] === b[j]) dp[i][j] = dp[i + 1][j + 1] + 1;
      else dp[i][j] = Math.max(dp[i + 1][j], dp[i][j + 1]);
    }
  }
  const ops = []; // {op: 'eq'|'ins'|'del', token}
  let i = 0, j = 0;
  while (i < n && j < m) {
    if (a[i] === b[j]) { ops.push({ op: 'eq', token: a[i] }); i++; j++; }
    else if (dp[i + 1][j] >= dp[i][j + 1]) { ops.push({ op: 'del', token: a[i] }); i++; }
    else { ops.push({ op: 'ins', token: b[j] }); j++; }
  }
  while (i < n) ops.push({ op: 'del', token: a[i++] });
  while (j < m) ops.push({ op: 'ins', token: b[j++] });
  return ops;
}

// Returns a human-readable comma-separated list of which fields changed on an
// Updated delta entry. Returns an empty string for New / Rescinded rows.
function changedFieldsLabel(flags) {
  if (!flags) return '';
  const fields = [
    ['textChanged',    'Description'],
    ['glChanged',      'Guideline'],
    ['mlChanged',      'Maturity Level'],
    ['applChanged',    'Applicability'],
    // updatedChanged is intentionally absent — Updated date is metadata-only and
    // must not appear in reviewer-facing "Changed Fields" output.
  ];
  return fields
    .filter(([key]) => flags[key])
    .map(([, label]) => label)
    .join(', ');
}

function wordDiffHtml(oldText, newText) {
  // Guard against pathologically long cells freezing the O(n*m) LCS matrix.
  if (oldText.length > 1500 || newText.length > 1500) {
    return `<span class="diff-old">${escapeHtml(oldText)}</span><span class="diff-new">${escapeHtml(newText)}</span>`;
  }
  const a = tokeniseForDiff(oldText);
  const b = tokeniseForDiff(newText);
  const ops = wordDiffTokens(a, b);
  // Coalesce runs of the same op so we don't emit a <del>/<ins> tag per token
  const out = [];
  let i = 0;
  while (i < ops.length) {
    let j = i;
    while (j < ops.length && ops[j].op === ops[i].op) j++;
    const chunk = ops.slice(i, j).map(o => o.token).join('');
    if (ops[i].op === 'eq') out.push(escapeHtml(chunk));
    else if (ops[i].op === 'ins') out.push(`<ins>${escapeHtml(chunk)}</ins>`);
    else out.push(`<del>${escapeHtml(chunk)}</del>`);
    i = j;
  }
  return out.join('');
}

/* ---- Exports ---------------------------------------------------------- */
function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 0);
}

function sanitiseFilename(s) {
  return String(s || 'product').replace(/[^\w\-\s]/g, '').trim().replace(/\s+/g, '_') || 'product';
}

// Estimate the row height (in points) needed to display a row's longest
// wrapped cell in full. Excel's `wch` column width is measured in approximate
// character widths for the default font (Calibri 11 ≈ ~1.06 chars per wch).
// For each cell, we count explicit newlines plus soft-wrap overflow at the
// column's effective width; each line costs ~15 pt. A small padding is
// added and the result is clamped to [32, 500] so short rows stay compact
// and pathological cells don't produce a giant single-row page.
//
// Header rows should NOT use this helper — headers are one line by design
// and look off-balance if auto-sized. Callers pass headerRows separately.
function estimateRowHeight(row, colSpec) {
  const LINE_HEIGHT_PT = 15;
  const MIN_HPT = 32;
  const MAX_HPT = 500;
  let maxLines = 1;
  row.forEach((cell, idx) => {
    if (cell == null || cell === '') return;
    const text = String(cell);
    const wch = (colSpec[idx] && colSpec[idx].wch) || 20;
    // Effective characters per wrapped line — use wch directly; Calibri 11
    // averages very close to 1:1 at this width.
    const perLine = Math.max(6, wch - 2);
    let lines = 0;
    text.split(/\r?\n/).forEach(segment => {
      // Empty explicit-newline segments still count as a visible blank line.
      lines += Math.max(1, Math.ceil(segment.length / perLine));
    });
    if (lines > maxLines) maxLines = lines;
  });
  const hpt = maxLines * LINE_HEIGHT_PT + 8;
  return Math.min(MAX_HPT, Math.max(MIN_HPT, hpt));
}

function exportXlsx() {
  const p = state.product;
  const pq = state.parsed;
  const c = counts();
  const today = new Date().toISOString().slice(0, 10);
  // Used by the Essential Eight snapshot + any applicability-scoped views
  // below. Kept here so the variable is available for every sheet-build block.
  const systemClass = (p && p.classification) || '';

  // Consistent cell styles: all text left-aligned + vertically centred, with wrapping.
  const BASE_ALIGN = { horizontal: 'left', vertical: 'center', wrapText: true };
  const THIN = { style: 'thin', color: { rgb: 'CFD6E0' } };
  const cellStyle        = { alignment: BASE_ALIGN, border: { top: THIN, bottom: THIN, left: THIN, right: THIN }, font: { name: 'Calibri', sz: 11 } };
  const headerStyle      = { alignment: BASE_ALIGN, border: { top: THIN, bottom: THIN, left: THIN, right: THIN }, font: { name: 'Calibri', sz: 11, bold: true, color: { rgb: 'FFFFFF' } }, fill: { patternType: 'solid', fgColor: { rgb: '1F3864' } } };
  const titleStyle       = { alignment: BASE_ALIGN, font: { name: 'Calibri', sz: 14, bold: true, color: { rgb: '1F3864' } } };
  const sectionHeadStyle = { alignment: BASE_ALIGN, font: { name: 'Calibri', sz: 11, bold: true, color: { rgb: '2E75B6' } }, fill: { patternType: 'solid', fgColor: { rgb: 'EEF3F9' } } };

  function applySheetStyles(ws, { headerRows = [], titleRows = [], sectionHeadRows = [] } = {}) {
    const range = XLSX.utils.decode_range(ws['!ref']);
    for (let R = range.s.r; R <= range.e.r; R++) {
      for (let C = range.s.c; C <= range.e.c; C++) {
        const addr = XLSX.utils.encode_cell({ r: R, c: C });
        if (!ws[addr]) ws[addr] = { t: 's', v: '' };
        if (titleRows.includes(R))            ws[addr].s = titleStyle;
        else if (headerRows.includes(R))      ws[addr].s = headerStyle;
        else if (sectionHeadRows.includes(R)) ws[addr].s = sectionHeadStyle;
        else                                  ws[addr].s = cellStyle;
      }
    }
  }

  const wb = XLSX.utils.book_new();

  // Embed workbook-level metadata so Cybernion attribution
  // travels with every exported xlsx. SheetJS / xlsx-js-style writes these
  // into the workbook's core-properties part, where they show up under
  // File → Info → Properties in Excel and as <cp:coreProperties> in the
  // underlying XML. Keeps Cybernion attribution intact if the sheet is shared externally.
  wb.Props = wb.Props || {};
  Object.assign(wb.Props, {
    Title:       'ISM Quarterly Change Register',
    Subject:     'ASD ISM quarterly delta, pre-filled scoping and Essential Eight evidence lineage',
    Author:      'Cybernion',
    Manager:     'Cybernion',
    Company:     'Independent — https://cybernion.com.au/',
    Category:    'Security assurance',
    Keywords:    'ISM, ACSC, ASD, Cloud Controls Matrix, SSP-A, IRAP, Essential Eight, quarterly review',
    Comments:    '© 2026 Cybernion. All rights reserved. Generated by IRAP Pulse (https://cybernion.com.au). Decision-support artefact only; not IRAP advice.',
    CreatedDate: new Date(),
  });

  // Split delta by kind so we can emit per-kind counts and per-kind register tabs
  const controlsDelta   = state.delta.filter(d => d.kind === 'control');
  const principlesDelta = state.delta.filter(d => d.kind === 'principle');
  const byKindCounts = {
    control: {
      total: controlsDelta.length,
      New:       controlsDelta.filter(d => d.changeType === 'New').length,
      Updated:   controlsDelta.filter(d => d.changeType === 'Updated').length,
      Rescinded: controlsDelta.filter(d => d.changeType === 'Rescinded').length,
    },
    principle: {
      total: principlesDelta.length,
      New:       principlesDelta.filter(d => d.changeType === 'New').length,
      Updated:   principlesDelta.filter(d => d.changeType === 'Updated').length,
      Rescinded: principlesDelta.filter(d => d.changeType === 'Rescinded').length,
    },
  };
  const idsOf = (arr, t) => arr.filter(d => d.changeType === t).map(d => d.id).join(', ');

  // ---- Summary sheet ----
  const reviewerPlaceholder =
    '[Reviewer: write your overall conclusion here. Summarise how this ISM release affects the product in your own words — ' +
    'whether any controls require new work, whether existing implementations already satisfy the updated wording, and any ' +
    'stakeholders who need to be informed. The tool does not pre-write this because every product and organisation is different.]';
  const summaryRows = [
    ['ISM Quarterly Change Register'],                    // R0 title
    [],
    ['Organisation',            p.organisation || ''],
    ['Product',                 p.name || ''],
    ['Information Classification', p.classification || ''],
    ['Target quarter',          quarterLong(pq.targetQuarter)],
    ['Baseline file',          quarterLong(pq.baselineQuarter)],
    ['Review date',             today],
    ['Product overview',        p.overview || ''],
    [],
    ['Reviewer conclusion'],                              // R9 section head
    [reviewerPlaceholder],                                // R10 placeholder
    [],
    ['Update summary — Controls'],                        // R12 section head
    ['Change type', 'Count', 'Control IDs'],              // R13 header
    ['New',       byKindCounts.control.New,       idsOf(controlsDelta, 'New')],
    ['Updated',   byKindCounts.control.Updated,   idsOf(controlsDelta, 'Updated')],
    ['Rescinded', byKindCounts.control.Rescinded, idsOf(controlsDelta, 'Rescinded')],
    ['Total',     byKindCounts.control.total,     ''],
    [],
    ['Update summary — Principles'],                      // R19 section head
    ['Change type', 'Count', 'Principle IDs'],            // R20 header
    ['New',       byKindCounts.principle.New,       idsOf(principlesDelta, 'New')],
    ['Updated',   byKindCounts.principle.Updated,   idsOf(principlesDelta, 'Updated')],
    ['Rescinded', byKindCounts.principle.Rescinded, idsOf(principlesDelta, 'Rescinded')],
    ['Total',     byKindCounts.principle.total,     ''],
    [],
    // counts() returns { overall, byKind } — use c.overall.total for the grand total.
    ['Overall total', c.overall.total, ''],
  ];
  // Possible rescission + re-issue pairs — soft hint only, heuristic similarity
  // score on topic + text between rescinded and new items of the same kind.
  const pairsForSheet = state.possiblePairs;
  summaryRows.push([]);
  summaryRows.push(['Possible rescission + re-issue pairs (heuristic — reviewer confirms)']);
  if (pairsForSheet && pairsForSheet.count > 0) {
    summaryRows.push(['Rescinded ID', 'New ID', 'Similarity / shared terms']);
    pairsForSheet.items.slice(0, 25).forEach(p => {
      summaryRows.push([
        p.rescindedId,
        p.newId,
        `${(p.score * 100).toFixed(0)}%  ·  ${p.overlap} shared term(s)`,
      ]);
    });
    if (pairsForSheet.count > 25) {
      summaryRows.push([`(+${pairsForSheet.count - 25} more not shown)`, '', '']);
    }
  } else {
    summaryRows.push(['None detected. Reviewer should still scan Rescinded ↔ New by eye for same-requirement re-issues.']);
  }
  summaryRows.push([]);
  summaryRows.push(['Generated by', 'IRAP Pulse — A Cybernion tool (https://cybernion.com.au/)']);
  const wsSummary = XLSX.utils.aoa_to_sheet(summaryRows);
  wsSummary['!cols'] = [{ wch: 28 }, { wch: 14 }, { wch: 90 }];
  // Row heights: auto-size rows so long ID lists in column C (which wrap
  // across multiple lines) aren't clipped. The reviewer-conclusion
  // placeholder stays at a generous 90pt; elsewhere a 22pt floor keeps
  // short rows from looking cramped.
  wsSummary['!rows'] = summaryRows.map((row, i) => {
    if (i === 10) return { hpt: 90 };
    const est = estimateRowHeight(row, wsSummary['!cols']);
    return { hpt: Math.max(22, est) };
  });
  wsSummary['!merges'] = [
    { s: { r: 9,  c: 0 }, e: { r: 9,  c: 2 } },  // reviewer conclusion head
    { s: { r: 10, c: 0 }, e: { r: 10, c: 2 } },  // reviewer placeholder
    { s: { r: 12, c: 0 }, e: { r: 12, c: 2 } },  // Controls summary head
    { s: { r: 19, c: 0 }, e: { r: 19, c: 2 } },  // Principles summary head
  ];
  applySheetStyles(wsSummary, { titleRows: [0], sectionHeadRows: [9, 12, 19], headerRows: [13, 20] });
  // Colour the placeholder row so reviewers notice it's a fill-in
  const placeholderAddr = XLSX.utils.encode_cell({ r: 10, c: 0 });
  wsSummary[placeholderAddr].s = {
    alignment: { horizontal: 'left', vertical: 'top', wrapText: true },
    border: { top: THIN, bottom: THIN, left: THIN, right: THIN },
    font: { name: 'Calibri', sz: 11, italic: true, color: { rgb: '7A4A00' } },
    fill: { patternType: 'solid', fgColor: { rgb: 'FDF2E1' } },
  };
  XLSX.utils.book_append_sheet(wb, wsSummary, 'Summary');

  // ---- Change Register sheets — one per kind ----
  //
  // Controls carry the full operational detail reviewers need to triage
  // (scoping, Essential 8 applicability, section/guideline context).
  // Principles are governance statements, so fields like Revision, Section,
  // Applicability and E8 ML don't apply and are omitted. Two explicit column
  // specs (rather than a shared spec with hide flags) keep the shape of each
  // tab obvious at a glance.
  // The exported register mirrors what reviewers see on-screen: identity,
  // change, and scoping decision.
  const CONTROLS_COLS = [
    { key: 'id',             header: 'Control ID',                             wch: 12 },
    { key: 'changeType',     header: 'Change Type',                            wch: 12 },
    { key: 'changedFields',  header: 'Changed Fields',                         wch: 36 },
    { key: 'revision',       header: 'Revision',                               wch: 9  },
    { key: 'guideline',      header: 'Guideline',                              wch: 28 },
    { key: 'section',        header: 'Section',                                wch: 28 },
    { key: 'topic',          header: 'Topic',                                  wch: 28 },
    { key: 'applicability',  header: 'Applicability',                          wch: 14 },
    { key: 'mlLevels',       header: 'Essential 8 Maturity Level',             wch: 22 },
    { key: 'oldText',        header: 'Old Text (baseline)',                    wch: 60 },
    { key: 'newText',        header: 'New Text (current)',                     wch: 60 },
    { key: 'prov',           header: 'Baseline Provider Responsibility',       wch: 24 },
    { key: 'status',         header: 'Baseline Implementation Status',         wch: 22 },
    { key: 'inScope',        header: 'In Scope (reviewer)',                    wch: 14 },
    { key: 'triage',         header: 'Triage (reviewer)',                      wch: 16 },
  ];
  const PRINCIPLES_COLS = [
    { key: 'id',             header: 'Principle ID',                           wch: 12 },
    { key: 'changeType',     header: 'Change Type',                            wch: 12 },
    { key: 'changedFields',  header: 'Changed Fields',                         wch: 36 },
    { key: 'topic',          header: 'Topic',                                  wch: 28 },
    { key: 'oldText',        header: 'Old Text (baseline)',                    wch: 60 },
    { key: 'newText',        header: 'New Text (current)',                     wch: 60 },
    { key: 'status',         header: 'Baseline Implementation Status',         wch: 22 },
    { key: 'inScope',        header: 'In Scope (reviewer)',                    wch: 14 },
    { key: 'triage',         header: 'Triage (reviewer)',                      wch: 16 },
  ];

  function buildRegisterSheet(items, colSpec) {
    const headers = colSpec.map(c => c.header);
    const rows = [headers];
    items.forEach(d => {
      const t = state.triage[d.id] || {};
      // For rescinded items we also surface the ASD explanation of *why* it
      // was withdrawn (extracted from the Changes PDF, when provided) — the
      // reviewer needs this to decide whether downstream SSP-A references
      // must be retargeted. Concatenated into the Old Text cell with a clear
      // textual separator so the original baseline wording stays intact.
      const oldTextCell = (d.changeType === 'Rescinded' && d.rescissionReason)
        ? `${d.oldText || ''}\n\n----- Rescission reason (from ISM Changes PDF) -----\n${d.rescissionReason}`
        : (d.oldText || '');
      const valueByKey = {
        id:              d.id,
        changeType:      d.changeType,
        changedFields:   changedFieldsLabel(d.subFlags),
        revision:        d.revision ?? '',
        guideline:       d.guideline || '',
        section:         d.section || '',
        topic:           d.topic || '',
        applicability:   d.applicability || '',
        mlLevels:        d.mlLevelsVerbose || 'None',
        oldText:         oldTextCell,
        newText:         d.newText || '',
        prov:            (d.scoping && d.scoping.prov)   || '',
        status:          (d.scoping && d.scoping.status) || '',
        inScope:         t.inScope || '',
        triage:          t.triage  || '',
      };
      rows.push(colSpec.map(c => valueByKey[c.key]));
    });
    const ws = XLSX.utils.aoa_to_sheet(rows);
    // Content-aware column widths: measure the widest value in each column
    // (header included), floor at the declared minimum wch, cap long-text
    // columns so the sheet stays usable without manual adjustment.
    const WCH_CAP = { oldText: 90, newText: 90, prov: 55, section: 45, guideline: 45, topic: 45 };
    const DEFAULT_CAP = 50;
    ws['!cols'] = colSpec.map((c, ci) => {
      const maxLen = rows.reduce((m, row) => {
        const cell = row[ci] == null ? '' : String(row[ci]);
        const longestLine = cell.split('\n').reduce((mx, ln) => Math.max(mx, ln.length), 0);
        return Math.max(m, longestLine);
      }, 0);
      const cap = WCH_CAP[c.key] ?? DEFAULT_CAP;
      return { wch: Math.min(Math.max(maxLen, c.wch), cap) };
    });
    // Content-aware row heights. Excel's default (14.4 pt) is too tight for
    // wrapped long cells, which forced reviewers to hand-unwrap rows to
    // see all the text. We estimate the number of wrapped lines for the
    // longest cell per row, using its declared column width as the wrap
    // threshold, and size the row accordingly. Header row stays at 32 pt.
    //
    // The 15 points/line figure matches Calibri 11 with a small line-height
    // allowance; the 500 pt cap is a defensive upper bound so one pathological
    // row (e.g. a 4 000-char rescission reason) can't push Excel into a slow
    // single-row-per-page rendering path.
    ws['!rows'] = rows.map((row, i) => {
      if (i === 0) return { hpt: 32 };
      return { hpt: estimateRowHeight(row, colSpec) };
    });
    ws['!autofilter'] = { ref: `A1:${XLSX.utils.encode_col(headers.length - 1)}${Math.max(items.length, 0) + 1}` };
    applySheetStyles(ws, { headerRows: [0] });
    return ws;
  }

  // Always emit both tabs, even if empty — an empty tab is itself useful signal
  // ("the CCM made no principle changes this quarter") and keeps the workbook
  // shape stable quarter to quarter for downstream tooling.
  const wsRegControls   = buildRegisterSheet(controlsDelta,   CONTROLS_COLS);
  const wsRegPrinciples = buildRegisterSheet(principlesDelta, PRINCIPLES_COLS);
  XLSX.utils.book_append_sheet(wb, wsRegControls,   'Change Register - Controls');
  XLSX.utils.book_append_sheet(wb, wsRegPrinciples, 'Change Register - Principles');

  // ---- Essential Eight coverage snapshot sheet ----
  //
  // A one-page view of the product's Essential Eight posture and how this
  // quarter's CCM activity touches each maturity level. Useful for exec
  // reporting — you can see at a glance whether the quarterly change was
  // concentrated in one ML or spread across all three.
  //
  // Rows: ML1, ML2, ML3 + "None" (controls that don't map to E8).
  // Columns:
  //   - Applicable CCM controls — count of current-quarter CCM control rows
  //     carrying a "Yes" for this ML. If the reviewer set an Information
  //     Classification, we further restrict to controls that apply to that
  //     classification (so a PROTECTED system doesn't see SECRET-only rows).
  //   - New / Updated / Rescinded this quarter — count of delta entries
  //     touching that ML.
  //   - Total changes — sum of the three. Useful as a skim column.
  //
  // Only control deltas are counted (principles don't carry ML). Numbers are
  // floats-safe (no formulae — just raw integer cell values).
  const controlRowsAll = state.parsed.byKind.control.ccmRows || [];
  const classTokens = applicabilityTokens({ Applicability: systemClass }); // re-use parser
  // A control "applies to the system classification" when classTokens is
  // empty (no classification set → include all) OR the control row covers at
  // least one matching classification.
  const controlAppliesToSystem = (row) => {
    if (!systemClass) return true;
    const rowTokens = applicabilityTokens(row);
    if (!rowTokens.size) return true; // row with no applicability metadata — keep it
    for (const t of classTokens) if (rowTokens.has(t)) return true;
    return false;
  };
  const applicableByLevel = { ML1: 0, ML2: 0, ML3: 0, None: 0 };
  controlRowsAll.forEach(r => {
    if (!controlAppliesToSystem(r)) return;
    const ml = mlLevels(r); // "ML1, ML2" or "-" when none
    const levels = (ml === '-') ? ['None'] : ml.split(',').map(s => s.trim()).filter(Boolean);
    levels.forEach(l => { if (applicableByLevel[l] != null) applicableByLevel[l]++; });
  });
  const changeByLevel = {
    ML1: { New: 0, Updated: 0, Rescinded: 0 },
    ML2: { New: 0, Updated: 0, Rescinded: 0 },
    ML3: { New: 0, Updated: 0, Rescinded: 0 },
    None:{ New: 0, Updated: 0, Rescinded: 0 },
  };
  controlsDelta.forEach(d => {
    const ml = d.mlLevels || '-';
    const levels = (ml === '-') ? ['None'] : ml.split(',').map(s => s.trim()).filter(Boolean);
    levels.forEach(l => {
      if (changeByLevel[l] && changeByLevel[l][d.changeType] != null) {
        changeByLevel[l][d.changeType]++;
      }
    });
  });
  const e8HeadLabel = systemClass
    ? `Essential Eight coverage snapshot — ${p.name || 'Product'} (${systemClass})`
    : `Essential Eight coverage snapshot — ${p.name || 'Product'}`;
  // Per-level totals we need a few times.
  const e8MaturityLevels = ['ML1', 'ML2', 'ML3'];
  const e8ApplicableTotal = e8MaturityLevels.reduce((a, l) => a + applicableByLevel[l], 0);
  const e8NewTotal        = e8MaturityLevels.reduce((a, l) => a + changeByLevel[l].New, 0);
  const e8UpdTotal        = e8MaturityLevels.reduce((a, l) => a + changeByLevel[l].Updated, 0);
  const e8ResTotal        = e8MaturityLevels.reduce((a, l) => a + changeByLevel[l].Rescinded, 0);

  // The sheet is split into three explicit bands — Essential Eight controls,
  // non-E8 ISM controls, and All CCM controls — each with its own total row,
  // so readers can see at a glance which counts are E8-scoped vs. total.
  const e8Rows: any[][] = [
    [e8HeadLabel],
    [],
    ['Target quarter',   quarterLong(pq.targetQuarter)],
    ['Baseline quarter', quarterLong(pq.baselineQuarter)],
    [],
    ['Maturity Level', 'Applicable CCM controls', 'New this quarter', 'Updated this quarter', 'Rescinded this quarter', 'Total changes'],
    // Band 1 — Essential Eight
    ['Essential Eight controls (ML1 / ML2 / ML3)'],
  ];
  e8MaturityLevels.forEach(l => {
    const c = changeByLevel[l];
    e8Rows.push([l, applicableByLevel[l], c.New, c.Updated, c.Rescinded, c.New + c.Updated + c.Rescinded]);
  });
  e8Rows.push(['Total E8 controls (incl. duplicates across MLs)', e8ApplicableTotal, e8NewTotal, e8UpdTotal, e8ResTotal, e8NewTotal + e8UpdTotal + e8ResTotal]);
  // Band 2 — Non-E8
  e8Rows.push(['Non-Essential-Eight controls']);
  {
    const c = changeByLevel['None'];
    e8Rows.push(['None (no E8 mapping)', applicableByLevel['None'], c.New, c.Updated, c.Rescinded, c.New + c.Updated + c.Rescinded]);
  }
  // Band 3 — all CCM controls
  const totalApplicable = e8ApplicableTotal + applicableByLevel['None'];
  const totalNew        = e8NewTotal        + changeByLevel['None'].New;
  const totalUpdated    = e8UpdTotal        + changeByLevel['None'].Updated;
  const totalRescinded  = e8ResTotal        + changeByLevel['None'].Rescinded;
  e8Rows.push(['All CCM controls (E8 + non-E8)']);
  e8Rows.push(['Total ISM controls', totalApplicable, totalNew, totalUpdated, totalRescinded, totalNew + totalUpdated + totalRescinded]);
  // Capture band-separator row indices (1-based in comments) for styling.
  const e8BandRows = [6, 10, 12];
  const e8TotalRows = [9, 13];   // the "Total …" summary rows within each band

  e8Rows.push([]);
  e8Rows.push(['Notes']);
  e8Rows.push(['• "Applicable CCM controls" (column B) is the COUNT OF CONTROLS at that level — the population, not the change count. Columns C–F report CHANGES this quarter within that population.']);
  e8Rows.push(['• A control can contribute to more than one Maturity Level (e.g. ML1 + ML2), so "Total E8 controls" may exceed the distinct-control count.']);
  e8Rows.push(['• "None" groups controls that do not map to any Essential Eight level.']);
  if (systemClass) {
    e8Rows.push([`• "Applicable CCM controls" is filtered to rows that apply to ${systemClass}. Remove or change the Information Classification on the product-details panel to see all classifications.`]);
  } else {
    e8Rows.push(['• Information Classification is blank — the Applicable column shows every CCM control. Set a classification to scope to your system.']);
  }
  const wsE8 = XLSX.utils.aoa_to_sheet(e8Rows);
  wsE8['!cols'] = [{ wch: 44 }, { wch: 26 }, { wch: 22 }, { wch: 26 }, { wch: 26 }, { wch: 18 }];
  // Merges: title, band-separator rows, notes head + bullets.
  const notesStartRow = e8Rows.length - 6; // the "Notes" label row
  const mergesList = [
    { s: { r: 0, c: 0 }, e: { r: 0, c: 5 } }, // title
  ];
  e8BandRows.forEach(r => mergesList.push({ s: { r, c: 0 }, e: { r, c: 5 } }));
  for (let i = 0; i < 6; i++) {
    const r = notesStartRow + i;
    if (r < e8Rows.length) mergesList.push({ s: { r, c: 0 }, e: { r, c: 5 } });
  }
  wsE8['!merges'] = mergesList;
  applySheetStyles(wsE8, {
    titleRows: [0],
    headerRows: [5],
    sectionHeadRows: [...e8BandRows, ...e8TotalRows, notesStartRow],
  });
  XLSX.utils.book_append_sheet(wb, wsE8, 'Essential Eight Snapshot');

  // ---- Essential Eight Evidence lineage sheet ----
  //
  // The Snapshot above answers "how many", this sheet answers "where". For
  // every E8 control in scope, we emit one row that shows the CCM's ML1/ML2/
  // ML3 claim alongside the matching SSP-A cell values, the SSP-A
  // Implementation Status, and an "Baseline corroborates CCM?" column that flags
  // any row where the SSP-A doesn't back up the CCM's E8 claim. An IRAP
  // assessor can see at a glance which cell in the SSP-A is the evidence for
  // each ML claim, rather than having to trust a count.
  const sspaById = Object.create(null);
  (state.parsed.byKind.control.sspaRows || []).forEach(r => {
    const id = String(r['Identifier'] || '').trim();
    if (id) sspaById[id] = r;
  });
  const readML = (r, level) => {
    if (!r) return '';
    const v = r[level] || r[`Essential 8 ${level}`];
    return String(v == null ? '' : v).trim();
  };
  const isYes = (s) => String(s || '').trim().toLowerCase() === 'yes';
  // The sheet's own tab name ("Essential Eight Evidence") already says what
  // this is; a title row + spacer row above the explainer is redundant and
  // costs the reviewer two scroll-clicks before the data. The product name
  // and classification are already on the Summary tab, so they don't need
  // repeating here either. Layout therefore is: explainer → spacer → headers.
  const evExplainer = 'For every E8 control carrying ML1, ML2 or ML3 in the current CCM, this sheet shows the exact value in the matching baseline row. The "Baseline corroborates?" column flags any row where the baseline does not back up the CCM claim — a prompt for the reviewer to either update the baseline file or adjust scoping.';
  const evRows: any[][] = [
    [evExplainer],
    [],
    [
      'Identifier', 'Guideline', 'Topic',
      'CCM ML1', 'Baseline ML1',
      'CCM ML2', 'Baseline ML2',
      'CCM ML3', 'Baseline ML3',
      'Baseline Implementation Status',
      'Baseline Provider Responsibility',
      'Baseline corroborates CCM?',
    ],
  ];
  const evExplainerRow = 0;
  const evHeaderRow = evRows.length - 1;
  let evRowCount = 0, evMismatchCount = 0, evMissingFromSspa = 0;
  controlRowsAll.forEach(r => {
    if (!controlAppliesToSystem(r)) return;
    const id = String(r['Identifier'] || '').trim();
    if (!id) return;
    const ccmML1 = readML(r, 'ML1');
    const ccmML2 = readML(r, 'ML2');
    const ccmML3 = readML(r, 'ML3');
    // Only include rows that carry at least one E8 claim in the CCM.
    if (!isYes(ccmML1) && !isYes(ccmML2) && !isYes(ccmML3)) return;
    evRowCount++;
    const sspaRow = sspaById[id] || null;
    const sML1 = readML(sspaRow, 'ML1');
    const sML2 = readML(sspaRow, 'ML2');
    const sML3 = readML(sspaRow, 'ML3');
    // Corroboration check — each CCM "Yes" must be matched by a SSP-A "Yes".
    let verdict;
    if (!sspaRow) {
      verdict = 'Not in baseline file';
      evMissingFromSspa++;
    } else {
      const mismatches = [];
      if (isYes(ccmML1) && !isYes(sML1)) mismatches.push('ML1');
      if (isYes(ccmML2) && !isYes(sML2)) mismatches.push('ML2');
      if (isYes(ccmML3) && !isYes(sML3)) mismatches.push('ML3');
      if (mismatches.length === 0) verdict = 'Yes';
      else { verdict = `No — baseline silent on ${mismatches.join(', ')}`; evMismatchCount++; }
    }
    evRows.push([
      id,
      String(r['Guideline']  || '').trim(),
      String(r['Topic']      || '').trim(),
      ccmML1 || '-', sML1 || (sspaRow ? '-' : '(no SSP-A row)'),
      ccmML2 || '-', sML2 || (sspaRow ? '-' : '(no SSP-A row)'),
      ccmML3 || '-', sML3 || (sspaRow ? '-' : '(no SSP-A row)'),
      String((sspaRow && sspaRow['Implementation Status'])     || '').trim(),
      String((sspaRow && (sspaRow['Provider Responsibility'] || sspaRow['Assessment Responsibility'])) || '').trim(),
      verdict,
    ]);
  });
  if (evRowCount === 0) {
    evRows.push(['(No Essential Eight controls in the current CCM match the system classification.)']);
  }
  evRows.push([]);
  evRows.push(['Summary']);
  evRows.push(['Total E8 controls in scope', evRowCount]);
  evRows.push(['Controls where Baseline corroborates every CCM ML claim', Math.max(0, evRowCount - evMismatchCount - evMissingFromSspa)]);
  evRows.push(['Controls where baseline is silent on at least one CCM ML claim', evMismatchCount]);
  evRows.push(['Controls not in baseline file', evMissingFromSspa]);
  const wsEv = XLSX.utils.aoa_to_sheet(evRows);
  wsEv['!cols'] = [
    { wch: 14 }, { wch: 28 }, { wch: 32 },
    { wch: 9 }, { wch: 10 }, { wch: 9 }, { wch: 10 }, { wch: 9 }, { wch: 10 },
    { wch: 22 }, { wch: 24 }, { wch: 30 },
  ];
  // Row-height estimator defaults to column A's width (wch:14) as the wrap
  // threshold. For the merged explainer row that under-counts massively —
  // the text actually wraps across the full 12-column merge. Compute the
  // explainer's height using the summed merged-column width instead, and
  // leave the rest of the rows on the per-column estimate.
  const evMergedWch = wsEv['!cols'].reduce((s, c) => s + (c.wch || 0), 0);
  const evExplainerColSpec = [{ wch: evMergedWch }];
  wsEv['!rows'] = evRows.map((row, i) => {
    if (i === evExplainerRow) return { hpt: estimateRowHeight(row, evExplainerColSpec) };
    return { hpt: Math.max(20, estimateRowHeight(row, wsEv['!cols'])) };
  });
  wsEv['!merges'] = [
    { s: { r: evExplainerRow, c: 0 }, e: { r: evExplainerRow, c: 11 } },
  ];
  // Summary head row (last 5 rows — the label, then 4 stat rows)
  const evSummaryHead = evRows.length - 5;
  applySheetStyles(wsEv, {
    headerRows: [evHeaderRow],
    sectionHeadRows: [evSummaryHead],
  });
  XLSX.utils.book_append_sheet(wb, wsEv, 'Essential Eight Evidence');

  // ---- Methodology sheet ----
  const methRows = [
    ['Step', 'Description'],                              // R0 header
    ['1. Parse both files',         'Read the Controls and Principles sheets from both workbooks. Headers are auto-detected and normalised — org-specific suffixes like "(Company Name)" are stripped before matching canonical column names.'],
    ['2. Classify each control',    'Set-diff of identifiers between the current CCM and the baseline file. IDs only in the CCM are New. IDs in both are Updated when any of description, guideline, maturity level, or applicability differs (case-insensitive). ASD Updated date, Topic, Section/Function, Revision, and Provider Responsibility are metadata-only — they refresh silently in the exported baseline and never independently trigger Updated. IDs only in the baseline are Rescinded. The Changed Fields column records exactly which trigger fields changed for each Updated row.'],
    ['3. Cross-validate',           state.validation ? `Cross-validation against the Changes PDF: ${state.validation.onlyInDelta.length === 0 ? 'no gaps found' : `${state.validation.onlyInDelta.length} delta ID(s) not found in PDF — see themes panel`}. The Changes PDF is used where available to enrich rescinded items with explanatory context; the CCM is the source of truth for delta detection.` : 'Changes PDF not available for this run — rescission reasons not enriched.'],
    ['4. Enrich',                   'For each change, pull the old description from the baseline file and the new description from the current CCM. Attach the baseline file scoping (Provider Responsibility, Implementation Status) and Essential 8 maturity applicability from the CCM.'],
    ['5. Guideline-level pre-fill', 'Guidelines where every control in the baseline file is "Not Applicable" are treated as fully out of scope. Any new or updated control the current quarter adds under such a Guideline is pre-filled In scope = No, Triage = No Action.'],
    ['6. Row-level pre-fill',       'For controls already in the baseline, pre-fill In scope = No when Provider Responsibility or Implementation Status is "Not Applicable"; pre-fill In scope = Yes otherwise. Updated out-of-scope rows also pre-fill Triage = No Action.'],
    ['7. Reviewer responsibility',  'Pre-fills are a time-saver, not an assessment. The reviewer must read each changed control and confirm or override every pre-fill, rationale, recommended action, and owner before the register is shared.'],
    [],
    ['Input-file requirements'],                          // section head (R9)
    ['Unprotected xlsx',    'Both the baseline file and the current-quarter CCM must be plain .xlsx. Password-protected, .xlsm and .xlsb workbooks are not supported.'],
    ['Sensitivity labels',  'Microsoft Purview / AIP / MIP labels prevent the browser parser from reading the file. Remove the label on a working copy before upload; re-apply it on your original after the review. Processing is client-side, so the unlabelled copy never leaves the machine.'],
    [],
    ['Sources'],                                          // section head (R13)
    ['CCM',             'Cloud controls matrix template — ASD / ACSC, current quarter.'],
    ['Changes PDF',     'ISM <quarter> changes — ASD / ACSC companion document. Used to enrich rescinded items with explanatory context. Delta detection proceeds without it.'],
    ['Baseline file',  'Prior System Security Plan-Annex (SSP-A) or Cloud Controls Matrix (CCM).'],
  ];
  const wsMeth = XLSX.utils.aoa_to_sheet(methRows);
  wsMeth['!cols'] = [{ wch: 30 }, { wch: 110 }];
  wsMeth['!rows'] = methRows.map(row => ({ hpt: estimateRowHeight(row, wsMeth['!cols']) }));
  applySheetStyles(wsMeth, { titleRows: [], headerRows: [0], sectionHeadRows: [9, 13] });
  XLSX.utils.book_append_sheet(wb, wsMeth, 'Methodology');

  // Generate xlsx and download
  const xlsxArray = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
  const blob = new Blob([xlsxArray], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
  const fname = `${sanitiseFilename(p.name)}_ISM_Change_Register_${pq.targetQuarter || today}.xlsx`;
  downloadBlob(blob, fname);
}

/* ---- Updated baseline export ---------------------------------------------
Takes the baseline file the user uploaded and produces a new .xlsx ready
to become the next baseline. For each review sheet (Controls + Principles):
  - a new "Change Status" column is appended with values New / Updated /
    Rescinded / No Change
  - existing rows, whether Updated or No Change, have metadata-only fields
    refreshed silently from the current CCM: Updated, Topic, Section/Function,
    Revision, and Provider Responsibility
  - metadata-only fields never independently trigger Updated and are not
    included in Changed Fields
  - Updated rows also refresh the substantive trigger fields that changed:
    Description, Guideline, Applicability, and ML1/ML2/ML3
  - New rows are inserted in CCM order and populated from matching CCM columns
  - Rescinded rows are appended at the end with "[RESCINDED]" prefixed to
    their Description
The Info tab and every other non-review sheet pass through completely untouched
(byte-for-byte). A stale Pivot tab is dropped. The export edits the original
.xlsx at the ZIP/XML level (see src/xlsxsurgery.ts) so dropdowns, panes,
autofilter, column widths and styles are preserved and memory stays flat — the
old xlsx-writer path inflated the file ~20x and exhausted browser memory.
----------------------------------------------------------------------------- */
async function exportUpdatedSSPA() {
  if (!state.files.sspa) { alert('Upload your SSP-A or CCM first.'); return; }
  if (!state.hasComputed) {
    alert('Click Update first to compute the delta.'); return;
  }

  try {
    // Read the original bytes once: a light (style-free) parse drives column
    // detection and the delta-merge; the raw buffer is what we edit and ship.
    const buffer = await state.files.sspa.arrayBuffer();
    const wbLight = readWorkbookSafe(buffer);
    const sheets = findReviewSheets(wbLight);
    if (!sheets.control && !sheets.principle) {
      alert('Baseline file has no recognisable Controls or Principles sheet.'); return;
    }

    const systemClass = (state.product && state.product.classification) || '';
    const rebuilds: any[] = [];
    const adds: any[] = [];

    ['control', 'principle'].forEach(kind => {
      const bundle = state.parsed.byKind[kind];
      if (!bundle || !bundle.ccmRows || !bundle.ccmRows.length) return;

      if (sheets[kind]) {
        // Baseline already has this sheet — rebuild its data losslessly.
        const res = computeReviewPlan(wbLight, sheets[kind], kind, bundle, systemClass);
        if (res) rebuilds.push(res);
      } else if (bundle.ccmSheetName) {
        // CCM has this kind but the baseline doesn't — append a new plain sheet,
        // every row treated as New.
        adds.push(buildAddedReviewSheet(kind, bundle, systemClass));
      }
    });

    if (!rebuilds.length && !adds.length) {
      alert('Nothing to export — no Controls or Principles content was found to update.'); return;
    }

    // Drop only a stale Pivot tab (its cache would still show baseline counts).
    // Info and every other tab are preserved exactly as supplied.
    const out = buildUpdatedXlsx(buffer, {
      rebuilds,
      adds,
      dropSheetRe: /^\s*pivot\b/i,
      clearNames: true,
    });

    const blob = new Blob([out.slice()], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const fname = `${sanitiseFilename(state.product.name)}_updated-baseline_${state.parsed.targetQuarter || 'updated'}.xlsx`;
    downloadBlob(blob, fname);
  } catch (err) {
    console.error('[IRAP Pulse] Updated baseline export failed:', err);
    alert('Could not generate the updated baseline: ' + (err && err.message ? err.message : String(err)));
  }
}

// Build a plain new review sheet (used when the baseline lacks a Controls or
// Principles sheet that the CCM has). Every row is New; classification-excluded
// controls are pre-filled Not Applicable to mirror the in-place update.
function buildAddedReviewSheet(kind, bundle, systemClass) {
  const ccmKeys = Object.keys(bundle.ccmRows[0] || {});
  const norm = (h) => canonicaliseHeader(String(h == null ? '' : h));
  const provIdx = ccmKeys.findIndex(k => norm(k) === 'Provider Responsibility');
  const statIdx = ccmKeys.findIndex(k => norm(k) === 'Implementation Status');
  const commIdx = ccmKeys.findIndex(k => String(k || '').trim() === 'Comments');
  const deltaById: any = Object.create(null);
  state.delta.forEach(d => { if (d.kind === kind) deltaById[d.id] = d; });

  const headers = [...ccmKeys, 'Change Status', 'Previous Description'];
  const rows = bundle.ccmRows.map(r => {
    const vals = ccmKeys.map(k => r[k] ?? null);
    const d = deltaById[normaliseIdentifier(r['Identifier'])];
    if (d && d.classCoverage && d.classCoverage.covered === false) {
      const level = systemClass || 'the assessed classification';
      if (provIdx !== -1 && !vals[provIdx]) vals[provIdx] = 'Not Applicable';
      if (statIdx !== -1) vals[statIdx] = 'Not Applicable';
      if (commIdx !== -1) vals[commIdx] = `This control is not applicable to the system classified as ${level}.`;
    }
    return [...vals, 'New', null];
  });

  const prefix = kind === 'principle' ? 'Principles' : 'Controls';
  return { name: `${prefix} - ${quarterLong(state.parsed.targetQuarter)}`, aoa: [headers, ...rows] };
}

// Find the row index holding the column headers. Baseline files commonly have
// a merged banner row on top. Scan the first 8 rows and pick the one where
// any cell canonicalises to "Identifier" (handles org-specific column suffixes).
function detectHeaderRow(aoa) {
  for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
    if ((aoa[i] || []).some(c => canonicaliseHeader(String(c == null ? '' : c)) === 'Identifier')) return i;
  }
  return 0;
}

// Compute the rebuilt review-sheet contents (header + reordered/added rows +
// the appended Change Status / Previous Description columns) WITHOUT building a
// styled sheet. The lossless writer (rebuildWorksheetXml) reuses the original
// per-row cell styles, so the heavy styled-sheet build + xlsx writer the old
// version used — the cause of the memory blow-up — is gone.
// Returns { originalName, newName, plan } for buildUpdatedXlsx, or null to skip.
function computeReviewPlan(wb, sheetName, kind, bundle, systemClass, opts?) {
  const baselineWasMissing = !!(opts && opts.baselineWasMissing);
  const ws = wb.Sheets[sheetName];
  const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });
  if (!aoa.length) return null;

  const hdrRow = detectHeaderRow(aoa);
  // Trim the header to its last non-empty column. Some workbooks report a hugely
  // inflated used range (e.g. dimension "A1:XEL1083" from a stray far-right cell),
  // which pads every parsed row to thousands of columns. Without trimming, the
  // rebuilt grid would be rows × thousands of columns and exhaust browser memory.
  const rawHeaderRow = (aoa[hdrRow] || []).map(h => (h == null ? '' : String(h)));
  let lastHdrCol = -1;
  for (let i = 0; i < rawHeaderRow.length; i++) if (rawHeaderRow[i].trim() !== '') lastHdrCol = i;
  const baseHeaders = rawHeaderRow.slice(0, lastHdrCol + 1);
  const dataRows = aoa.slice(hdrRow + 1);

  // canonicaliseHeader normalises org-specific suffixes so "(Acme Corp)" matches.
  const normHdr = h => canonicaliseHeader(String(h == null ? '' : h));
  const find = (re) => baseHeaders.findIndex(h => re.test(normHdr(h)));

  // When the file has multiple columns mapping to the same canonical name
  // (e.g. two "Implementation Status" columns), prefer the one whose RAW
  // header contains the user-supplied organisation name.
  const orgName = (($('org-name') && $('org-name').value) || '').trim().toLowerCase();

  const idCol      = find(/^Identifier$/);
  const revCol     = find(/^Revision$/);
  const updCol     = find(/^Updated$/);
  const descCol    = find(/^Description$/);
  const gdlCol     = find(/^Guideline$/);
  const topicCol   = find(/^Topic$/);
  const sectCol    = find(/^Section$/);
  const funcCol    = find(/^Function$/);

  // Parent row (row above header) — used to resolve duplicate columns in
  // multi-party SSP-A templates where each party has its own column group.
  // Must be defined before the grouped-column lookups below.
  const parentRow = hdrRow > 0 ? (aoa[hdrRow - 1] || []) : [];
  const getParentGroup = (col) => {
    for (let c = col; c >= 0; c--) {
      const v = String(parentRow[c] || '').trim();
      if (v) return v.toLowerCase();
    }
    return '';
  };

  // Use parent-group scoring for all multi-party columns so that ASD-style or
  // client-modified SSP-As with merged parent headers resolve to the correct
  // party's column, not just the first match.
  const provCol    = findGroupedColumn(/^Provider Responsibility$/, baseHeaders, orgName, null, getParentGroup);
  const statCol    = findGroupedColumn(/^Implementation Status$/,   baseHeaders, orgName, null, getParentGroup);
  const commentCol = findCommentColumn(baseHeaders, orgName, statCol, getParentGroup);
  // Applicability columns — per-classification booleans and/or free-text column.
  const classCols  = ['NC','OS','P','S','TS'].map(code => ({ code, col: find(new RegExp(`^${code}$`)) }))
                       .filter(x => x.col !== -1);
  const applTxtCol = find(/^Applicability$/);
  // Essential Eight maturity level columns.
  const ml1Col = find(/^ML1$/);
  const ml2Col = find(/^ML2$/);
  const ml3Col = find(/^ML3$/);
  if (idCol === -1)   { console.warn(`[${sheetName}] no "Identifier" column — skipped`); return null; }
  if (descCol === -1) { console.warn(`[${sheetName}] no "Description" column — skipped`); return null; }

  // Lookup baseline rows by ID.
  // When baselineWasMissing the sheet was synthesised from the CCM, so every
  // row would appear to "exist" — override to empty so all rows are treated as New.
  const baselineById = Object.create(null);
  if (!baselineWasMissing) {
    dataRows.forEach((r, k) => {
      const id = r && r[idCol] != null ? normaliseIdentifier(r[idCol]) : '';
      // Track the original Excel row (1-based) so the writer can reuse its styles.
      if (id) baselineById[id] = { row: r, excelRow: hdrRow + 2 + k };
    });
  }

  // Seed comments by Guideline for the classification-NA auto-comment.
  // CCM header map (normalised key → original key) for populating new rows.
  const ccmHeaderMap = Object.create(null);
  if (bundle.ccmRows.length) {
    Object.keys(bundle.ccmRows[0]).forEach(k => { ccmHeaderMap[normHdr(k).toLowerCase()] = k; });
  }
  const deltaById = Object.create(null);
  state.delta.forEach(d => { if (d.kind === kind) deltaById[d.id] = d; });

  // Build output rows in CCM order
  const newRows = [];
  const rowKinds = [];        // 'retained' | 'new' | 'modified' | 'rescinded'
  const statusLabels = [];    // 'No Change' | 'New' | 'Updated' | 'Rescinded'
  const prevDescriptions = []; // parallel to newRows — old Description text for Updated rows, null otherwise
  const sourceExcelRows = []; // parallel to newRows — original Excel row to copy styles from, or null for new rows

  bundle.ccmRows.forEach(ccmRow => {
    const id = normaliseIdentifier(ccmRow['Identifier']);
    if (!id) return;
    const existing = baselineById[id];
    const d = deltaById[id];

    if (existing) {
      // Slice to the trimmed header width — drops the empty far-right columns a
      // bloated used range would otherwise carry, keeping memory bounded.
      const row = existing.row.slice(0, baseHeaders.length);
      while (row.length < baseHeaders.length) row.push(null);
      // Refresh all metadata-only fields on every existing row — Updated and No Change alike
      // — so the exported baseline is always current. These fields never trigger Updated
      // but must still be refreshed silently. Reviewer columns (Implementation Status,
      // Comments) are intentionally untouched.
      //
      // UPDATED_METADATA_ONLY_FIELDS is the authoritative policy list.  The column map
      // below translates each policy field name to its resolved column index so the
      // refresh loop stays automatically in sync when the policy constant changes.
      // Section and Function are handled separately (symmetric cross-fallback needed).
      const fieldColMap = {
        'Topic':                   topicCol,
        'Revision':                revCol,
        'Updated':                 updCol,
        'Provider Responsibility': provCol,
        'Section':                 sectCol,
        'Function':                funcCol,
      };
      UPDATED_METADATA_ONLY_FIELDS
        .filter(f => f !== 'Section' && f !== 'Function')
        .forEach(field => {
          const col = fieldColMap[field];
          if (col != null && col !== -1 && ccmRow[field] != null) row[col] = ccmRow[field];
        });
      // Section and Function use symmetric cross-fallback: if the CCM does not carry
      // the exact matching field name, each falls back to the other. This handles
      // baselines where one column has been canonicalised to the other name.
      if (sectCol !== -1) {
        const sectionVal = ccmRow['Section']  != null ? ccmRow['Section']
                         : ccmRow['Function'] != null ? ccmRow['Function']
                         : null;
        if (sectionVal != null) row[sectCol] = sectionVal;
      }
      if (funcCol !== -1) {
        const fnVal = ccmRow['Function'] != null ? ccmRow['Function']
                    : ccmRow['Section']  != null ? ccmRow['Section']
                    : null;
        if (fnVal != null) row[funcCol] = fnVal;
      }
      if (d && d.changeType === 'Updated') {
        // Description — write the clean new description into the Description column
        // so the exported file is usable as a future baseline without artifacts.
        // When text changed, store the old description separately so reviewers
        // have both versions; the Description column itself stays clean.
        if (d.subFlags && d.subFlags.textChanged) {
          const oldDesc = existing.row[descCol] == null ? '' : String(existing.row[descCol]);
          row[descCol] = String(ccmRow['Description'] || '');
          prevDescriptions.push(oldDesc);
        } else {
          prevDescriptions.push(null);
        }
        // Guideline — refresh so the export matches the dashboard grouping.
        // (Updated date was already refreshed in the common metadata block above.)
        if (gdlCol !== -1 && ccmRow['Guideline'] != null) row[gdlCol] = ccmRow['Guideline'];
        // Applicability columns — refresh per-classification booleans and free-text.
        classCols.forEach(({ code, col }) => { row[col] = ccmRow[code] ?? null; });
        if (applTxtCol !== -1 && ccmRow['Applicability'] != null) row[applTxtCol] = ccmRow['Applicability'];
        // Essential Eight maturity level columns.
        if (ml1Col !== -1) row[ml1Col] = ccmRow['ML1'] ?? null;
        if (ml2Col !== -1) row[ml2Col] = ccmRow['ML2'] ?? null;
        if (ml3Col !== -1) row[ml3Col] = ccmRow['ML3'] ?? null;
        // Classification-based NA pre-fill for Updated rows where applicability changed.
        // Provider Responsibility was already refreshed as metadata above — only
        // Implementation Status and Comments are set here.
        if (d.subFlags && d.subFlags.applChanged && d.classCoverage && d.classCoverage.covered === false) {
          if (statCol !== -1) row[statCol] = 'Not Applicable';
          if (commentCol !== -1) {
            const level = systemClass || 'the assessed classification';
            row[commentCol] = `This control is not applicable to the system classified as ${level}.`;
          }
        }
        rowKinds.push('modified');
        statusLabels.push('Updated');
      } else {
        // No substantive change — metadata already refreshed above.
        rowKinds.push('retained');
        statusLabels.push('No Change');
        prevDescriptions.push(null);
      }
      newRows.push(row);
      sourceExcelRows.push(existing.excelRow);
    } else {
      // Brand-new row — populate every SSP-A column whose name matches a
      // CCM column (case/whitespace insensitive).
      const row = new Array(baseHeaders.length).fill(null);
      baseHeaders.forEach((h, col) => {
        const key = ccmHeaderMap[normHdr(h).toLowerCase()];
        if (key != null && ccmRow[key] != null && ccmRow[key] !== '') row[col] = ccmRow[key];
      });
      row[idCol] = id;
      if (descCol !== -1 && !row[descCol]) row[descCol] = ccmRow['Description'] || '';

      // Classification-based NA pre-fill for New rows.
      // Provider Responsibility: pre-fill only if the CCM did not already set it
      // (i.e. it is still blank after the column-map loop above).
      if (d && d.classCoverage && d.classCoverage.covered === false) {
        if (provCol !== -1 && !row[provCol]) row[provCol] = 'Not Applicable';
        if (statCol !== -1) row[statCol] = 'Not Applicable';
        if (commentCol !== -1) {
          const level = systemClass || 'the assessed classification';
          row[commentCol] = `This control is not applicable to the system classified as ${level}.`;
        }
      }
      newRows.push(row);
      rowKinds.push('new');
      statusLabels.push('New');
      prevDescriptions.push(null);
      sourceExcelRows.push(null);
    }
  });

  // Rescinded tail
  const ccmIds = new Set(bundle.ccmRows.map(r => normaliseIdentifier(r['Identifier'])));
  dataRows.forEach((r, k) => {
    const id = r && r[idCol] != null ? normaliseIdentifier(r[idCol]) : '';
    if (!id || ccmIds.has(id)) return;
    const row = r.slice(0, baseHeaders.length);
    while (row.length < baseHeaders.length) row.push(null);
    const existingRescDesc = row[descCol] == null ? '' : String(row[descCol]);
    row[descCol] = existingRescDesc.startsWith('[RESCINDED]') ? existingRescDesc : '[RESCINDED] ' + existingRescDesc;
    newRows.push(row);
    rowKinds.push('rescinded');
    statusLabels.push('Rescinded');
    prevDescriptions.push(null);
    sourceExcelRows.push(hdrRow + 2 + k);
  });

  // Schema migration: rename old column labels to match current CCM naming.
  // E.g., older CCMs used "All" for what is now "NC" (not classified).
  // Renamed columns are colour-coded in the header row of the output file.
  const SCHEMA_HEADER_RENAMES = { 'All': 'NC', 'ALL': 'NC', 'O': 'OS', 'o': 'OS' };
  const renamedColIndices = new Set();
  const modernisedHeaders = baseHeaders.map((h, i) => {
    const trimmed = String(h || '').trim();
    if (SCHEMA_HEADER_RENAMES[trimmed]) {
      renamedColIndices.add(i);
      return SCHEMA_HEADER_RENAMES[trimmed];
    }
    return h;
  });

  // Assemble final AOA.
  // "Change Status" and "Previous Description" are appended as the last columns
  // so existing column references/formulas in the baseline are not broken by shifts.
  // Both are idempotent: reuse the existing column if already present from a prior run.
  let statusColIdx = modernisedHeaders.findIndex(h => String(h || '').trim() === 'Change Status');
  let prevDescColIdx = modernisedHeaders.findIndex(h => String(h || '').trim() === 'Previous Description');

  const extraHeaders = [];
  if (statusColIdx === -1) { statusColIdx = modernisedHeaders.length + extraHeaders.length; extraHeaders.push('Change Status'); }
  if (prevDescColIdx === -1) { prevDescColIdx = modernisedHeaders.length + extraHeaders.length; extraHeaders.push('Previous Description'); }

  const finalHeaders = [...modernisedHeaders, ...extraHeaders];
  const finalRows = newRows.map((r, i) => {
    const out = [...r];
    // Read previous description from the parallel array (not from a custom property
    // on the array object, which array spread does not preserve).
    const prevDesc = prevDescriptions[i] || null;
    // Pad to full header width before setting extra columns.
    while (out.length < finalHeaders.length) out.push(null);
    out[statusColIdx]   = statusLabels[i];
    out[prevDescColIdx] = prevDesc;
    return out;
  });
  // Change indication is carried by the appended "Change Status" / "Previous
  // Description" columns (sortable and filterable), so the lossless writer does
  // not add cell fills — it reuses each row's original formatting instead.
  // `renamedColIndices` / `rowKinds` remain available for callers/future use.
  void renamedColIndices;

  // Rename the sheet to reflect the target quarter so next quarter's run still
  // picks up the right baseline (quarterFromSheetName matches on sheet name).
  const prefix = kind === 'principle' ? 'Principles' : 'Controls';
  const newSheetName = `${prefix} - ${quarterLong(state.parsed.targetQuarter)}`;

  return {
    originalName: sheetName,
    newName: newSheetName,
    plan: { finalHeaders, finalRows, sourceExcelRows, headerExcelRow: hdrRow + 1 },
  };
}

// Find the best comment/note column given optional org name, a reference Implementation
// Generic grouped-column finder.  Scans `headers` for columns whose
// CANONICALIZED name matches `re` (same as how `find()` works inside
// updateReviewSheet — canonical names survive alias expansion, so e.g.
// a column literally named "Implementation" still matches
// /^Implementation Status$/ after canonicaliseHeader maps it).
// Scores candidates: +10 for sharing the same parent group as `anchorCol`,
// +5 for containing `orgName` in the raw header or parent label.
// Returns the index of the best match, or -1 if none found.
function findGroupedColumn(re, headers, orgName, anchorCol, getParentGroup) {
  const candidates = [];
  headers.forEach((h, i) => {
    const canon = canonicaliseHeader(String(h == null ? '' : h));
    if (re.test(canon)) candidates.push(i);
  });
  if (!candidates.length) return -1;
  if (candidates.length === 1) return candidates[0];

  const anchorGroup = (anchorCol != null && anchorCol !== -1 && getParentGroup)
    ? getParentGroup(anchorCol) : '';
  const orgLc = (orgName || '').toLowerCase();

  const score = (col) => {
    let s = 0;
    const raw = String(headers[col] || '').toLowerCase();   // raw for org-name check
    const grp = getParentGroup ? getParentGroup(col) : '';
    if (anchorGroup && grp === anchorGroup) s += 10;
    if (orgLc && (raw.includes(orgLc) || grp.includes(orgLc))) s += 5;
    return s;
  };

  return candidates.sort((a, b) => score(b) - score(a))[0];
}

// Status column, and a parent-group resolver.
// Priority order:
//   1. Same parent group as statCol AND contains orgName
//   2. Same parent group as statCol
//   3. Contains orgName
//   4. First comment column found
function findCommentColumn(headers, orgName, statCol, getParentGroup) {
  const priorities = [/comment/i, /note/i, /rationale/i, /remark/i];
  const candidates = [];
  headers.forEach((h, i) => {
    if (priorities.some(re => re.test(String(h || '').trim()))) candidates.push(i);
  });
  if (!candidates.length) return -1;

  const statGroup = (statCol != null && statCol !== -1 && getParentGroup) ? getParentGroup(statCol) : '';
  const orgLc = (orgName || '').toLowerCase();

  // Score candidates: higher is better.
  const score = (col) => {
    let s = 0;
    const raw = String(headers[col] || '').toLowerCase();
    const grp = getParentGroup ? getParentGroup(col) : '';
    if (statGroup && grp === statGroup) s += 10;
    if (orgLc && (raw.includes(orgLc) || grp.includes(orgLc))) s += 5;
    return s;
  };

  return candidates.sort((a, b) => score(b) - score(a))[0];
}


document.getElementById('btn-export-xlsx').addEventListener('click', exportXlsx);
