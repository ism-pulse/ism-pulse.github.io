function updateBundledStatus(ccmOk, pdfOk, ccmMsg, pdfMsg) {
  const ccmEl  = $('bundled-ccm-item');
  const pdfEl  = $('bundled-pdf-item');
  const ccmLbl = $('bundled-ccm-label');
  const pdfLbl = $('bundled-pdf-label');
