$('btn-cmp-export').addEventListener('click', exportCmpRegister);

function exportCmpRegister() {
  if (!state3.delta.length) return;

  const now     = new Date();
  const dateStr = now.toLocaleDateString('en-AU', { day: '2-digit', month: 'short', year: 'numeric' });

  // ---- Shared style constants (same as downloadChangeRegister) ----
  const BASE_ALIGN    = { horizontal: 'left', vertical: 'center', wrapText: true };
  const THIN          = { style: 'thin', color: { rgb: 'CFD6E0' } };
  const BORD          = { top: THIN, bottom: THIN, left: THIN, right: THIN };
  const cellStyle     = { alignment: BASE_ALIGN, border: BORD, font: { name: 'Calibri', sz: 11 } };
  const headerStyle   = { alignment: BASE_ALIGN, border: BORD, font: { name: 'Calibri', sz: 11, bold: true, color: { rgb: 'FFFFFF' } }, fill: { patternType: 'solid', fgColor: { rgb: '1F3864' } } };
  const titleStyle    = { alignment: BASE_ALIGN, font: { name: 'Calibri', sz: 14, bold: true, color: { rgb: '1F3864' } } };
  const sectHeadStyle = { alignment: BASE_ALIGN, border: BORD, font: { name: 'Calibri', sz: 11, bold: true, color: { rgb: '2E75B6' } }, fill: { patternType: 'solid', fgColor: { rgb: 'EEF3F9' } } };
  const metaKeyStyle  = { alignment: BASE_ALIGN, border: BORD, font: { name: 'Calibri', sz: 11, bold: true } };
  const changeFill    = { New: 'C9DAF8', Updated: 'FCE5CD', Rescinded: 'EAD1DC' };

  // Apply uniform cell styles with optional special rows.
  function styleWs(ws, { titleRows = [], headerRows = [], sectionRows = [], metaKeyRows = [] } = {}) {
    if (!ws['!ref']) return;
    const range = XLSX.utils.decode_range(ws['!ref']);
    for (let R = range.s.r; R <= range.e.r; R++) {
      for (let C = range.s.c; C <= range.e.c; C++) {
        const addr = XLSX.utils.encode_cell({ r: R, c: C });
        if (!ws[addr]) ws[addr] = { t: 's', v: '' };
        if (titleRows.includes(R))          ws[addr].s = titleStyle;
        else if (headerRows.includes(R))    ws[addr].s = headerStyle;
        else if (sectionRows.includes(R))   ws[addr].s = sectHeadStyle;
        else if (metaKeyRows.includes(R) && C === 0) ws[addr].s = metaKeyStyle;
        else ws[addr].s = { ...cellStyle };
      }
    }
  }

  // Style a delta sheet: dark header row + change-type row fills.
  function styleDeltaWs(ws, rows) {
    if (!ws['!ref']) return;
    const range = XLSX.utils.decode_range(ws['!ref']);
    // Header row
    for (let C = range.s.c; C <= range.e.c; C++) {
      const addr = XLSX.utils.encode_cell({ r: 0, c: C });
      if (!ws[addr]) ws[addr] = { t: 's', v: '' };
      ws[addr].s = headerStyle;
    }
    // Data rows
    rows.forEach((d, i) => {
      const R   = i + 1;
      const rgb = changeFill[d.changeType] || null;
      for (let C = range.s.c; C <= range.e.c; C++) {
        const addr = XLSX.utils.encode_cell({ r: R, c: C });
        if (!ws[addr]) ws[addr] = { t: 's', v: '' };
        const s: any = { ...cellStyle };
        if (rgb) s.fill = { patternType: 'solid', fgColor: { rgb } };
        if (C === 1) s.font = { ...s.font, bold: true }; // Change column bold
        ws[addr].s = s;
      }
    });
  }

  // ---- Workbook ----
  const wb = XLSX.utils.book_new();
  wb.Props = {
    Title: 'ISM Version Compare Register', Author: 'Cybernion',
    Company: 'Independent — https://cybernion.com.au/',
    Comments: '© 2026 Cybernion. All rights reserved. Generated by IRAP Pulse.',
    CreatedDate: now,
  };

  // ---- Counts ----
  const ctrlCounts = { New: 0, Updated: 0, Rescinded: 0 };
  const prinCounts = { New: 0, Updated: 0, Rescinded: 0 };
  state3.delta.forEach(d => {
    if (d.kind === 'principle') prinCounts[d.changeType]++;
    else ctrlCounts[d.changeType]++;
  });
  const ctrlTotal = ctrlCounts.New + ctrlCounts.Updated + ctrlCounts.Rescinded;
  const prinTotal = prinCounts.New + prinCounts.Updated + prinCounts.Rescinded;

  // ---- Summary sheet ----
  const summaryAoa = [
    ['ISM Version Compare — Summary'],                               // R0  title
    [],
    ['Baseline version',   state3.baselineLabel],                    // R2  meta
    ['Current version',    state3.currentLabel],
    ['Comparison date',    dateStr],
    ['Generated by',       'IRAP Pulse — https://cybernion.com.au/'],
    [],
    ['Controls'],                                                     // R7  section
    ['Change type', 'Count'],                                         // R8  header
    ['New',       ctrlCounts.New],
    ['Updated',   ctrlCounts.Updated],
    ['Rescinded', ctrlCounts.Rescinded],
    ['Total',     ctrlTotal],
    [],
    ['Principles'],                                                   // R14 section
    ['Change type', 'Count'],                                         // R15 header
    ['New',       prinCounts.New],
    ['Updated',   prinCounts.Updated],
    ['Rescinded', prinCounts.Rescinded],
    ['Total',     prinTotal],
    [],
    ['Grand total', state3.delta.length],
  ];
  const wsSummary = XLSX.utils.aoa_to_sheet(summaryAoa);
  styleWs(wsSummary, { titleRows: [0], sectionRows: [7, 14], headerRows: [8, 15], metaKeyRows: [2,3,4,5,21] });
  autoFitCols(wsSummary, { min: 18, max: 60 });
  wsSummary['!merges'] = [
    { s: { r: 0,  c: 0 }, e: { r: 0,  c: 1 } },   // title
    { s: { r: 7,  c: 0 }, e: { r: 7,  c: 1 } },   // Controls section head
    { s: { r: 14, c: 0 }, e: { r: 14, c: 1 } },   // Principles section head
  ];
  const summaryColWidths = wsSummary['!cols'] || [];
  wsSummary['!rows'] = summaryAoa.map((row, i) => {
    if (i === 0) return { hpt: 28 };
    if ([8, 15].includes(i)) return { hpt: 24 };
    return { hpt: estimateRowHeight(row, summaryColWidths) };
  });
  XLSX.utils.book_append_sheet(wb, wsSummary, 'Summary');

  // ---- Delta sheets ----
  const buildDeltaSheet = (kind) => {
    const rows = state3.delta.filter(d => d.kind === kind);
    if (!rows.length) return null;
    const glOrFn = kind === 'principle' ? 'Function' : 'Guideline';
    const hdrs = ['Identifier', 'Change', glOrFn, 'Section', 'Topic',
                  'Applicability', 'ML Levels', 'New Description', 'Previous Description', 'Updated Fields'];
    const data = rows.map(d => [
      d.id,
      d.changeType,
      kind === 'principle' ? (d.functionName || functionFromId(d.id) || '') : (d.guideline || ''),
      d.section || '',
      d.topic || '',
      d.applicability || '',
      d.mlLevels !== '-' ? (d.mlLevels || '') : '',
      d.changeType === 'Rescinded' ? d.oldText : d.newText,
      d.changeType === 'New' ? '' : d.oldText,
      d.subFlags ? changedFieldsLabel(d.subFlags) : '',
    ]);
    const allRowsData = [hdrs, ...data];
    const ws = XLSX.utils.aoa_to_sheet(allRowsData);
    styleDeltaWs(ws, rows);
    autoFitCols(ws, { min: 8, max: 80 });
    // Cap narrow/ID columns so they don't expand to match long descriptions.
    // Identifier (0), Change (1), Applicability (5), ML Levels (6) stay compact;
    // Changed Fields (9) needs more room for multi-field labels like "Description, Guideline, Applicability".
    const cols = ws['!cols'] || [];
    [0, 1, 5, 6].forEach(c => { if (cols[c]) cols[c].wch = Math.min(cols[c].wch || 20, 22); });
    if (cols[9]) cols[9].wch = Math.min(cols[9].wch || 20, 45);
    ws['!cols'] = cols;
    // Row heights: header at 32pt, data rows estimated from wrapped text length.
    ws['!rows'] = allRowsData.map((row, i) => {
      if (i === 0) return { hpt: 32 };
      return { hpt: estimateRowHeight(row, cols) };
    });
    ws['!autofilter'] = { ref: `A1:${XLSX.utils.encode_col(hdrs.length - 1)}${rows.length + 1}` };
    return ws;
  };

  const ctrlWs = buildDeltaSheet('control');
  const prinWs = buildDeltaSheet('principle');
  if (ctrlWs) XLSX.utils.book_append_sheet(wb, ctrlWs, 'Controls');
  if (prinWs) XLSX.utils.book_append_sheet(wb, prinWs, 'Principles');

  // ---- Methodology sheet ----
  const methAoa = [
    ['ISM Version Compare — Methodology'],                           // R0  title
    [],
    ['Baseline version',  state3.baselineLabel],                     // R2  meta
    ['Current version',   state3.currentLabel],
    ['Comparison date',   dateStr],
    ['Tool',              'IRAP Pulse — ISM Version Compare (https://cybernion.com.au/)'],
    [],
    ['Fields that trigger Updated'],                                  // R7  section
    ['Description · Guideline · Applicability (NC, OS, P, S, TS) · Maturity mapping (ML1, ML2, ML3)'],
    [],
    ['Metadata-only fields (silent baseline refresh, never trigger Updated)'],  // R10 section
    ['ASD Updated date · Topic · Section · Function · Revision · Provider Responsibility'],
    [],
    ['Notes'],                                                       // R13 section
    ['This register compares unmodified ASD CCM releases. Results may differ from the SSP-A Update tool if your working baseline has been manually edited.'],
    ['New and Rescinded labels are relative to the direction of comparison. Baseline is the older version; current is the newer version.'],
    [],
    ['Disclaimer'],                                                  // R17 section
    ['This register is a decision-support artefact only. It is not IRAP advice. The reviewer must confirm every change before the register is shared.'],
  ];
  const wsMeth = XLSX.utils.aoa_to_sheet(methAoa);
  styleWs(wsMeth, { titleRows: [0], sectionRows: [7, 10, 13, 17], metaKeyRows: [2,3,4,5] });
  autoFitCols(wsMeth, { min: 20, max: 100 });
  const methColWidths = wsMeth['!cols'] || [];
  wsMeth['!rows'] = methAoa.map((row, i) => {
    if (i === 0) return { hpt: 28 };
    return { hpt: estimateRowHeight(row, methColWidths) };
  });
  XLSX.utils.book_append_sheet(wb, wsMeth, 'Methodology');

  const filename = `ISM Version Compare — ${state3.baselineLabel} to ${state3.currentLabel}.xlsx`
    .replace(/[/\\:*?"<>|]/g, '-');
  const xlsxArray = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
  downloadBlob(new Blob([xlsxArray], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), filename);
}

// ---- Populate topic dropdown filtered to the selected guideline ------------
function populateCmpTopics(guidelineFilter) {
  const rows = guidelineFilter === 'all'
    ? state3.delta
    : state3.delta.filter(d => (d.guideline || '') === guidelineFilter);
  const topics = [...new Set(rows.filter(d => d.topic).map(d => d.topic))]
    .sort((a, b) => a.localeCompare(b));
  const sel = $('cmp-filter-topic');
  sel.innerHTML = '<option value="all">All</option>';
  topics.forEach(v => {
    const opt = document.createElement('option');
    opt.value = v;
    opt.textContent = v;
    sel.appendChild(opt);
  });
  sel.value = 'all';
}

// ---- Full results render ---------------------------------------------------
function renderCmpResults() {
  // Reset filters UI
  $('cmp-filter-kind').value   = 'all';
  $('cmp-filter-change').value = 'all';
  $('cmp-filter-search').value = '';
  state3.filters = { kind: 'all', change: 'all', guideline: 'all', topic: 'all', search: '' };
  state3.collapsedGuidelines = new Set();

  // Populate Guideline dropdown from the current delta.
  const guidelines = [...new Set(
    state3.delta.filter(d => d.guideline).map(d => d.guideline)
  )].sort((a, b) => a.localeCompare(b));

  const populateSel = (id, values) => {
    const sel = $(id);
    sel.innerHTML = '<option value="all">All</option>';
    values.forEach(v => {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      sel.appendChild(opt);
    });
    sel.value = 'all';
  };
  populateSel('cmp-filter-guideline', guidelines);
  populateCmpTopics('all');

  renderCmpDashboard();
  renderCmpTable();
  // Wait for the canvas to have non-zero dimensions before handing off to
  // Chart.js — rAF alone fires before layout, so we poll until the container
  // is visible. Safety cap of 60 frames (~1 s) prevents an infinite loop if
  // the canvas is somehow never laid out.
  let attempts = 0;
  (function waitForCanvas() {
    const canvas = document.getElementById('cmp-bar-chart');
    if ((canvas && canvas.offsetWidth > 0) || attempts++ >= 60) {
      renderCmpBarChart();
      renderCmpDonutChart();
    } else {
      requestAnimationFrame(waitForCanvas);
    }
  })();
}


