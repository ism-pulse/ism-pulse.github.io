// Override flag — when the user has clicked "Proceed anyway" on a file-type
// warning, skip the soft swap-detection check for the rest of this session.
// Reset whenever a file changes (handled in bindFileInput) so a fresh pair of
// uploads gets validated from scratch.
$('btn-override').addEventListener('click', () => {
  state.overrideFileTypeCheck = true;
  $('btn-compute').click();
});

$('btn-compute').addEventListener('click', async () => {
  const errEl  = $('compute-error');
  const warnEl = $('compute-warning');
  errEl.style.display = 'none';
  warnEl.style.display = 'none';
  $('btn-compute').disabled = true;
  $('btn-compute').innerHTML = '<span class="spinner"></span>Updating…';

  try {
    // --- Hard-stop validation ------------------------------------------
    // Mandatory-field errors CANNOT be overridden via "Proceed anyway".
    // They must be fixed. This covers all three product-detail fields and
    // the user-uploaded baseline file (the CCM is bundled and auto-loaded).
    const hardErrors = validateProductDetails().map(e => e.msg);
    if (state.bundled.status !== 'ready') hardErrors.push('The bundled CCM and Changes PDF have not loaded yet. If this error persists, check your network connection and reload the page.');
    if (!state.files.sspa) hardErrors.push('Your SSP-A or CCM (.xlsx) is required. Please upload it before running an update.');
    if (hardErrors.length) {
      $('compute-error').innerHTML =
        '<b>Cannot compute — required inputs are missing:</b><ul style="margin: 8px 0 0 0; padding-left: 18px;">' +
        hardErrors.map(e => `<li style="margin-bottom: 4px;">${escapeHtml(e)}</li>`).join('') +
        '</ul>';
      errEl.style.display = 'block';
      return;
    }

    // --- Soft validation (heuristic — overridable) ---------------------
    // File-shape heuristics and PDF signal scoring may produce false
    // positives on legitimate but unusual files, so they surface with a
    // "Proceed anyway" button.
    const warnings = [];
    // Bundled CCM + PDF are served from the same host — skip user-facing
    // validation for those; only validate the user-uploaded SSP-A.
    warnings.push(...await validateXlsxFile(state.files.sspa, 'sspa'));
    if (warnings.length && !state.overrideFileTypeCheck) {
      $('compute-warning-text').innerHTML =
        '<b>Before you compute:</b> some inputs look unusual (they may still be fine). Review the list below — you can adjust the files and try again, or click <b>Proceed anyway</b> if you know what you\'re doing.<ul style="margin: 8px 0 0 0; padding-left: 18px;">' +
        warnings.map(w => `<li style="margin-bottom: 4px;">${escapeHtml(w)}</li>`).join('') +
        '</ul>';
      warnEl.style.display = 'block';
      return; // wait for the user to click "Proceed anyway" or replace files
    }

    // Parse CCM — from the bundled server-side ArrayBuffer
    const ccmWb = parseXLSXFromBuffer(state.bundled.ccmBuffer);
    const ccmSheets = findReviewSheets(ccmWb);
    if (!ccmSheets.control && !ccmSheets.principle) {
      throw new Error('CCM: no "Controls" or "Principles" sheet found.');
    }

    // Parse SSP-A — Controls + Principles sheets
    const sspaWb = await parseXLSX(state.files.sspa);
    const sspaSheets = findReviewSheets(sspaWb);
    if (!sspaSheets.control && !sspaSheets.principle) {
      throw new Error('Baseline file: no recognisable Controls or Principles sheet found.');
    }

    // A kind is only processed if BOTH the CCM and SSP-A have that sheet —
    // we can't compute a meaningful delta otherwise.
    const kinds = ['control', 'principle'];
    const groups = [];
    const kindData = { control: null, principle: null };

    kinds.forEach(kind => {
      const ccmName  = ccmSheets[kind];
      const sspaName = sspaSheets[kind];
      // The CCM sheet is required — no CCM means nothing to diff against.
      // The baseline sheet is optional: if it's absent, every CCM row is New.
      if (!ccmName) return;
      const orgNameVal = (($('org-name') && $('org-name').value) || '').trim();
      const ccmRows  = normaliseRows(ccmWb.Sheets[ccmName]);
      const sspaRows = sspaName ? normaliseRows(sspaWb.Sheets[sspaName], orgNameVal) : [];
      const targetQuarter   = quarterFromSheetName(ccmName);
      const baselineQuarter = sspaName ? quarterFromSheetName(sspaName) : '';
      kindData[kind] = { ccmSheetName: ccmName, sspaSheetName: sspaName || '', ccmRows, sspaRows, targetQuarter, baselineQuarter };
      groups.push({ kind, ccmRows, sspaRows, targetQuarter });
    });

    if (!groups.length) throw new Error('No Controls or Principles sheet found in the bundled CCM.');

    // Source of truth for the tool's quarter labels is the first available sheet.
    const primary = kindData.control || kindData.principle;
    state.parsed.targetQuarter   = primary.targetQuarter;
    state.parsed.baselineQuarter = primary.baselineQuarter;

    // Baseline quarter is display-only — not needed for the delta computation.
    // If the sheet name doesn't follow the "Controls - Month YYYY" convention,
    // fall back to "Unknown" so the tool continues rather than hard-stopping.
    if (!state.parsed.targetQuarter)   throw new Error('Could not determine the current quarter from the bundled CCM sheet name. This is unexpected — please report it.');
    if (!state.parsed.baselineQuarter) state.parsed.baselineQuarter = 'Unknown';

    // Cross-kind quarter consistency check — warn in console but don't block
    kinds.forEach(k => {
      if (kindData[k] && (kindData[k].targetQuarter !== state.parsed.targetQuarter ||
                          kindData[k].baselineQuarter !== state.parsed.baselineQuarter)) {
        console.warn(`Quarter mismatch across kind "${k}": ${kindData[k].baselineQuarter} → ${kindData[k].targetQuarter}`);
      }
    });

    state.parsed.byKind = {
      control:   kindData.control   || { ccmRows: [], sspaRows: [], ccmSheetName: '', sspaSheetName: '' },
      principle: kindData.principle || { ccmRows: [], sspaRows: [], ccmSheetName: '', sspaSheetName: '' },
    };
    // Flat convenience accessors (concatenation)
    state.parsed.ccmRows  = [].concat(state.parsed.byKind.control.ccmRows,  state.parsed.byKind.principle.ccmRows);
    state.parsed.sspaRows = [].concat(state.parsed.byKind.control.sspaRows, state.parsed.byKind.principle.sspaRows);

    // Capture live product details (user may not have blurred inputs yet)
    state.product.organisation   = $('org-name').value;
    state.product.name           = $('product-name').value;
    state.product.classification = $('product-classification').value;
    state.product.overview       = $('product-overview').value;

    // Parse Changes PDF from the bundled server-side ArrayBuffer.
    // PDF is optional enrichment — if pdf.js or parsing fails, the delta still
    // runs; only rescission reasons are skipped.
    if (state.bundled.changesBuffer) {
      try {
        state.parsed.changesText = await parsePDFFromBuffer(state.bundled.changesBuffer);
      } catch (pdfErr) {
        console.warn('[IRAP Pulse] PDF parsing failed — rescission reasons will not be shown:', pdfErr);
        state.parsed.changesText = '';
      }
    }

    // Compute delta across all groups
    state.delta = computeDelta(groups, { systemClassification: state.product.classification });
    // Zero delta is not an error — the quarter may have only metadata refreshes
    // (e.g. Updated dates, Revision numbers). Flag it so the dashboard can surface
    // a note, but still render and enable export so metadata refreshes silently.
    state.metadataOnlyQuarter = (state.delta.length === 0);
    state.hasComputed = true;
    // Compute applicability drift (SSP-A vs CCM) for rows present in both files.
    // This surfaces cases where ASD widened or narrowed classification coverage
    // without the control text itself changing — a drift the normal delta
    // wouldn't otherwise catch. Skipped automatically when the baseline is a
    // raw CCM rather than an SSP-A (isLikelySSPA check inside the helper).
    state.drift = computeApplicabilityDrift(groups);

    // Enrich rescinded items with the ASD explanation from the Changes PDF
    // (if provided). Kept as a post-pass so the core delta logic stays focused
    // on structural diff — and so the enrichment no-ops silently when there's
    // no PDF or the ID can't be found.
    //
    // For Principles we also pass the topic phrase because ISM Changes PDFs
    // typically describe principle rescissions by their human-readable topic
    // (e.g. "secure by design") rather than by the PRO-## identifier, which
    // only appears in the CCM workbook. Controls use the numeric ID as the
    // primary anchor and fall back to topic only when ID matching fails.
    if (state.parsed.changesText) {
      state.delta.forEach(d => {
        if (d.changeType !== 'Rescinded') return;
        const reason = extractRescissionReason(
          state.parsed.changesText,
          d.id,
          d.topic || ''
        );
        if (reason) d.rescissionReason = reason;
      });
    }

    // Analyse the baseline file at Guideline level: a Guideline is "fully out of scope"
    // if every control underneath it is marked Not Applicable (in Provider Responsibility
    // or Implementation Status). Applied across BOTH kinds.
    const guidelineCounts = Object.create(null); // guideline -> { total, oos }
    state.parsed.sspaRows.forEach(r => {
      const g = (r['Guideline'] || '').trim();
      if (!g) return;
      const prov   = String(r['Provider Responsibility'] || r['Assessment Responsibility'] || '').trim().toLowerCase();
      const status = String(r['Implementation Status']   || '').trim().toLowerCase();
      const oos = (prov === 'not applicable' || status === 'not applicable');
      if (!guidelineCounts[g]) guidelineCounts[g] = { total: 0, oos: 0 };
      guidelineCounts[g].total++;
      if (oos) guidelineCounts[g].oos++;
    });
    const fullyOosGuidelines = new Set(
      Object.entries(guidelineCounts)
        .filter(([g, c]: [string, any]) => c.total > 0 && c.total === c.oos)
        .map(([g]) => g)
    );
    state.parsed.fullyOosGuidelines = [...fullyOosGuidelines];

    state.triage = Object.create(null);
    // In CCM-vs-CCM mode the "baseline" is another CCM, so there's no SSP-A
    // scoping to copy from. Seed empty triage records and skip the pre-fill
    // rule chain entirely — the reviewer still decides in/out of scope and
    // triage manually, but we don't pretend we can guess from a non-existent
    // scoping column.
    state.delta.forEach(d => {
      const scoping = d.scoping || {};
      const isInBaseline = d.changeType !== 'New'
        && !String(scoping.prov || '').startsWith('(not yet');
      const guidelineOos = fullyOosGuidelines.has((d.guideline || '').trim());
      const classMismatch = d.classCoverage && d.classCoverage.covered === false;
      let inScope = '';
      let prefillSource = '';
      // Pre-fill In scope (priority order):
      //   Rule A (classification): if the system's Information Classification is
      //     NOT listed in the control's Applicability, pre-fill No. Strongest
      //     signal — overrides baseline-in-scope because a control that simply
      //     doesn't apply to this classification is definitively out of scope.
      //   Rule B (guideline-level): if the whole Guideline is Not Applicable in
      //     the baseline, pre-fill No for new/updated controls under it.
      //   Rule C (row-level): for existing controls, copy the baseline file's
      //     scoping — Not Applicable → No; anything else → Yes.
      //   Rule D: brand-new controls with none of the above → leave blank.
      let classJustification = '';
      if (classMismatch) {
        inScope = 'No';
        prefillSource = 'classification';
        const lvl = state.product.classification || 'the assessed classification';
        classJustification = `This control is not applicable to the system classified as ${lvl}.`;
      } else if (guidelineOos) {
        inScope = 'No';
        prefillSource = 'guideline';
      } else if (isInBaseline) {
        const prov   = String(scoping.prov   || '').trim().toLowerCase();
        const status = String(scoping.status || '').trim().toLowerCase();
        if (prov === 'not applicable' || status === 'not applicable') { inScope = 'No'; prefillSource = 'row'; }
        else { inScope = 'Yes'; prefillSource = 'row'; }
      }
      // Pre-fill Triage = No Action when pre-fill says out of scope.
      // Rescinded controls are left for reviewer (they may need SSP-A cleanup).
      let triage = '';
      if (inScope === 'No' && d.changeType !== 'Rescinded') {
        triage = 'No Action';
      }

      // Snapshot the pre-filled values so they remain available for audit
      // if the reviewer later changes inScope or triage.
      state.triage[d.id] = {
        inScope, triage, rationale: classJustification,
        prefillInScope: inScope, prefillTriage: triage, prefillSource,
      };
    });

    // Cross-validate
    state.validation = crossValidate(state.delta, state.parsed.changesText);
    state.possiblePairs = findPossibleRescissionPairs(state.delta);

    renderDashboard();
    $('step-dashboard').classList.remove('hidden');
    $('step-dashboard').scrollIntoView({ behavior: 'smooth', block: 'start' });

  } catch (err) {
    console.error(err);
    errEl.textContent = 'Error: ' + err.message;
    errEl.style.display = 'block';
  } finally {
    $('btn-compute').disabled = false;
    $('btn-compute').innerHTML = 'Update →';
    checkReady();
  }
});

// ---- Dashboard rendering ---------------------------------------------------
function renderDashboard() {
  renderMeta();
  renderCards();
  renderThemes();
  renderTable();
}

function renderMeta() {
  const p = state.product;
  const pq = state.parsed;
  const parts = [];
  if (p.organisation) parts.push(`<span>Organisation: <b>${escapeHtml(p.organisation)}</b></span>`);
  if (p.name) parts.push(`<span>Product: <b>${escapeHtml(p.name)}</b></span>`);
  if (p.classification) parts.push(`<span>Information Classification: <b>${escapeHtml(p.classification)}</b></span>`);
  parts.push(`<span>Target quarter: <b>${quarterLong(pq.targetQuarter)}</b></span>`);
  parts.push(`<span>Baseline: <b>${quarterLong(pq.baselineQuarter)}</b></span>`);
  parts.push(`<span>Review date: <b>${new Date().toLocaleDateString('en-AU', { day: '2-digit', month: 'short', year: 'numeric' })}</b></span>`);
  $('meta-bar').innerHTML = parts.join('');
}

// Compute per-kind change counts for the stats cards and exports.
function counts() {
  const empty = () => ({ total: 0, byChange: { New: 0, Updated: 0, Rescinded: 0 } });
  const byKind = { control: empty(), principle: empty() };
  const overall = empty();
  state.delta.forEach(d => {
    const bucket = byKind[d.kind];
    if (!bucket) return;
    bucket.total++;
    bucket.byChange[d.changeType]++;
    overall.total++;
    overall.byChange[d.changeType]++;
  });
  return { overall, byKind };
}

// Render stats cards grouped by kind so "27 Controls / 49 Principles / 27 New
// / 45 Updated / 4 Rescinded / 18 No Action" stops being ambiguous about
// which number belongs to which kind. Each kind gets its own block with its
// own change-type and triage cards; an empty kind (e.g. no principles this
// quarter) is rendered greyed-out with an explanatory note instead of a wall
// of zeros.
function renderCards() {
  const c = counts();
  const kindBlock = (label, k) => {
    const b = c.byKind[k];
    if (!b.total) {
      return `
        <div class="stats-group empty">
          <h3>${label} <span class="total"><span class="u">(no changes this quarter)</span></span></h3>
        </div>`;
    }
    return `
      <div class="stats-group">
        <h3>${label} <span class="total"><span class="n">${b.total}</span><span class="u">total</span></span></h3>
        <div class="cards">
          <div class="card accent-new"><div class="value">${b.byChange.New}</div><div class="label">New</div></div>
          <div class="card accent-modified"><div class="value">${b.byChange.Updated}</div><div class="label">Updated</div></div>
          <div class="card accent-rescinded"><div class="value">${b.byChange.Rescinded}</div><div class="label">Rescinded</div></div>
        </div>
      </div>`;
  };
  // Only render a kind block if the CCM actually contains that sheet.
  const hasCcmControls   = (state.parsed.byKind.control.ccmRows   || []).length > 0;
  const hasCcmPrinciples = (state.parsed.byKind.principle.ccmRows || []).length > 0;
  $('summary-cards-wrap').innerHTML =
    (hasCcmControls   ? kindBlock('Controls',   'control')   : '') +
    (hasCcmPrinciples ? kindBlock('Principles', 'principle') : '');
}

function renderThemes() {
  const v = state.validation;
  let html = '<ul>';
  // NOTE: we deliberately don't report "N control(s) in the CCM delta are not
  // named in the Changes PDF" — the PDF is a narrative summary by function/
  // topic, not an exhaustive per-ID list, so any "mismatch" there is semantic,
  // not a real gap. Same for "IDs in PDF but not in delta": typically these
  // are cross-references (e.g. "affects [GOV-02, GOV-04]") and don't indicate
  // a missed change. We still use the PDF for rescission-reason extraction;
  // we just don't surface these noisy counts in the UI.
  if (state.metadataOnlyQuarter) {
    html += '<li class="validation-note ok">No reviewer-action changes this quarter — the CCM and your baseline file are substantively identical. You can still export an Updated SSP-A or CCM to refresh metadata fields (Revision, Updated date, etc.) silently.</li>';
  }
  if (!v) {
    html += '<li class="validation-note">No changes PDF uploaded — rescission reasons will not be extracted.</li>';
  }
  // Applicability drift — SSP-A's classification applicability vs current CCM's.
  // Only controls where both sides list applicability are compared. The text
  // here is intentionally soft — drift is a HINT that the SSP-A may be stale
  // on a field the delta wouldn't otherwise surface, not proof of an error.
  const drift = state.drift;
  if (drift) {
    // Schema migrations (e.g. "All" → "NC") — informational, not action items.
    if (drift.migrationCount > 0) {
      html += `<li class="validation-note ok">Column rename (schema migration): ${drift.migrationCount} control(s) had their classification column updated from "All" to "NC" to match the current CCM. The Updated baseline file renames that column header and highlights it in amber.</li>`;
    }
    // Genuine applicability drift — ASD actually changed which classifications a control applies to.
    if (drift.count === 0) {
      html += `<li class="validation-note ok">Applicability: no genuine classification-scope changes detected.</li>`;
    } else {
      const preview = drift.items.slice(0, 6)
        .map(it => `<li><code>${escapeHtml(it.id)}</code>: baseline <em>${escapeHtml(it.sspa)}</em> → CCM <em>${escapeHtml(it.ccm)}</em></li>`)
        .join('');
      const more = drift.count > 6 ? ` <span class="hint">(${drift.count - 6} more not shown)</span>` : '';
      html += `<li class="validation-note warn">Applicability changes: ASD changed the classification scope of ${drift.count} control(s) in this CCM. These appear as Updated rows in the delta where detected. This panel highlights additional classification-scope drift and schema migrations that may require review.${more}<ul class="drift-list">${preview}</ul></li>`;
    }
  }
  // Top Guidelines (Controls only — Principles don't carry a Guideline field)
  // and, separately, Top Functions for Principles (keyed off their ID prefix,
  // same grouping the dashboard uses). Splitting these keeps the two
  // taxonomies from bleeding into each other and avoids an "undefined" bucket.
  const byGuideline = Object.create(null);
  const byFunction  = Object.create(null);
  state.delta.forEach(d => {
    if (d.kind === 'principle') {
      const fn = d.functionName || functionFromId(d.id) || '(uncategorised)';
      byFunction[fn] = (byFunction[fn] || 0) + 1;
    } else {
      const g = String(d.guideline || '').trim() || '(no guideline)';
      byGuideline[g] = (byGuideline[g] || 0) + 1;
    }
  });
  const fmtTop = (obj) => Object.entries(obj)
    .sort((a, b) => (b[1] as number) - (a[1] as number))
    .slice(0, 5)
    .map(([k, n]) => `${escapeHtml(k)} (${n})`)
    .join(' · ');
  const topG = fmtTop(byGuideline);
  const topF = fmtTop(byFunction);
  if (topG) html += `<li>Top guidelines by change volume (Controls): ${topG}</li>`;
  if (topF) html += `<li>Top functions by change volume (Principles): ${topF}</li>`;

  // Possible rescission + re-issue pairs. This is a soft hint only — we score
  // Jaccard overlap on topic + text between each Rescinded item and every New
  // item of the same kind, surface pairs above a conservative threshold, and
  // leave the reviewer to confirm or dismiss. The tool deliberately does NOT
  // auto-link these in the register; mis-pairing is worse than missing.
  const pairs = state.possiblePairs;
  if (pairs && pairs.count > 0) {
    const preview = pairs.items.slice(0, 5).map(p =>
      `<li><code>${escapeHtml(p.rescindedId)}</code> (rescinded) ↔ <code>${escapeHtml(p.newId)}</code> (new) ` +
      `<span class="hint">— similarity ${(p.score * 100).toFixed(0)}%, ${p.overlap} shared term(s)</span></li>`
    ).join('');
    const more = pairs.count > 5 ? ` <span class="hint">(${pairs.count - 5} more not shown)</span>` : '';
    html += `<li class="validation-note warn">Possible rescission + re-issue pair(s) detected: ${pairs.count}. These are heuristic suggestions only — confirm or dismiss by eye.${more}<ul class="pair-list">${preview}</ul></li>`;
  } else if (state.delta && state.delta.some(d => d.changeType === 'Rescinded') &&
             state.delta.some(d => d.changeType === 'New')) {
    html += `<li class="validation-note ok">No likely rescission + re-issue pairs detected in this delta.</li>`;
  }

  html += '</ul>';
  $('themes-content').innerHTML = html;
}

function filtered() {
  const f = state.filters;
  const s = (f.search || '').trim().toLowerCase();
  return state.delta.filter(d => {
    if (f.kind && d.kind !== f.kind) return false;
    if (f.change && d.changeType !== f.change) return false;
    if (s) {
      const hay = `${d.id} ${d.guideline} ${d.section} ${d.topic} ${d.oldText} ${d.newText}`.toLowerCase();
      if (!hay.includes(s)) return false;
    }
    return true;
  });
}

// Determine the order in which Guidelines appear for a given kind. Uses that
// kind's per-sheet rows so Controls and Principles each get ASD's native
// ordering rather than a merged/shuffled one.
// Map an ISM principle identifier (GOV-01, IDE-05, PRO-17, …) to its parent
// Function. Returns null for controls or unknown prefixes — the caller can
// then fall back to the usual Guideline column.
function guidelineOrderFromSources(kind) {
  const order = [];
  const seen = new Set();
  const bundle = (kind && state.parsed.byKind && state.parsed.byKind[kind]) || null;
  const ccm  = bundle ? bundle.ccmRows  : (state.parsed.ccmRows  || []);
  const sspa = bundle ? bundle.sspaRows : (state.parsed.sspaRows || []);
  ccm.forEach(r => {
    const g = String(r['Guideline'] || '').trim();
    if (g && !seen.has(g)) { seen.add(g); order.push(g); }
  });
  sspa.forEach(r => {
    const g = String(r['Guideline'] || '').trim();
    if (g && !seen.has(g)) { seen.add(g); order.push(g); }
  });
  return order;
}

function summariseGuidelineGroup(deltas) {
  const s = { total: deltas.length, New: 0, Updated: 0, Rescinded: 0, unset: 0 };
  deltas.forEach(d => {
    s[d.changeType] = (s[d.changeType] || 0) + 1;
    if (!state.triage[d.id] || !state.triage[d.id].triage) s.unset++;
  });
  return s;
}

function guidelineHeaderHtml(guideline, summary, collapsed, kind) {
  const chips = [
    summary.New      ? `<span class="chip new">${summary.New} New</span>`            : '',
    summary.Updated  ? `<span class="chip updated">${summary.Updated} Updated</span>`   : '',
    summary.Rescinded? `<span class="chip rescinded">${summary.Rescinded} Rescinded</span>` : '',
    summary.unset    ? `<span class="chip triage-unset">${summary.unset} unset</span>` : '',
  ].filter(Boolean).join(' ');
  const caret = collapsed ? '▸' : '▾';
  // Guideline names can in theory collide between Controls and Principles
  // sheets, so the header key is scoped by kind in the dataset.
  const dataKey = `${kind}::${guideline}`;
  return `<tr class="guideline-header${collapsed ? ' collapsed' : ''}" data-key="${escapeHtml(dataKey)}">
      <td colspan="8">
        <span class="guideline-toggle">${caret}</span>
        <span class="guideline-name">${escapeHtml(guideline)}</span>
        <span class="guideline-count">${summary.total} change${summary.total === 1 ? '' : 's'}</span>
        <span class="guideline-chips">${chips}</span>
      </td>
    </tr>`;
}

function kindSectionHeaderHtml(kind, total) {
  const label = kind === 'control' ? 'Controls' : 'Principles';
  return `<tr class="kind-header"><td colspan="8">
      <span class="kind-label">${label}</span>
      <span class="kind-count">${total} change${total === 1 ? '' : 's'}</span>
    </td></tr>`;
}

// Slim column sub-header repeated inside each guideline/function group so
// reviewers don't need to scroll back to the top to identify columns.
function colSubHeaderHtml(kind) {
  const isControl = kind === 'control';
  return `<tr class="col-subheader">
    <th class="col-id">ID</th>
    <th class="col-change">Change</th>
    <th class="col-guideline">${isControl ? 'Guideline' : 'Function'}</th>
    <th class="col-topic">Topic</th>
    <th class="col-appl">Applicability</th>
    <th class="col-text">Old vs. new ISM requirement</th>
    <th class="col-scoping">Baseline implementation status</th>
    <th class="col-inscope">Applicable</th>
  </tr>`;
}

function renderTable() {
  const rows = filtered();
  const tbody = $('register-body');
  $('register-empty').classList.toggle('hidden', rows.length > 0);

  // Group by kind first, then by Guideline. Always render Controls before
  // Principles so the dashboard matches the order in the Change Register xlsx.
  const byKind = { control: [], principle: [] };
  rows.forEach(d => {
    const k = (d.kind === 'principle') ? 'principle' : 'control';
    byKind[k].push(d);
  });

  // For Controls we group by Guideline (the ISM's mid-level chapter name).
  // For Principles we group by Function (GOVERN / IDENTIFY / PROTECT / DETECT
  // / RESPOND / RECOVER), which is what the ASD model actually organises them
  // under; the ID prefix gives us the function without needing a lookup table.
  const groupKeyFor = (d) => {
    if (d.kind === 'principle') {
      return d.functionName || functionFromId(d.id) || '(uncategorised)';
    }
    return String(d.guideline || '').trim() || '(no guideline)';
  };

  const parts = [];
  ['control', 'principle'].forEach(kind => {
    const kindRows = byKind[kind];
    if (!kindRows.length) return;
    parts.push(kindSectionHeaderHtml(kind, kindRows.length));

    const byGroup = Object.create(null);
    kindRows.forEach(d => {
      const g = groupKeyFor(d);
      if (!byGroup[g]) byGroup[g] = [];
      byGroup[g].push(d);
    });

    let order;
    if (kind === 'principle') {
      // Preserve the canonical function order; surface anything uncategorised at the end.
      order = FUNCTION_ORDER.filter(f => byGroup[f]);
      if (byGroup['(uncategorised)']) order.push('(uncategorised)');
    } else {
      order = guidelineOrderFromSources(kind).filter(g => byGroup[g]);
      if (byGroup['(no guideline)']) order.push('(no guideline)');
    }

    order.forEach(g => {
      const deltas = byGroup[g];
      const summary = summariseGuidelineGroup(deltas);
      const key = `${kind}::${g}`;
      const collapsed = state.collapsedGuidelines.has(key);
      parts.push(guidelineHeaderHtml(g, summary, collapsed, kind));
      if (!collapsed) {
        parts.push(colSubHeaderHtml(kind));
        deltas.forEach(d => parts.push(rowHtml(d)));
      }
    });
  });
  tbody.innerHTML = parts.join('');

  // Guideline header click → toggle collapse (scoped by kind::guideline key)
  tbody.querySelectorAll('tr.guideline-header').forEach(tr => {
    tr.addEventListener('click', () => {
      const key = tr.dataset.key;
      if (state.collapsedGuidelines.has(key)) state.collapsedGuidelines.delete(key);
      else state.collapsedGuidelines.add(key);
      renderTable();
    });
  });
}

function rowHtml(d) {
  const t = state.triage[d.id];
  const changeClass = d.changeType.toLowerCase();

  const oldHtml = d.changeType === 'New' ? `<em class="label-inline">New control</em>` :
    `<span class="label-inline">Old (${quarterLong(state.parsed.baselineQuarter)})</span><span class="diff-old">${escapeHtml(d.oldText)}</span>`;
  // For Rescinded rows, show the ASD explanation (extracted from the Changes
  // PDF) alongside the "Rescinded — see old text above" marker. Reviewers
  // need this to judge whether downstream SSP-A references must move to the
  // superseding control. If no PDF was uploaded (or the ID wasn't found in
  // the PDF text), quietly fall back to the original marker.
  const newHtml = d.changeType === 'Rescinded'
    ? (d.rescissionReason
        ? `<em class="label-inline">Rescinded — see old text above</em>
           <span class="label-inline" style="margin-top:6px;">Rescission reason (from ISM Changes PDF)</span>
           <span class="diff-rescinded">${escapeHtml(d.rescissionReason)}</span>`
        : `<em class="label-inline">Rescinded — see old text above</em>`)
    : `<span class="label-inline">New (${quarterLong(state.parsed.targetQuarter)})</span><span class="diff-new">${escapeHtml(d.newText)}</span>`;

  // Changed fields summary + optional inline word diff for Updated controls
  let diffHtml = '';
  if (d.changeType === 'Updated') {
    const changedFields = changedFieldsLabel(d.subFlags);
    const changedFieldsHtml = changedFields
      ? `<span class="label-inline">Changed fields</span>
         <span class="diff-inline">${escapeHtml(changedFields)}</span>`
      : '';
    const wordDiffPart = d.subFlags?.textChanged
      ? `<span class="label-inline" style="margin-top:4px;">Description changes (inline)</span>
         <span class="diff-inline">${wordDiffHtml(d.oldText, d.newText)}</span>`
      : '';
    diffHtml = changedFieldsHtml + wordDiffPart;
  }

  return `
    <tr data-id="${escapeHtml(d.id)}">
      <td class="col-id">${escapeHtml(d.id)}${d.revision != null && d.revision !== '' ? `<br><small style="color:var(--text-muted);font-weight:normal;">Rev ${escapeHtml(String(d.revision))}</small>` : ''}</td>
      <td class="col-change"><span class="chip ${changeClass}">${d.changeType}</span></td>
      <td class="col-guideline">${escapeHtml(d.guideline || '')}<br><small>${escapeHtml(d.section || '')}</small></td>
      <td class="col-topic">${escapeHtml(d.topic || '')}</td>
      <td class="col-appl">${(() => {
        const mlPart = d.mlLevels !== '-' ? `<br><small>${escapeHtml(d.mlLevels)}</small>` : '';
        if (d.changeType === 'Updated' && d.subFlags) {
          if (d.subFlags.applChanged) {
            return `<span class="label-inline">Old</span><span class="diff-old" style="font-size:11px;">${escapeHtml(d.oldApplicability || '—')}</span>`
                 + `<span class="label-inline" style="margin-top:3px;">New</span><span class="diff-new" style="font-size:11px;">${escapeHtml(d.applicability)}</span>${mlPart}`;
          }
          return `${escapeHtml(d.applicability)}<br><small style="color:var(--text-muted);">no change</small>${mlPart}`;
        }
        return `${escapeHtml(d.applicability)}${mlPart}`;
      })()}</td>
      <td class="col-text">
        ${d.changeType === 'New' ? '' : oldHtml}
        ${newHtml}
        ${diffHtml}
      </td>
      <td class="col-scoping">${(() => {
        const prov = d.scoping.prov || '';
        const stat = d.scoping.status || '';
        // New controls have no baseline scoping — show a single dash rather than
        // two identical placeholder strings.
        if (prov === stat && (prov === '' || prov === '(new this quarter)' || prov === '—')) {
          return `<span style="color:var(--text-muted)">—</span>`;
        }
        return `<div class="scoping-prov">${escapeHtml(prov)}</div>${stat && stat !== prov ? `<div class="scoping-stat">${escapeHtml(stat)}</div>` : ''}`;
      })()}</td>
      <td class="col-inscope">${t.inScope ? `<span class="chip ${t.inScope === 'Yes' ? 'chip-yes' : 'chip-no'}">${t.inScope}</span>` : '<span style="color:var(--text-muted)">—</span>'}</td>
    </tr>
  `;
}

