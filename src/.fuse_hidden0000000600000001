// ---- Rendering helpers (Tab 3-specific, no triage column) ------------------

function summariseGuidelineGroupCmp(deltas) {
  const s = { total: deltas.length, New: 0, Updated: 0, Rescinded: 0 };
  deltas.forEach(d => { s[d.changeType] = (s[d.changeType] || 0) + 1; });
  return s;
}

function guidelineHeaderHtmlCmp(guideline, summary, kind, collapsed) {
  const chips = [
    summary.New       ? `<span class="chip new">${summary.New} New</span>`               : '',
    summary.Updated   ? `<span class="chip updated">${summary.Updated} Updated</span>`   : '',
    summary.Rescinded ? `<span class="chip rescinded">${summary.Rescinded} Rescinded</span>` : '',
  ].filter(Boolean).join(' ');
  const caret = collapsed ? '▸' : '▾';
  return `<tr class="guideline-header${collapsed ? ' collapsed' : ''}" data-key="${escapeHtml(kind + '::' + guideline)}">
      <td colspan="6">
        <span class="guideline-toggle">${caret}</span>
        <span class="guideline-name">${escapeHtml(guideline)}</span>
        <span class="guideline-count">${summary.total} change${summary.total === 1 ? '' : 's'}</span>
        <span class="guideline-chips">${chips}</span>
      </td>
    </tr>`;
}

function kindSectionHeaderHtmlCmp(kind, total) {
  const label = kind === 'control' ? 'Controls' : 'Principles';
  return `<tr class="kind-header"><td colspan="6">
      <span class="kind-label">${label}</span>
      <span class="kind-count">${total} change${total === 1 ? '' : 's'}</span>
    </td></tr>`;
}

function colSubHeaderHtmlCmp(kind) {
  const isControl = kind === 'control';
  return `<tr class="col-subheader">
    <th class="col-id">ID</th>
    <th class="col-change">Change</th>
    <th class="col-guideline">${isControl ? 'Guideline' : 'Function'}</th>
    <th class="col-topic">Topic</th>
    <th class="col-appl">Applicability</th>
    <th class="col-text">Old vs. new ISM requirement</th>
  </tr>`;
}

// Derive guideline order directly from delta rows (Tab 3 has no state.parsed).
function guidelineOrderFromDelta(delta, kind) {
  const order = [];
  const seen = new Set();
  delta.forEach(d => {
    if (d.kind !== kind) return;
    const g = String(d.guideline || '').trim() || '(no guideline)';
    if (!seen.has(g)) { seen.add(g); order.push(g); }
  });
  return order;
}

function rowHtmlCmp(d) {
  const changeClass = d.changeType.toLowerCase();

  const oldHtml = d.changeType === 'New'
    ? `<em class="label-inline">New control</em>`
    : `<span class="label-inline">Old (${escapeHtml(state3.baselineLabel)})</span><span class="diff-old">${escapeHtml(d.oldText)}</span>`;

  const newHtml = d.changeType === 'Rescinded'
    ? `<em class="label-inline">Rescinded — see old text above</em>`
    : `<span class="label-inline">New (${escapeHtml(state3.currentLabel)})</span><span class="diff-new">${escapeHtml(d.newText)}</span>`;

  let diffHtml = '';
  if (d.changeType === 'Updated') {
    const changedFields = changedFieldsLabel(d.subFlags);
    const cfHtml = changedFields
      ? `<span class="label-inline">Changed fields</span><span class="diff-inline">${escapeHtml(changedFields)}</span>`
      : '';
    const wdHtml = d.subFlags && d.subFlags.textChanged
      ? `<span class="label-inline" style="margin-top:4px;">Description changes (inline)</span><span class="diff-inline">${wordDiffHtml(d.oldText, d.newText)}</span>`
      : '';
    diffHtml = cfHtml + wdHtml;
  }

  const applCell = (() => {
    const mlPart = d.mlLevels !== '-' ? `<br><small>${escapeHtml(d.mlLevels)}</small>` : '';
    if (d.changeType === 'Updated' && d.subFlags) {
      if (d.subFlags.applChanged) {
        return `<span class="label-inline">Old</span><span class="diff-old" style="font-size:11px;">${escapeHtml(d.oldApplicability || '—')}</span>`
             + `<span class="label-inline" style="margin-top:3px;">New</span><span class="diff-new" style="font-size:11px;">${escapeHtml(d.applicability)}</span>${mlPart}`;
      }
      return `${escapeHtml(d.applicability)}<br><small style="color:var(--text-muted);">no change</small>${mlPart}`;
    }
    return `${escapeHtml(d.applicability)}${mlPart}`;
  })();

  return `
    <tr data-id="${escapeHtml(d.id)}">
      <td class="col-id">${escapeHtml(d.id)}${d.revision != null && d.revision !== '' ? `<br><small style="color:var(--text-muted);font-weight:normal;">Rev ${escapeHtml(String(d.revision))}</small>` : ''}</td>
      <td class="col-change"><span class="chip ${changeClass}">${d.changeType}</span></td>
      <td class="col-guideline">${escapeHtml(d.guideline || '')}<br><small>${escapeHtml(d.section || '')}</small></td>
      <td class="col-topic">${escapeHtml(d.topic || '')}</td>
      <td class="col-appl">${applCell}</td>
      <td class="col-text">
        ${d.changeType === 'New' ? '' : oldHtml}
        ${newHtml}
        ${diffHtml}
      </td>
    </tr>
  `;
}

// ---- Table render ----------------------------------------------------------
function renderCmpTable() {
  const rows  = cmpFiltered();
  const tbody = $('cmp-register-body');
  $('cmp-register-empty').classList.toggle('hidden', rows.length > 0);

  const byKind = { control: [], principle: [] };
  rows.forEach(d => { byKind[d.kind === 'principle' ? 'principle' : 'control'].push(d); });

  const groupKeyFor = d =>
    d.kind === 'principle'
      ? (functionFromId(d.id) || '(uncategorised)')
      : (String(d.guideline || '').trim() || '(no guideline)');

  const parts = [];
  ['control', 'principle'].forEach(kind => {
    const kindRows = byKind[kind];
    if (!kindRows.length) return;
    parts.push(kindSectionHeaderHtmlCmp(kind, kindRows.length));

    const byGroup = Object.create(null);
    kindRows.forEach(d => {
      const g = groupKeyFor(d);
      if (!byGroup[g]) byGroup[g] = [];
      byGroup[g].push(d);
    });

    let order;
    if (kind === 'principle') {
      order = FUNCTION_ORDER.filter(f => byGroup[f]);
      if (byGroup['(uncategorised)']) order.push('(uncategorised)');
    } else {
      // Derive order from document order in the full (unfiltered) delta.
      order = guidelineOrderFromDelta(state3.delta, kind).filter(g => byGroup[g]);
      if (byGroup['(no guideline)']) order.push('(no guideline)');
    }

    order.forEach(g => {
      const deltas   = byGroup[g];
      const summary  = summariseGuidelineGroupCmp(deltas);
      const key      = `${kind}::${g}`;
      const collapsed = state3.collapsedGuidelines.has(key);
      parts.push(guidelineHeaderHtmlCmp(g, summary, kind, collapsed));
      if (!collapsed) {
        parts.push(colSubHeaderHtmlCmp(kind));
        deltas.forEach(d => parts.push(rowHtmlCmp(d)));
      }
    });
  });

  tbody.innerHTML = parts.join('');

  // Guideline header click → toggle collapse
  tbody.querySelectorAll('tr.guideline-header').forEach(tr => {
    tr.addEventListener('click', () => {
      const key = tr.dataset.key;
      if (state3.collapsedGuidelines.has(key)) state3.collapsedGuidelines.delete(key);
      else state3.collapsedGuidelines.add(key);
      renderCmpTable();
    });
  });
}

