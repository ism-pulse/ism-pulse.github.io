function parseXLSX(file): Promise<any> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        resolve(readWorkbookSafe(e.target.result as ArrayBuffer));
      } catch (err) { reject(err); }
    };
    reader.onerror = () => reject(new Error('File read error'));
    reader.readAsArrayBuffer(file);
  });
}

// Parse an XLSX from an ArrayBuffer (used for bundled server-side CCM).
function parseXLSXFromBuffer(buf) {
  return readWorkbookSafe(buf);
}

// ---- Sheet discovery helpers -----------------------------------------------
// These use XLSX global and canonicaliseHeader — kept in main.ts alongside
// the other XLSX-dependent parse functions.

function validateReviewSheet(workbook, sheetName, kind?) {
  const sheet = workbook.Sheets[sheetName];
  if (!sheet) return null;
  const aoa = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: null });
  for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
    const row = (aoa[i] || []).map(c => canonicaliseHeader(c));
    if (!row.includes('Identifier')) continue;
    if (kind === 'control'   && row.includes('Description') && (row.includes('Guideline') || row.includes('Section') || row.includes('Function'))) return row;
    if (kind === 'principle' && row.includes('Description') && row.includes('Function')) return row;
    if (!kind) return row;
  }
  return null;
}

function findReviewSheets(workbook) {
  const result = { control: null, principle: null };

  const quarterRe = /^(Controls|Principles)\s*[-–]\s*\w/i;
  workbook.SheetNames.forEach(n => {
    const trimmed = n.trim();
    const isQuarterName    = quarterRe.test(trimmed);
    const isControlName    = /^Controls\b/i.test(trimmed);
    const isPrincipleName  = /^Principles\b/i.test(trimmed);

    if (isControlName   && !result.control)   { if (validateReviewSheet(workbook, n, 'control'))   result.control   = n; }
    if (isPrincipleName && !result.principle) { if (validateReviewSheet(workbook, n, 'principle')) result.principle = n; }

    if (isControlName   && result.control   && result.control   !== n && isQuarterName) { if (validateReviewSheet(workbook, n, 'control'))   result.control   = n; }
    if (isPrincipleName && result.principle && result.principle !== n && isQuarterName) { if (validateReviewSheet(workbook, n, 'principle')) result.principle = n; }
  });

  if (result.control   && !validateReviewSheet(workbook, result.control,   'control'))   result.control   = null;
  if (result.principle && !validateReviewSheet(workbook, result.principle, 'principle')) result.principle = null;

  if (result.control && result.principle) return result;

  const skipRe = /^(info|information|pivot|readme|cover|contents?|summary|changelog|notes?|overview|scoping|data|sheet\d*)\b/i;
  workbook.SheetNames.forEach(n => {
    if (skipRe.test(n.trim())) return;
    if (n === result.control || n === result.principle) return;
    const sheet = workbook.Sheets[n];
    if (!sheet) return;
    const aoa = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: null });
    let headers = [];
    for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
      const row = (aoa[i] || []).map(c => canonicaliseHeader(c));
      if (row.includes('Identifier')) { headers = row; break; }
    }
    if (!headers.length) return;
    const hasDesc      = headers.includes('Description');
    const hasGuideline = headers.includes('Guideline') || headers.includes('Section');
    const hasFunction  = headers.includes('Function');
    if (!result.control   && hasDesc && hasGuideline) result.control   = n;
    if (!result.principle && hasDesc && hasFunction)  result.principle = n;
  });

  return result;
}

