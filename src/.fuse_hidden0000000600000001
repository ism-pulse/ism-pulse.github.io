// ---- Bundled template fetch ------------------------------------------------
async function fetchBundledSSPATemplate() {
  const st = $('sspa-template-status');

  // Clear any previously loaded workbook so a failed bundled fetch cannot leave an older uploaded template active
  sspaState.workbook = null;
  $('sspa-steps').classList.add('hidden');
  $('sspa-na-count').classList.add('hidden');
  $('sspa-file-info')?.classList.add('hidden');

  st.textContent = 'Loading bundled template…'; st.style.color = '';
  try {
    const buf = await fetchArrayBufferCapped(SSPA_TEMPLATE_URL);

    // Verify integrity before parsing — do not hand untrusted bytes to the parser.
    // Fail closed: if crypto.subtle is unavailable block rather than skip the check.
    const sspaHash = await sha256hex(buf);
    if (sspaHash === null) {
      st.textContent = 'Cannot verify SSP-A template integrity — crypto.subtle unavailable. Serve the tool over HTTPS or localhost.';
      st.style.color = '#c0392b';
      $('sspa-src-bundled').checked = false;
      $('sspa-src-bundled-card').classList.remove('selected');
      return;
    }
    if (BUNDLED_FILE_HASHES['sspa-template-current.xlsx'] && sspaHash !== BUNDLED_FILE_HASHES['sspa-template-current.xlsx']) {
      showFileVersionPanel('sspa-file-info', 'fv-rows-tab1', [
        fvRow('sspa-template-current.xlsx', '', buf.byteLength, sspaHash, BUNDLED_FILE_HASHES['sspa-template-current.xlsx']),
      ]);
      st.textContent = 'Bundled SSP-A template failed integrity check — hash mismatch. The file may have been updated. Please contact Cybernion or upload your own template.';
      st.style.color = '#c0392b';
      $('sspa-src-bundled').checked = false;
      $('sspa-src-bundled-card').classList.remove('selected');
      return;
    }

    sspaState.workbook = readWorkbookSafe(buf);
    sspaState.buffer   = buf;
    // Try to surface the quarter from the sheet names so the user can confirm they have the right template.
    const sspaQShort = (sspaState.workbook.SheetNames || []).reduce((found, n) => found || quarterFromSheetName(n), '');
    const sspaQLabel = sspaQShort ? quarterLong(sspaQShort) : '';
    st.textContent = sspaQLabel ? `Bundled SSP-A template loaded - ${sspaQLabel} ✓` : 'Bundled SSP-A template loaded ✓';
    st.style.color = '#128a5a';

    showFileVersionPanel('sspa-file-info', 'fv-rows-tab1', [
      fvRow('sspa-template-current.xlsx', sspaQLabel, buf.byteLength, sspaHash, BUNDLED_FILE_HASHES['sspa-template-current.xlsx']),
    ]);

    onSSPATemplateLoaded();
  } catch (err) {
    st.textContent = `Could not load bundled template (${err.message || err}). Please upload your own.`;
    st.style.color = '#c0392b';
    // Deselect bundled option to signal failure
    $('sspa-src-bundled').checked = false;
    $('sspa-src-bundled-card').classList.remove('selected');
    console.warn('[IRAP Pulse] SSP-A template fetch failed:', err);
  }
}

// ---- File upload handler ---------------------------------------------------
(function wireSSPAUpload() {
  const input = $('sspa-file-upload');
  const zone  = $('sspa-drop-zone');
  if (!input || !zone) return;

  input.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    readSSPAFile(file);
  });

  zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone.addEventListener('dragleave', ()  => zone.classList.remove('drag-over'));
  zone.addEventListener('drop', (e) => {
    e.preventDefault(); zone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) readSSPAFile(file);
  });
})();

async function readSSPAFile(file) {
  const st = $('sspa-template-status');

  // Clear any previously loaded workbook so stale state cannot leak through on failed replacement uploads
  sspaState.workbook = null;
  $('sspa-steps').classList.add('hidden');
  $('sspa-na-count').classList.add('hidden');
  $('sspa-file-info')?.classList.add('hidden');

  // Size check (reuses Tab 2's MAX_XLSX_BYTES constant)
  if (file.size > MAX_XLSX_BYTES) {
    st.textContent = `File too large (${(file.size / 1048576).toFixed(1)} MB) — maximum is ${MAX_XLSX_MB} MB.`;
    st.style.color = '#c0392b'; return;
  }
  // Extension check
  if (!/\.xlsx$/i.test(file.name)) {
    st.textContent = 'Please upload a plain Excel workbook (.xlsx). Other formats are not supported.';
    st.style.color = '#c0392b'; return;
  }

  try {
    // ZIP magic-byte check — xlsx files are ZIP containers beginning with PK\x03\x04
    const head = new Uint8Array(await file.slice(0, 4).arrayBuffer());
    const isZip = head[0] === 0x50 && head[1] === 0x4B && (head[2] === 0x03 || head[2] === 0x05 || head[2] === 0x07);
    if (!isZip) {
      st.textContent = `"${file.name}" does not look like a valid Excel workbook — check the file and try again.`;
      st.style.color = '#c0392b'; return;
    }

    st.textContent = 'Reading…'; st.style.color = '';
    const buf = await file.arrayBuffer();
    sspaState.workbook = readWorkbookSafe(buf);
    sspaState.buffer   = buf;
    st.textContent = `${file.name} loaded ✓`; st.style.color = '#128a5a';

    // Compute SHA-256 of the uploaded file and populate the version panel.
    const uploadQShort = (sspaState.workbook.SheetNames || []).reduce((found, n) => found || quarterFromSheetName(n), '');
    const uploadQLabel = uploadQShort ? quarterLong(uploadQShort) : '';
    const uploadHash = await sha256hex(buf);
    showFileVersionPanel('sspa-file-info', 'fv-rows-tab1', [
      fvRow(file.name, uploadQLabel, buf.byteLength, uploadHash, null),
    ]);

    onSSPATemplateLoaded();
  } catch (err) {
    st.textContent = `Error reading file: ${err.message || err}`; st.style.color = '#c0392b';
    sspaState.workbook = null;
  }
}

// ---- Template loaded callback ---------------------------------------------
function onSSPATemplateLoaded() {
  // Validate that the loaded workbook looks like an ASD SSP-A template.
  // A valid template must have a Controls sheet with ISM-XXXX identifiers.
  if (!findSSPAControlsSheet(sspaState.workbook)) {
    const st = $('sspa-template-status');
    st.textContent = 'This file does not appear to be an ASD SSP-A template — no Controls sheet found. Please check that you have uploaded a blank ASD SSP-A (.xlsx) and try again.';
    st.style.color = '#c0392b';
    sspaState.workbook = null;
    // Uncheck whichever source was selected so the user tries again
    document.querySelectorAll('input[name="sspa-source"]').forEach((r: any) => r.checked = false);
    document.querySelectorAll('.sspa-source-option').forEach(el => el.classList.remove('selected'));
    return;
  }
  buildGuidelinesList();
  checkGuidelineNameMismatch();
  // Re-run the NA count in case the user had already selected a classification
  // before the template finished loading.
  updateSSPANACount($('sspa-classification')?.value || '');
  $('sspa-steps').classList.remove('hidden');
}

// ---- Guideline name mismatch warning --------------------------------------
// Compares unique Guideline values in the template Controls sheet against the
// names in SSPA_GUIDELINES. Any template Guideline that doesn't match any
// checklist entry means the NA scoping logic will silently miss those rows.
function checkGuidelineNameMismatch() {
  const warnEl = $('sspa-guideline-name-warning');
  if (!warnEl) return;
  warnEl.style.display = 'none';
  warnEl.innerHTML = '';

  const sheetName = findSSPAControlsSheet(sspaState.workbook);
  if (!sheetName) return;

  const ws  = sspaState.workbook.Sheets[sheetName];
  const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });

  // Find header row and Guideline column index.
  let hdrIdx = 0;
  for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
    if ((aoa[i] || []).some(c => canonicaliseHeader(c) === 'Identifier')) { hdrIdx = i; break; }
  }
  const headers = (aoa[hdrIdx] || []).map(c => canonicaliseHeader(c));
  const glColIdx = headers.indexOf('Guideline');
  if (glColIdx === -1) return; // no Guideline column — nothing to check

  // Collect unique normalised Guideline names from the template.
  const templateGuidelines = new Set();
  for (let r = hdrIdx + 1; r < aoa.length; r++) {
    const v = (aoa[r] || [])[glColIdx];
    if (v != null && String(v).trim()) templateGuidelines.add(normGuidelineName(String(v).trim()));
  }

  // Names the checklist knows about.
  const checklistNames = new Set(SSPA_GUIDELINES.map(g => normGuidelineName(g.name)));

  // Any template Guideline not in the checklist will never be matched.
  const mismatched = [...templateGuidelines].filter(n => !checklistNames.has(n as string));
  if (!mismatched.length) return;

  const listHtml = mismatched.map(n => `<li style="margin:2px 0;">${escHtml(n)}</li>`).join('');
  warnEl.innerHTML = `<strong>Guideline name mismatch detected.</strong> The following Guideline name(s) appear in the template but do not match any entry in the scope checklist. Controls under these Guidelines will not be marked Not Applicable even if the Guideline is unticked — check that the template and checklist are from the same ISM version.<ul style="margin:6px 0 0; padding-left:18px;">${listHtml}</ul>`;
  warnEl.style.display = '';
}

// ---- Classification → NA count --------------------------------------------
$('sspa-classification').addEventListener('change', (e) => {
  updateSSPANACount(e.target.value);
});

function updateSSPANACount(cls) {
  const countEl = $('sspa-na-count');
  if (!sspaState.workbook || !cls) { countEl.classList.add('hidden'); return; }
  const classCol = SSPA_CLASS_COL[cls];
  if (!classCol) { countEl.classList.add('hidden'); return; }

  const controlsSheet = findSSPAControlsSheet(sspaState.workbook);
  if (!controlsSheet) { countEl.classList.add('hidden'); return; }

  const ws  = sspaState.workbook.Sheets[controlsSheet];
  const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });

  // Find header row
  let hdrIdx = 0;
  for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
    if ((aoa[i] || []).some(c => canonicaliseHeader(c) === 'Identifier')) { hdrIdx = i; break; }
  }

  // Some ASD SSP-A templates use a two-row header: the 'Identifier' row is followed
  // by a sub-header row that carries individual classification labels (NC/OS/P/S/TS).
  // Scan the main header row first, then fall back to the next row if needed.
  let classColIdx = -1, identColIdx = -1;
  const scanRow2 = (row) => {
    row.forEach((h, i) => {
      if (classColIdx < 0 && canonicaliseHeader(h) === classCol) classColIdx = i;
      if (identColIdx < 0 && canonicaliseHeader(h) === 'Identifier') identColIdx = i;
    });
  };
  scanRow2(aoa[hdrIdx] || []);
  let dataStart = hdrIdx + 1;
  if (classColIdx < 0 && hdrIdx + 1 < aoa.length) {
    scanRow2(aoa[hdrIdx + 1] || []);
    if (classColIdx >= 0) dataStart = hdrIdx + 2;
  }
  if (classColIdx < 0) { countEl.classList.add('hidden'); return; }

  let naCount = 0, total = 0;
  for (let r = dataStart; r < aoa.length; r++) {
    const row = aoa[r] || [];
    if (!row.some(c => c != null)) continue;
    if (identColIdx >= 0 && !row[identColIdx]) continue;
    total++;
    if (String(row[classColIdx] || '').trim().toLowerCase() === 'no') naCount++;
  }

  const display = SSPA_CLASS_DISPLAY[cls];
  countEl.innerHTML = `<span class="sspa-na-badge"><strong>${naCount}</strong> of ${total} controls will be marked Not Applicable — these controls do not apply to ${escHtml(display)} systems per the ISM.</span>`;
  countEl.classList.remove('hidden');
}

// ---- Build guidelines checklist -------------------------------------------
function buildGuidelinesList() {
  const container = $('sspa-guidelines-list');
  if (!container) return;
  container.innerHTML = '';

  // Initialise state for all 22
  SSPA_GUIDELINES.forEach(g => {
    sspaState.guidelineStates[normGuidelineName(g.name)] = { checked: g.preticked, justification: '' };
  });

  // Section label: Pre-ticked
  const pretickLabel = document.createElement('p');
  pretickLabel.className = 'sspa-gl-group-label';
  pretickLabel.textContent = 'Pre-selected guidelines (apply to most systems)';
  container.appendChild(pretickLabel);

  SSPA_GUIDELINES.filter(g => g.preticked).forEach((g, idx) => renderGuidelineItem(g, 'pt' + idx, container));

  // Section label: User-controlled
  const userLabel = document.createElement('p');
  userLabel.className = 'sspa-gl-group-label';
  userLabel.style.marginTop = '16px';
  userLabel.textContent = 'Select additional in-scope guidelines for this assessment';
  container.appendChild(userLabel);

  SSPA_GUIDELINES.filter(g => !g.preticked).forEach((g, idx) => renderGuidelineItem(g, 'uc' + idx, container));
}

function renderGuidelineItem(g, key, container) {
  const cbId   = 'sspa-gl-cb-' + key;
  const taId   = 'sspa-gl-ta-' + key;
  const item   = document.createElement('div');
  item.className = 'sspa-guideline-item' + (g.preticked ? ' preticked' : '');
  item.dataset.guideline = g.name;

  const pretickTag = g.preticked
    ? `<span class="sspa-gl-pretick-tag">${escHtml(g.pretickReason)}</span>`
    : '';

  item.innerHTML = `
    <div class="sspa-gl-header">
      <label class="sspa-gl-label" for="${cbId}">
        <input type="checkbox" id="${cbId}" ${g.preticked ? 'checked' : ''} />
        <span class="sspa-gl-name">${escHtml(g.name)}</span>
      </label>
      ${pretickTag}
    </div>
    <p class="sspa-gl-description">${escHtml(g.description)}</p>
    <div class="sspa-gl-justification hidden" id="sspa-just-wrap-${key}">
      <label class="sspa-gl-just-label" for="${taId}">
        Justification for excluding this Guideline <span style="font-weight:400;color:var(--text-muted)">(optional — added to each control comment)</span>
      </label>
      <textarea id="${taId}" placeholder="Describe why this system does not implement ${escHtml(g.name)} — e.g. no mobile devices, no on-premises infrastructure…" rows="2"></textarea>
    </div>`;

  const cb: any   = item.querySelector(`#${cbId}`);
  const wrap: any = item.querySelector(`#sspa-just-wrap-${key}`);
  const ta: any   = item.querySelector(`#${taId}`);

  cb.addEventListener('change', () => {
    sspaState.guidelineStates[normGuidelineName(g.name)].checked = cb.checked;
    if (!cb.checked) {
      wrap.classList.remove('hidden');
      item.classList.add('out-of-scope');
    } else {
      wrap.classList.add('hidden');
      item.classList.remove('out-of-scope');
      sspaState.guidelineStates[normGuidelineName(g.name)].justification = '';
      if (ta) ta.value = '';
    }
  });

  ta.addEventListener('input', () => {
    sspaState.guidelineStates[normGuidelineName(g.name)].justification = ta.value.trim();
  });

  container.appendChild(item);
}

// ---- Implementation status fill colours -----------------------------------
// Applied to the Implementation Status and Responsibility columns in both sheets.
const IMPL_STATUS_COLOURS = {
  'Implemented':            'C6EFCE',  // green  — full compliance
  'Partially Implemented':  'FFEB9C',  // amber  — in progress
  'Planned':                'BDD7EE',  // blue   — roadmap item
  'Not Implemented':        'FFC7CE',  // red    — gap
  'Not Applicable':         'E2E2E2',  // grey   — excluded by classification or scope
  'Not Assessed':           'FFFFFF',  // white  — blank template default
};

// Auto-fit column widths by scanning every cell in the sheet.
// min: floor in chars (so short columns like "NC" stay usable).
// max: ceiling so long-text columns don't become unreadably wide.
function autoFitCols(ws, { min = 6, max = 80 } = {}) {
  const range = XLSX.utils.decode_range(ws['!ref'] || 'A1');
  const widths = [];
  for (let C = range.s.c; C <= range.e.c; C++) {
    let w = min;
    for (let R = range.s.r; R <= range.e.r; R++) {
      const cell = ws[XLSX.utils.encode_cell({ r: R, c: C })];
      if (!cell || cell.v == null) continue;
      const longest = String(cell.v).split('\n')
        .reduce((m, l) => Math.max(m, l.length), 0);
      w = Math.max(w, longest);
    }
    widths.push({ wch: Math.min(w + 1, max) }); // +1 gives a small breathing margin
  }
  ws['!cols'] = widths;
}

// ---- Helper: find Principles sheet (content-based) -----------------------
function findSSPAPrinciplesSheet(wb) {
  for (const name of wb.SheetNames) {
    const ws = wb.Sheets[name];
    if (!ws) continue;
    const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });
    for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
      const headers = (aoa[i] || []).map(c => canonicaliseHeader(c));
      if (headers.includes('Identifier') && headers.includes('Function')) return name;
    }
  }
  return null;
}

// ---- Helper: rename a header cell value -----------------------------------
function renameSSPAHeader(ws, hdrIdx, oldName, newName) {
  const headers = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null })[hdrIdx] || [];
  headers.forEach((h, colIdx) => {
    if (String(h || '').trim() === oldName) {
      const addr = colLetter(colIdx) + (hdrIdx + 1);
      if (ws[addr]) ws[addr].v = newName;
    }
  });
}

// ---- Helper: style all data cells in a sheet ----------------------------
// Every column gets: Calibri 11pt, wrapText, vertical-centre, left-align,
// thin light-grey borders. Responsibility and Implementation Status columns
// additionally get fill colours driven by IMPL_STATUS_COLOURS.
// respColIdx may be -1 to skip colour on that column.
function styleSSPAEditableColumns(ws, respColIdx, implColIdx, hdrIdx) {
  if (implColIdx < 0) return;
  const aoa  = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });
  const THIN = { style: 'thin', color: { rgb: 'CFD6E0' } };
  const BORD = { top: THIN, bottom: THIN, left: THIN, right: THIN };
  const wrapBase = {
    font:      { name: 'Calibri', sz: 11 },
    alignment: { wrapText: true, vertical: 'center', horizontal: 'left' },
    border:    BORD,
  };

  // Total columns: derived from the header row so we cover every column
  // in the sheet without hard-coding indices.
  const totalCols = (aoa[hdrIdx] || []).length;

  for (let rowIdx = hdrIdx + 1; rowIdx < aoa.length; rowIdx++) {
    if (!(aoa[rowIdx] || []).some(v => v != null)) continue;
    const r = rowIdx + 1;

    // Pass 1 — apply base style to EVERY column
    for (let c = 0; c < totalCols; c++) {
      const addr = colLetter(c) + r;
      if (!ws[addr]) ws[addr] = { t: 's', v: '' };
      ws[addr].s = { ...wrapBase };
    }

    // Pass 2 — override Responsibility with fill colour (if status matches)
    if (respColIdx >= 0) {
      const addr = colLetter(respColIdx) + r;
      const val  = String(ws[addr].v || '').trim();
      const rgb  = Object.prototype.hasOwnProperty.call(IMPL_STATUS_COLOURS, val)
        ? IMPL_STATUS_COLOURS[val] : null;
      if (rgb) ws[addr].s = { ...wrapBase, fill: { patternType: 'solid', fgColor: { rgb } } };
    }

    // Pass 3 — override Implementation Status with fill colour always
    {
      const addr = colLetter(implColIdx) + r;
      const val  = String(ws[addr].v || '').trim();
      const rgb  = IMPL_STATUS_COLOURS[val] || IMPL_STATUS_COLOURS['Not Assessed'];
      ws[addr].s = { ...wrapBase, fill: { patternType: 'solid', fgColor: { rgb } } };
    }
  }
}

// ---- Generate + download SSP-A -------------------------------------------
$('btn-sspa-generate').addEventListener('click', generateSSPA);

function generateSSPA() {
  const errEl = $('sspa-generate-error');
  errEl.style.display = 'none';

  if (!sspaState.workbook || !sspaState.buffer) {
    errEl.textContent = 'No template loaded. Select a source and wait for it to load.';
    errEl.style.display = 'block'; return;
  }
  const cls = ($('sspa-classification') || {}).value || '';
  if (!cls) {
    errEl.textContent = 'Please select a classification in Step 1.';
    errEl.style.display = 'block'; return;
  }

  const orgName = (($('sspa-org-name') || {}).value || '').trim();
  if (!orgName) {
    errEl.textContent = 'Organisation name is required — it appears in the output filename.';
    errEl.style.display = 'block'; return;
  }
  const classCol     = SSPA_CLASS_COL[cls];
  const classDisplay = SSPA_CLASS_DISPLAY[cls];

  try {
    // The workbook is used ONLY to detect columns and decide which cells to
    // mark; the original file bytes (sspaState.buffer) are edited losslessly.
    const controlsSheetName = findSSPAControlsSheet(sspaState.workbook);
    if (!controlsSheetName) {
      errEl.textContent = 'Could not find a Controls sheet in the template.';
      errEl.style.display = 'block'; return;
    }

    const ws  = sspaState.workbook.Sheets[controlsSheetName];
    const aoa = XLSX.utils.sheet_to_json(ws, { header: 1, defval: null });

    let hdrIdx = 0;
    for (let i = 0; i < Math.min(aoa.length, HEADER_SCAN_ROWS); i++) {
      if ((aoa[i] || []).some(c => canonicaliseHeader(c) === 'Identifier')) { hdrIdx = i; break; }
    }

    let implColIdx = -1, commColIdx = -1, classColIdx = -1, glColIdx = -1, identColIdx = -1, respColIdx = -1;
    // Some ASD SSP-A templates use a two-row header: the 'Identifier' row is followed
    // by a sub-header row that carries individual classification labels (NC/OS/P/S/TS)
    // and per-party column names. Scan the main header row first, then fall back to the
    // next row for any column that wasn't found.
    const scanHeaderRow = (row) => {
      row.forEach((h, i) => {
        const raw   = String(h || '').trim();
        const canon = canonicaliseHeader(h);
        if (classColIdx < 0 && canon === classCol)                                    classColIdx = i;
        if (glColIdx < 0 && (canon === 'Guideline' || canon === 'Section'))          glColIdx    = i;
        if (identColIdx < 0 && canon === 'Identifier')                               identColIdx = i;
        if (respColIdx < 0 && (canon === 'Provider Responsibility' ||
                               canon === 'Assessment Responsibility'))               respColIdx  = i;
        if (implColIdx < 0 && (raw === 'Implementation' ||
                               canon === 'Implementation Status'))                   implColIdx  = i;
        if (commColIdx < 0 && raw === 'Comments')                                    commColIdx  = i;
      });
    };
    scanHeaderRow(aoa[hdrIdx] || []);
    let dataStartIdx = hdrIdx + 1;
    if ((classColIdx < 0 || implColIdx < 0 || commColIdx < 0) && hdrIdx + 1 < aoa.length) {
      scanHeaderRow(aoa[hdrIdx + 1] || []);
      if (classColIdx >= 0) dataStartIdx = hdrIdx + 2;
    }

    if (implColIdx < 0 || commColIdx < 0) {
      errEl.textContent = 'Could not find Implementation or Comments columns in the Controls sheet.';
      errEl.style.display = 'block'; return;
    }
    if (classColIdx < 0) {
      errEl.textContent = `Could not find the ${classCol} applicability column in the Controls sheet. Classification-based Not Applicable decisions cannot be applied.`;
      errEl.style.display = 'block'; return;
    }
    if (glColIdx < 0) {
      errEl.textContent = 'Could not find a Guideline or Section column in the Controls sheet. Scope exclusions from the checklist cannot be applied.';
      errEl.style.display = 'block'; return;
    }

    const implLetter = colLetter(implColIdx);
    const commLetter = colLetter(commColIdx);
    const respLetter = respColIdx >= 0 ? colLetter(respColIdx) : null;

    // Build the set of cell edits — Not Applicable where classification or scope
    // excludes the control. Values only; styles/dropdowns stay as shipped.
    const editMap = new Map<string, string>();
    for (let rowIdx = dataStartIdx; rowIdx < aoa.length; rowIdx++) {
      const row = aoa[rowIdx] || [];
      if (!row.some(c => c != null)) continue;
      if (identColIdx >= 0 && !row[identColIdx]) continue;

      const guidelineName = glColIdx >= 0 ? String(row[glColIdx] || '').trim() : '';
      const isClassNA     = classColIdx >= 0 && String(row[classColIdx] || '').trim().toLowerCase() === 'no';
      const gState        = sspaState.guidelineStates[normGuidelineName(guidelineName)];
      const isGlOOS       = gState && !gState.checked;

      if (!isClassNA && !isGlOOS) continue;

      let commentValue;
      if (isClassNA) {
        commentValue = `This control is not applicable to the system classified as ${classDisplay}.`;
      } else {
        const std    = `This system does not implement ${guidelineName}. This control is not applicable to the assessed system's architecture and operating environment.`;
        const custom = (gState && gState.justification) ? gState.justification : '';
        commentValue = (!custom || custom.includes(std)) ? (custom || std) : std + ' ' + custom;
      }

      const excelRow = rowIdx + 1;
      editMap.set(implLetter + excelRow, 'Not Applicable');
      if (respLetter) editMap.set(respLetter + excelRow, 'Not Applicable');
      editMap.set(commLetter + excelRow, commentValue);
    }

    if (!editMap.size) {
      errEl.textContent = 'No controls are excluded for this classification and scope — nothing to mark Not Applicable. Adjust your selections, or use the original template as-is.';
      errEl.style.display = 'block'; return;
    }

    // ---- Lossless edit: only the target cell values change ---------------
    // The Principles and any other sheets are left exactly as supplied.
    const out = editXlsxCells(sspaState.buffer, controlsSheetName, editMap);
    if (!out) {
      errEl.textContent = 'Could not locate the Controls worksheet inside the file. The .xlsx structure is unexpected.';
      errEl.style.display = 'block'; return;
    }

    const quarter      = quarterFromSheetName(controlsSheetName);
    const quarterLabel = quarter ? quarterLong(quarter) : controlsSheetName;
    const filename     = `SSP-A - ${sanitiseFilename(orgName)} - ${sanitiseFilename(classDisplay)} - ${sanitiseFilename(quarterLabel)}.xlsx`;

    const blob = new Blob([out.slice()], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    downloadBlob(blob, filename);

  } catch (err) {
    errEl.textContent = `Error generating file: ${err.message || String(err)}`;
    errEl.style.display = 'block';
    console.error('[IRAP Pulse] SSP-A generation error:', err);
  }
}


/* ============================================================================
   TAB 4 — CREATE CCM
   Mirrors the Create SSP-A tab, but targets the ASD Cloud Controls Matrix.
   The CCM Controls sheet is structurally richer than an SSP-A: it carries a
   separate Provider side (Provider Responsibility / Implementation Status /
   Comments) AND a Consumer side (Consumer Responsibility / Consumer
   Implementation Required / Consumer Configuration Required / Comments).
   When a control is excluded by classification or scope, BOTH sides are marked
   Not Applicable and the justification is written to both Comments columns.
   The environment columns (Administration Environment, Cloud Production -
   Common Controls, Cloud Production - Service Specific) are descriptive
   free-text and are intentionally left untouched.
   All processing is client-side; no data leaves the browser.
   ============================================================================ */

// Tab 4 runtime state — separate from Tab 1's sspaState and Tab 2's `state`.
const ccmState = {
  workbook:        null,  // XLSX workbook object — used for column detection only
  buffer:          null,  // ArrayBuffer of the original .xlsx — the source of truth for the lossless export
  guidelineStates: Object.create(null),    // normGuidelineName(guidelineName) → { checked: bool, justification: string }
};

