// ---- File version helpers -------------------------------------------------
// Returns the full 64-char hex SHA-256 of an ArrayBuffer, or null if
// crypto.subtle is unavailable (non-secure context such as plain file://).
async function sha256hex(buffer) {
  try {
    const digest = await crypto.subtle.digest('SHA-256', buffer);
    return Array.from(new Uint8Array(digest))
      .map(b => b.toString(16).padStart(2, '0'))
      .join('');
  } catch {
    return null;
  }
}

function fmtBytes(n) {
  if (n >= 1048576) return `${(n / 1048576).toFixed(2)} MB`;
  return `${(n / 1024).toFixed(1)} KB`;
}

// Build a single <tr> for the file version table.
// fullHash: full 64-char hex SHA-256, or null if crypto.subtle was unavailable.
// expectedHash: value from BUNDLED_FILE_HASHES, or null for user-uploaded files.
function fvRow(filename, quarter, bytes, fullHash, expectedHash) {
  let statusCell;
  if (!bytes) {
    statusCell = `<span class="fv-warn">⚠ Unavailable</span>`;
  } else if (fullHash === null) {
    statusCell = `<span class="fv-warn">⚠ crypto.subtle unavailable — cannot verify</span>`;
  } else if (expectedHash === null) {
    // User-uploaded file — no reference hash to compare against.
    statusCell = `<span class="fv-ok">✓ Loaded</span>`;
  } else if (fullHash === expectedHash) {
    statusCell = `<span class="fv-ok">✓ Verified</span>`;
  } else {
    statusCell = `<span class="fv-warn">⚠ Hash mismatch — file may have been updated</span>`;
  }

  const hashCell = fullHash
    ? `<code class="fv-hash">${fullHash.slice(0, 16)}&hellip;</code>`
    : `<span style="color:var(--text-muted)">—</span>`;

  return `<tr>
    <td><code>${escapeHtml(filename)}</code></td>
    <td>${escapeHtml(quarter || '—')}</td>
    <td>${bytes !== null ? fmtBytes(bytes) : '—'}</td>
    <td>${hashCell}</td>
    <td>${statusCell}</td>
  </tr>`;
}

// Populate a file-version panel and make it visible.
