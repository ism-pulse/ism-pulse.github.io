  pdfEl.className = 'bundled-item' + (pdfOk === true ? ' ok' : pdfOk === false ? ' err' : '');
  if (ccmLbl) ccmLbl.textContent = ccmMsg;
  if (pdfLbl) pdfLbl.textContent = pdfMsg;
}

async function fetchBundledFiles() {
  updateBundledStatus(null, null, 'CCM: loading…', 'Changes PDF: loading…');

  const [ccmResult, pdfResult] = await Promise.allSettled([
    fetchArrayBufferCapped(CCM_URL),
    fetchArrayBufferCapped(PDF_URL),
  ]);

  // CCM is mandatory — without it we cannot compute the delta.
  if (ccmResult.status === 'rejected') {
    state.bundled.status = 'error';
    updateBundledStatus(false, null, `CCM: failed — ${ccmResult.reason?.message || ccmResult.reason}`, 'Changes PDF: skipped');
    console.warn('[IRAP Pulse] CCM fetch failed:', ccmResult.reason);
    checkReady();
    return;
  }

  // PDF is optional — only needed for rescission reasons.
  const ccmBuf = ccmResult.value;
  const pdfBuf = pdfResult.status === 'fulfilled' ? pdfResult.value : null;

  // Verify CCM integrity before parsing — do not hand untrusted bytes to the parser.
  // Fail closed: if crypto.subtle is unavailable the hash cannot be computed and
  // we block the load rather than silently skipping the check (fail-open).
  const ccmHash = await sha256hex(ccmBuf);
  if (ccmHash === null) {
    updateBundledStatus(false, false,
      'Cannot verify CCM integrity — crypto.subtle unavailable. Serve the tool over HTTPS or localhost (not plain file://).',
      '');
    state.bundled.status = 'error';
    return;
  }
  if (BUNDLED_FILE_HASHES['ccm-current.xlsx'] && ccmHash !== BUNDLED_FILE_HASHES['ccm-current.xlsx']) {
    showFileVersionPanel('bundled-file-info', 'fv-rows-tab2', [
      fvRow('ccm-current.xlsx', '', ccmBuf.byteLength, ccmHash, BUNDLED_FILE_HASHES['ccm-current.xlsx']),
    ]);
    updateBundledStatus(false, false,
      'CCM integrity check failed — hash mismatch. The bundled file may have been updated. Do not proceed.',
      '');
    state.bundled.status = 'error';
    return;
  }

  // Detect quarter label from the CCM sheet name.
  let ccmWb, sheets;
  try {
    ccmWb  = parseXLSXFromBuffer(ccmBuf);
    sheets = findReviewSheets(ccmWb);
  } catch (parseErr) {
    state.bundled.status = 'error';
    updateBundledStatus(false, null, `CCM: file loaded but could not be parsed — ${parseErr.message || parseErr}`, 'Changes PDF: skipped');
    console.warn('[IRAP Pulse] CCM parse failed:', parseErr);
    checkReady();
    return;
  }
  if (!sheets.control && !sheets.principle) {
    state.bundled.status = 'error';
    updateBundledStatus(false, null, 'CCM: loaded but no Controls or Principles sheet found — please check the bundled CCM file.', 'Changes PDF: skipped');
    checkReady();
    return;
  }
  const sheetName = sheets.control || sheets.principle || '';
  const qShort = quarterFromSheetName(sheetName);
  const qLabel = qShort ? quarterLong(qShort) : 'current quarter';

  state.bundled.ccmBuffer     = ccmBuf;
  state.bundled.changesBuffer = pdfBuf;
  state.bundled.quarterLabel  = qLabel;
  state.bundled.status        = 'ready';

  const pdfStatusText = pdfBuf
    ? `Changes PDF: ${qLabel} ✓`
    : `Changes PDF: unavailable — rescission reasons will not be shown`;
  updateBundledStatus(true, !!pdfBuf, `CCM: ${qLabel} ✓`, pdfStatusText);

  if (!pdfBuf) console.warn('[IRAP Pulse] Changes PDF fetch failed:', (pdfResult as any).reason);

  // PDF hash check.  Unlike the CCM, a PDF mismatch does not block the tool —
  // the PDF is enrichment-only.  But a stale PDF could inject misleading
  // rescission reasons, so we null out changesBuffer on mismatch so the core
  // delta still runs while rescission-reason extraction is safely disabled.
  const pdfHash = pdfBuf ? await sha256hex(pdfBuf) : null;
  if (pdfHash !== null && BUNDLED_FILE_HASHES['ism-changes-current.pdf'] &&
      pdfHash !== BUNDLED_FILE_HASHES['ism-changes-current.pdf']) {
    state.bundled.changesBuffer = null;
    console.warn('[IRAP Pulse] PDF integrity mismatch — rescission reasons disabled.');
    updateBundledStatus(true, false,
      `CCM: ${qLabel} ✓`,
      'PDF integrity mismatch — rescission reasons disabled');
  }

  const rows = [
    fvRow('ccm-current.xlsx', qLabel, ccmBuf.byteLength, ccmHash, BUNDLED_FILE_HASHES['ccm-current.xlsx']),
  ];
  if (pdfBuf) {
    rows.push(fvRow('ism-changes-current.pdf', qLabel, pdfBuf.byteLength, pdfHash, BUNDLED_FILE_HASHES['ism-changes-current.pdf']));
  } else {
    rows.push(fvRow('ism-changes-current.pdf', qLabel, null, null, BUNDLED_FILE_HASHES['ism-changes-current.pdf']));
  }
  showFileVersionPanel('bundled-file-info', 'fv-rows-tab2', rows);

  checkReady();
}

function checkReady() {
  // The Compute button is always enabled — we never hard-block the user. Any
  // missing field surfaces as a warning at click time with a "Proceed anyway"
  // override, so the reviewer is fully in control.
  const btn = $('btn-compute');
  if (!btn) return;
  btn.disabled = false;
  const fullyReady =
    state.bundled.status === 'ready' &&
    state.files.sspa &&
    ($('org-name')?.value || '').trim() &&
    ($('product-name')?.value || '').trim() &&
    ($('product-classification')?.value || '').trim() &&
    ($('product-overview')?.value || '').trim();
  btn.classList.toggle('not-ready', !fullyReady);
  btn.title = fullyReady
    ? 'Compute the delta between the uploaded files.'
    : 'Some required inputs are missing — clicking will show what needs to be fixed.';
}

// ---- Input validation -----------------------------------------------------
// Three simple guards. The goal is to catch user mix-ups before we waste time
// parsing, and to make sure the tool refuses files it can't sensibly process.
// None of these are security-critical (the tool runs client-side), they just
// keep the error surface predictable.
const MAX_XLSX_MB    = 5;
const MAX_XLSX_BYTES = MAX_XLSX_MB * 1024 * 1024;   // 5 MB upload cap (see UI note near the upload controls)
const MAX_FETCH_BYTES = 25 * 1024 * 1024;           // cap on bundled/archive downloads before buffering

// Read an uploaded workbook only after a decompression-bomb / size preflight,
// so a hostile .xlsx can never reach the xlsx parser and exhaust memory.
function readWorkbookSafe(buf: ArrayBuffer, opts?: any) {
  const pf = preflightXlsx(buf);
  if (!pf.ok) throw new Error(pf.reason || 'The workbook failed the safety preflight.');
  return XLSX.read(new Uint8Array(buf), opts || { type: 'array' });
}

// Fetch an ArrayBuffer with a hard size ceiling: reject early on Content-Length,
// then stream with a running budget so a bad/oversized response cannot buffer
// unbounded memory before the integrity hash is even computed.
async function fetchArrayBufferCapped(url: string, maxBytes: number = MAX_FETCH_BYTES): Promise<ArrayBuffer> {
  const resp = await fetch(url);
  if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
  const declared = Number(resp.headers.get('content-length') || '0');
  if (declared && declared > maxBytes) throw new Error(`File is too large (${Math.round(declared / 1048576)} MB, limit ${Math.round(maxBytes / 1048576)} MB).`);
  if (!resp.body || typeof resp.body.getReader !== 'function') {
    const buf = await resp.arrayBuffer();
    if (buf.byteLength > maxBytes) throw new Error(`File is too large (${Math.round(buf.byteLength / 1048576)} MB).`);
    return buf;
  }
  const reader = resp.body.getReader();
  const chunks: Uint8Array[] = [];
  let total = 0;
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    total += value.length;
    if (total > maxBytes) { try { await reader.cancel(); } catch {} throw new Error(`File exceeds the ${Math.round(maxBytes / 1048576)} MB limit.`); }
    chunks.push(value);
  }
  const out = new Uint8Array(total);
  let off = 0;
  for (const c of chunks) { out.set(c, off); off += c.length; }
  return out.buffer;
}

// Hard checks (size, extension, magic bytes, parseability, mandatory columns)
// throw errors — these genuinely cannot be analysed.
//
// Soft checks (column-fingerprint CCM↔SSP-A swap detection) are returned as
// WARNINGS instead of errors. Some organisations ship SSP-As and CCMs with
// identical column sets, so a column-fingerprint is a heuristic, not a truth.
// The compute handler surfaces the warning to the user with a "Proceed anyway"
// button. No validator function is the final word on a file's identity.
//
// Called only for the user-uploaded baseline (SSP-A or CCM). The bundled
// CCM and PDF are served from the same host and are not user-validated here.
async function validateXlsxFile(file, kind) {
  const label = (f) => `"${f.name}" (uploaded as the SSP-A or CCM baseline)`;
  const warnings = [];

  // A missing mandatory file is a hard stop. The compute handler validates
  // mandatory-file presence itself (so errors can be grouped with the
  // product-detail errors into one clean "please fix these" panel), and
  // this function is only called with a present file. Defensive early
  // return just in case.
  if (!file) return warnings;
  if (file.size > MAX_XLSX_BYTES) {
    throw new Error(`${label(file)} is too large (${(file.size / 1048576).toFixed(1)} MB). Maximum accepted size is ${MAX_XLSX_MB} MB.`);
  }
  if (!/\.xlsx$/i.test(file.name)) {
    throw new Error(`${label(file)} is not a plain Excel workbook (.xlsx). Convert the file to .xlsx before uploading.`);
  }

  // xlsx files are ZIP containers, starting with "PK\x03\x04".
  const head = new Uint8Array(await file.slice(0, 4).arrayBuffer());
  const isZip = head[0] === 0x50 && head[1] === 0x4B && (head[2] === 0x03 || head[2] === 0x05 || head[2] === 0x07);
  if (!isZip) {
    throw new Error(`${label(file)} does not look like a real Excel workbook — its file signature is wrong.`);
  }

  // Light content sanity: peek at the workbook.
  let wb;
  try { wb = await parseXLSX(file); }
  catch (e) { throw new Error(`${label(file)} could not be read: ${e.message}`); }
  const sheets = findReviewSheets(wb);
  if (!sheets.control && !sheets.principle) {
    throw new Error(`${label(file)} has no recognisable Controls or Principles sheet. Expected either a sheet starting with "Controls" / "Principles", or any sheet containing an "Identifier" column with a "Guideline" (controls) or "Function" (principles) column.`);
  }

  const probeSheet = wb.Sheets[sheets.control || sheets.principle];
  const probeRows = normaliseRows(probeSheet);
  if (!probeRows.length) throw new Error(`${label(file)} has a review sheet with no data rows.`);
  const cols = new Set(Object.keys(probeRows[0] || {}).map(k => k.toLowerCase()));

  const hasIdentifier  = cols.has('identifier');
  const hasDescription = [...cols].some(c => c.startsWith('description'));
  const hasProvider    = cols.has('provider responsibility');
  const hasImpl        = cols.has('implementation status');

  if (!hasIdentifier)  throw new Error(`${label(file)} has no recognisable "Identifier" column. Expected a column named "Identifier", "Control ID", "ISM ID" or similar.`);
  if (!hasDescription) throw new Error(`${label(file)} has no recognisable description column. Expected a column named "Description", "Control", "Security Control", "Requirement" or similar. Check the column headers in your file.`);

  // Soft swap-detection — heuristic, overridable via "Proceed anyway".
  // The baseline slot accepts both SSP-A and raw CCM; the warning fires only
  // when neither SSP-A column is present, nudging the reviewer to double-check.
  if (!hasProvider && !hasImpl) {
    warnings.push(`${label(file)} has no "Provider Responsibility" / "Implementation Status" columns — those are typically found in an SSP-A. This may be fine if you're uploading a raw CCM as your baseline.`);
  }
  return warnings;
}

// Product-detail validation. All three metadata fields are mandatory — a
// blank field materially degrades the output (classification disables a
// pre-fill rule, overview leaves the Summary sheet empty, name leaves
// exports unattributable) and the tool will not proceed until they're
// filled in. Hard errors (returned here) cannot be overridden via "Proceed
// anyway"; they must be fixed. Soft warnings (heuristic file-shape checks,
// PDF signal score) live elsewhere and remain overridable.
function validateProductDetails() {
  const errors = [];
  const org            = ($('org-name') && $('org-name').value || '').trim();
  const name           = ($('product-name') && $('product-name').value || '').trim();
  const classification = ($('product-classification') && $('product-classification').value || '').trim();
  const overview       = ($('product-overview') && $('product-overview').value || '').trim();
  if (!org)            errors.push({ field: 'org-name',              msg: 'Organisation name is required.' });
  if (!name)           errors.push({ field: 'product-name',          msg: 'Product name is required.' });
  if (!classification) errors.push({ field: 'product-classification', msg: 'Information Classification is required.' });
  if (!overview)       errors.push({ field: 'product-overview',       msg: 'Product overview is required.' });
  return errors;
}

function bindFileInput(inputId, statusId, key) {
  $(inputId).addEventListener('change', (e) => {
    const f = e.target.files[0];
    // Clear any stale validation error / warning the moment the user touches
    // any file input — if their fix lands those disappear immediately; if it
    // doesn't, a fresh click on Compute surfaces the fresh diagnosis. Also
    // reset the "Proceed anyway" override so a new pair of uploads is
    // validated from scratch.
    const errEl  = $('compute-error');
    const warnEl = $('compute-warning');
    if (errEl)  errEl.style.display  = 'none';
    if (warnEl) warnEl.style.display = 'none';
    state.overrideFileTypeCheck = false;
    if (!f) { state.files[key] = null; updateStatus(statusId, 'Not loaded'); checkReady(); return; }
    state.files[key] = f;
    if (key === 'sspa') state.hasComputed = false; // force re-compute when baseline changes
    updateStatus(statusId, f.name, 'ok');
    checkReady();
  });
}
bindFileInput('file-sspa', 'status-sspa', 'sspa');

// Drag-and-drop for the SSP-A/CCM slot
(function() {
  const zone = $('drop-zone-sspa');
  const input = $('file-sspa');
  if (!zone || !input) return;
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
  zone.addEventListener('drop', e => {
    e.preventDefault();
    zone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (!file) return;
    // Programmatically assign to the file input so bindFileInput's handler fires
    const dt = new DataTransfer();
    dt.items.add(file);
    input.files = dt.files;
    input.dispatchEvent(new Event('change', { bubbles: true }));
  });
})();

