// Configure pdf.js worker.
// The worker is loaded as a Web Worker URL (not a <script> tag), so browser-native
// SRI enforcement does not apply. Instead we fetch the script, verify its SHA-384
// hash against the pinned value, and only hand a blob URL to pdf.js if it matches.
// If fetch or verification fails, PDF parsing is disabled — we fail closed rather
// than fall back to an unverified URL.
if (window.pdfjsLib) {
  const PDFJS_WORKER_URL  = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  const PDFJS_WORKER_HASH = 'sha384-SnzOobpRMLXZ52iJvZm/C0fYw0OQemTXzTjIsdsfMcrCtCEe9qgzxTd3RSklO5x2';

  (async () => {
    try {
      const resp = await fetch(PDFJS_WORKER_URL, { cache: 'force-cache' });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const buf = await resp.arrayBuffer();
      const hashBytes = await crypto.subtle.digest('SHA-384', buf);
      const b64 = btoa(Array.from(new Uint8Array(hashBytes), b => String.fromCharCode(b)).join(''));
      const actual = `sha384-${b64}`;
      if (actual !== PDFJS_WORKER_HASH) {
        console.error(`[ISM tool] pdf.js worker integrity check FAILED.\n  expected: ${PDFJS_WORKER_HASH}\n  actual:   ${actual}\nPDF parsing disabled.`);
        return; // leave workerSrc unset — pdf.js will error if a PDF is opened
      }
      const blob = new Blob([buf], { type: 'application/javascript' });
      pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(blob);
    } catch (e) {
      console.error('[ISM tool] pdf.js worker fetch/verify failed. PDF parsing disabled:', e);
      return;
    }
  })();
}

