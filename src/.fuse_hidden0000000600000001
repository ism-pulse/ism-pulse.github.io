/* ---- Stakeholder-communication draft -----------------------------------
   Produces a short plain-English note aimed at non-security stakeholders.
   Pulls from state.delta + state.triage so owner/triage decisions the
   reviewer has already made are reflected in the draft. */
function buildStakeholderNote() {
  const p: any  = state.product || {};
  const pq: any = state.parsed  || {};
  const c  = counts();
  const delta = state.delta || [];
  const triage = state.triage || {};
  const target   = quarterLong(pq.targetQuarter)   || 'this quarter';
  const baseline = quarterLong(pq.baselineQuarter) || 'the previous baseline';
  const productLbl = p.name ? `${p.name}` : 'our product';

  // Headline counts — total changes, and how many the reviewer has marked
  // in-scope (i.e. genuinely requiring attention).
  const inScopeYes = delta.filter(d => (triage[d.id] || {}).inScope === 'Yes');
  const inScopeNo  = delta.filter(d => (triage[d.id] || {}).inScope === 'No');
  const notTriaged = delta.length - inScopeYes.length - inScopeNo.length;

  const topGuidelinesByVolume = (() => {
    const m = Object.create(null);
    inScopeYes.forEach(d => { m[d.guideline || '(uncategorised)'] = (m[d.guideline || '(uncategorised)'] || 0) + 1; });
    return Object.entries(m).sort((a,b) => (b[1] as number) - (a[1] as number)).slice(0, 5).map(([g,n]) => `${g} (${n})`);
  })();

  const lines = [];
  const orgLbl = p.organisation ? ` (${p.organisation})` : '';
  lines.push(`Subject: ${productLbl}${orgLbl} — ISM ${target} review summary`);
  lines.push('');
  lines.push(`Hi team,`);
  lines.push('');
  lines.push(`I've completed the ISM ${target} review for ${productLbl}` + (p.classification ? ` (${p.classification})` : '') + ` against our ${baseline} baseline.`);
  lines.push('');
  lines.push(`Headline numbers:`);
  lines.push(`  • Controls: ${c.byKind.control.byChange.New} new, ${c.byKind.control.byChange.Updated} updated, ${c.byKind.control.byChange.Rescinded} rescinded (${c.byKind.control.total} total)`);
  lines.push(`  • Principles: ${c.byKind.principle.byChange.New} new, ${c.byKind.principle.byChange.Updated} updated, ${c.byKind.principle.byChange.Rescinded} rescinded (${c.byKind.principle.total} total)`);
  lines.push('');
  if (inScopeYes.length) {
    lines.push(`Of the ${delta.length} changes, ${inScopeYes.length} are in scope for ${productLbl}${inScopeNo.length ? ` and ${inScopeNo.length} are out of scope` : ''}${notTriaged ? `, with ${notTriaged} still under review` : ''}.`);
  } else if (inScopeNo.length && !notTriaged) {
    lines.push(`All ${delta.length} changes were assessed and none are in scope for ${productLbl} this quarter.`);
  } else {
    lines.push(`Triage is still in progress — ${notTriaged} of ${delta.length} changes are yet to be assessed.`);
  }
  if (topGuidelinesByVolume.length) {
    lines.push('');
    lines.push(`Concentration of in-scope work (top guidelines): ${topGuidelinesByVolume.join('; ')}.`);
  }
  if (state.drift && state.drift.count) {
    lines.push('');
    lines.push(`Note: ${state.drift.count} control(s) have changed applicability (classification scope) in this CCM compared to our baseline — the control text itself is unchanged, but the baseline file rows may need updating on the next pass.`);
  }
  lines.push('');
  lines.push(`The full change register and updated baseline file are attached. Happy to walk through any of the items on request.`);
  lines.push('');
  lines.push(`Thanks,`);
  lines.push(`[Your name]`);
  return lines.join('\n');
}

