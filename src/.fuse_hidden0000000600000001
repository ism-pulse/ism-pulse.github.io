}

// ---- Chart helpers ---------------------------------------------------------
// Replace a canvas element with a fresh one to avoid corrupted context after
// chart.destroy(). Returns the new canvas element.
function freshCanvas(id) {
  const old = $(id);
  if (!old) return null;
  const canvas = document.createElement('canvas');
  canvas.id = id;
  old.parentNode.replaceChild(canvas, old);
  return canvas;
}

function chartNotAvailable(id) {
  const el = $(id);
  if (el) el.parentNode.innerHTML =
    '<p style="color:var(--text-muted);font-size:12px;padding:8px 0;">Chart.js did not load — check your network connection and reload.</p>';
}

// ---- Chart renders ---------------------------------------------------------
function renderCmpBarChart() {
  if (!window.Chart) { chartNotAvailable('cmp-bar-chart'); return; }

  const ctrlDelta = state3.delta.filter(d => d.kind === 'control');

  const byGl: any = Object.create(null);
  ctrlDelta.forEach(d => {
    const gl = d.guideline || '(no guideline)';
    if (!byGl[gl]) byGl[gl] = { New: 0, Updated: 0, Rescinded: 0 };
    byGl[gl][d.changeType]++;
  });

  const sorted = (Object.entries(byGl) as [string, any][]).sort((a, b) => {
    const ta = a[1].New + a[1].Updated + a[1].Rescinded;
    const tb = b[1].New + b[1].Updated + b[1].Rescinded;
    return tb - ta;
  });

  const labels      = sorted.map(([gl]) => gl.length > 34 ? gl.slice(0, 32) + '…' : gl);
  const newData     = sorted.map(([, v]) => v.New);
  const updatedData = sorted.map(([, v]) => v.Updated);
  const rescindData = sorted.map(([, v]) => v.Rescinded);

  if (state3.barChart) { state3.barChart.destroy(); state3.barChart = null; }

  const canvas = freshCanvas('cmp-bar-chart');
  if (!canvas) return;

  const datalabelsPlugin = window.ChartDataLabels || null;
  state3.barChart = new Chart(canvas, {
    type: 'bar',
    plugins: datalabelsPlugin ? [datalabelsPlugin] : [],
    data: {
      labels,
      datasets: [
        { label: 'New',       data: newData,     backgroundColor: '#6fa8dc' },
        { label: 'Updated',   data: updatedData,  backgroundColor: '#f6b26b' },
        { label: 'Rescinded', data: rescindData,  backgroundColor: '#c27ba0' },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      clip: false,
      plugins: {
        legend: { position: 'top' },
        datalabels: {
          color: '#fff',
          font: { size: 11, weight: 600 },
          anchor: 'center',
          align: 'center',
          formatter: (value) => value > 0 ? value : null,
        },
      },
      scales: {
        x: { stacked: true, ticks: { font: { size: 11 }, maxRotation: 45 } },
        y: { stacked: true, beginAtZero: true, ticks: { stepSize: 1, precision: 0 } },
      },
    },
  });
}

function renderCmpDonutChart() {
  if (!window.Chart) { chartNotAvailable('cmp-donut-chart'); return; }

  const counts = { New: 0, Updated: 0, Rescinded: 0 };
